# Copy to .env and choose a local-only password. .env is ignored by Git.
POSTGRES_DB=listingstudio
POSTGRES_USER=listingstudio
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# ASP.NET Core configuration uses double underscores for nested keys.
PostgreSQL__ConnectionString="Host=localhost;Port=5432;Database=listingstudio;Username=listingstudio;Password=replace-with-the-same-local-password"
AzureBlobStorage__ConnectionString=
AzureBlobStorage__ContainerName=
OpenAI__ApiKey=
OpenAI__Model=
OpenAI__ResponsesEndpoint=https://api.openai.com/v1/responses
MediaAnalysis__Enabled=false
MediaAnalysis__PollIntervalSeconds=10
AIVideo__Provider=
AIVideo__ApiKey=
AIVideo__Endpoint=
Voice__Provider=
Voice__ApiKey=
Voice__VoiceId=
Stripe__SecretKey=
Stripe__WebhookSecret=
