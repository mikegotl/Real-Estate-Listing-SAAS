# Copy to .env and choose a local-only password. .env is ignored by Git.
POSTGRES_DB=listingstudio
POSTGRES_USER=listingstudio
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# ASP.NET Core configuration uses double underscores for nested keys.
PostgreSQL__ConnectionString="Host=localhost;Port=5432;Database=listingstudio;Username=listingstudio;Password=replace-with-the-same-local-password"
# Production may set PostgreSQL__Host, __Port, __Database, __Username and __Password separately.
Authentication__Google__Enabled=false
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Apple__Enabled=false
Authentication__Apple__ClientId=
Authentication__Apple__TeamId=
Authentication__Apple__KeyId=
# Prefer user secrets locally or a secret store in production for the .p8 private key.
Authentication__Apple__PrivateKey=
AzureBlobStorage__ConnectionString=
AzureBlobStorage__ServiceUri=
AzureBlobStorage__ContainerName=
AzureBlobStorage__CampaignLocalRootPath=App_Data/campaign-assets
AddressLookup__Enabled=true
AddressLookup__BaseUrl=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/
AddressLookup__CountryCode=USA
# Optional paid Google Places integration. Keep disabled until billing and an API-restricted key are approved.
NeighborhoodInsights__Enabled=false
NeighborhoodInsights__ApiKey=
NeighborhoodInsights__RadiusMeters=8000
NeighborhoodInsights__MaximumResults=12
OpenAI__ApiKey=
OpenAI__Model=
OpenAI__ResponsesEndpoint=https://api.openai.com/v1/responses
MediaAnalysis__Enabled=false
MediaAnalysis__PollIntervalSeconds=10
VideoProcessing__Enabled=true
VideoProcessing__PollIntervalSeconds=3
AIVideo__Enabled=false
AIVideo__Provider=
AIVideo__ApiKey=
AIVideo__Endpoint=
AIVideo__Model=
AIVideo__GenerationVersion=ai-video-v1
AIVideo__RequestTimeoutSeconds=600
AIVideo__MaxOutputMegabytes=100
Voice__Provider=
Voice__ApiKey=
Voice__VoiceId=
Voice__Endpoint=https://api.elevenlabs.io/v1/text-to-speech
Voice__ModelId=eleven_multilingual_v2
Voice__OutputFormat=mp3_44100_128
FFmpeg__ExecutablePath=ffmpeg
FFmpeg__ProbeExecutablePath=ffprobe
FFmpeg__RenderTimeoutSeconds=300
FFmpeg__EnhancementTimeoutSeconds=1800
VideoBranding__FontFilePath=
VideoBranding__VideoFadeInMs=500
VideoBranding__VideoFadeOutMs=750
Stripe__Enabled=false
Stripe__ApiBaseUrl=https://api.stripe.com
Stripe__PublicBaseUrl=https://localhost:5001
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__StarterPriceId=
Stripe__ProfessionalPriceId=
Stripe__StarterMonthlyCampaignAllowance=4
Stripe__ProfessionalMonthlyCampaignAllowance=12
Stripe__WebhookToleranceSeconds=300
APPLICATIONINSIGHTS_CONNECTION_STRING=
