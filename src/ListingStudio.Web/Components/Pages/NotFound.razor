@page "/not-found"
<PageTitle>Page not found</PageTitle>

<div class="state-page">
    <span class="state-icon warning"><MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" /></span>
    <MudText Typo="Typo.h3" HtmlTag="h1">Page not found</MudText>
    <MudText Typo="Typo.body1">The page you're looking for doesn't exist or may have moved.</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Return home</MudButton>
</div>
