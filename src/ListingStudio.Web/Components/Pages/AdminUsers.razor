@page "/admin/users"
@attribute [Authorize(Policy = PlatformAdministration.Policy)]
@attribute [StreamRendering]
@using ListingStudio.Application.Help
@inject IPlatformAdminAccountDirectory AccountDirectory

<PageTitle>Find users</PageTitle>

<div class="section-row admin-page-heading">
    <div>
        <span class="eyebrow">CUSTOMER SUPPORT</span>
        <MudText Typo="Typo.h3" HtmlTag="h1">Find users</MudText>
        <MudText Typo="Typo.body1">Search by email, user name or workspace name, then open a workspace or property as that user, add them to Testers or email them.</MudText>
    </div>
    <div class="admin-heading-actions">
        <MudButton Href="/admin/users?testers=true" Variant="@(TestersView ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Science">Testers</MudButton>
        <MudButton Href="/admin/email" Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Outbox">Sent emails</MudButton>
        <MudButton Href="/admin" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">Overview</MudButton>
    </div>
</div>

<MudPaper Elevation="0" Class="admin-panel mb-5">
    <MudText Typo="Typo.h5" HtmlTag="h2">Invite a tester</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Enter an email address. Existing users keep their sign-in; new users receive a private workspace, a temporary
        password and a welcome email, and must choose a new password before using the site.
    </MudText>
    <form action="/admin/users/testers/invite" method="post" class="admin-user-search">
        <AntiforgeryToken />
        <label for="tester-invite-email" class="visually-hidden">Tester email address</label>
        <input id="tester-invite-email" name="email" type="email" autocomplete="email" required maxlength="256"
               placeholder="tester@example.com" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.PersonAdd">Invite tester</MudButton>
    </form>
</MudPaper>

<form method="get" action="/admin/users" class="admin-user-search" role="search">
    <label for="admin-user-query" class="visually-hidden">Email, user name or workspace</label>
    <input id="admin-user-query" name="q" type="search" value="@Q" autocomplete="off" autofocus
           placeholder="Email, user name or workspace" minlength="@IPlatformAdminAccountDirectory.MinimumQueryLength" maxlength="256" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Search">Search</MudButton>
</form>

@if (ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">@ErrorMessage</MudAlert>
}

@if (NoticeMessage is { } notice)
{
    <MudAlert Severity="@notice.Severity" Variant="Variant.Outlined" Class="mb-4">@notice.Text</MudAlert>
}

@if (TestersView)
{
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-1">Testers</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Testers use the site for free with every feature, including the AI drone fly-in and AI agent presenter. Their
        campaigns skip plan, trial and allowance checks and are not counted against their workspace. Each tester can
        start @PlatformTesters.DefaultMonthlyCampaignLimit new property campaigns a month (UTC) unless you raise it below,
        and every platform admin gets a notification and an email when a tester starts their last one. Safety caps still apply to everyone, such as @CampaignVideoRevision.FreeRendersPerVideo
        chat updates per video and @IHelpChatService.MaximumMessagesPerDay Ask AI questions a day.
    </MudText>
}

@if (TestersView && result is not null && result.Accounts.Count == 0)
{
    <p class="admin-empty">No testers yet. Search for a user above and choose Add to Testers.</p>
}
else if (!TestersView && (string.IsNullOrWhiteSpace(Q) || Q.Trim().Length < IPlatformAdminAccountDirectory.MinimumQueryLength))
{
    <p class="admin-empty">Type at least @IPlatformAdminAccountDirectory.MinimumQueryLength characters to search.</p>
}
else if (result is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (result.Accounts.Count == 0)
{
    <p class="admin-empty">No users match "@result.Query".</p>
}
else
{
    <div class="admin-results-bar">
        <p class="property-count">
            @result.Accounts.Count @(result.Accounts.Count == 1 ? (TestersView ? "tester" : "user") : (TestersView ? "testers" : "users"))@(result.HasMore ? " shown. Refine the search to see more." : string.Empty)
        </p>
        @* Checkboxes on each card belong to this form through their form attribute, so no script is needed. *@
        <form id="admin-email-selected" method="get" action="/admin/email" class="admin-email-actions">
            <input type="hidden" name="q" value="@ReturnQuery" />
            <MudButton ButtonType="ButtonType.Submit" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Email">Email selected</MudButton>
        </form>
        <form method="get" action="/admin/email" class="admin-email-actions">
            <input type="hidden" name="q" value="@ReturnQuery" />
            @foreach (var account in result.Accounts)
            {
                <input type="hidden" name="to" value="@account.UserId" />
            }
            <MudButton ButtonType="ButtonType.Submit" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                Email all @result.Accounts.Count shown
            </MudButton>
        </form>
    </div>
    <div class="admin-user-list">
        @foreach (var account in result.Accounts)
        {
            <MudPaper Elevation="0" Class="admin-panel admin-user-card">
                <header class="admin-user-head">
                    <div class="admin-user-title">
                        <input type="checkbox" form="admin-email-selected" name="to" value="@account.UserId"
                               id="@($"select-{account.UserId}")" class="admin-user-select" />
                        <label for="@($"select-{account.UserId}")" class="visually-hidden">Select @account.Email for email</label>
                        <div>
                        <MudText Typo="Typo.h5" HtmlTag="h2">@account.Email</MudText>
                        <p class="admin-user-meta">
                            @if (!string.Equals(account.UserName, account.Email, StringComparison.OrdinalIgnoreCase))
                            {
                                <span>User name @account.UserName</span>
                            }
                            <span>@(account.LastSuccessfulSignInAtUtc is { } signedIn ? $"Last sign-in {signedIn.ToLocalTime():MMM d, yyyy h:mm tt}" : "No recorded sign-in")</span>
                            @if (account.IsPlatformAdmin)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">Platform admin</MudChip>
                            }
                            @if (account.IsTester)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.Science">Tester · @account.TesterCampaignsThisMonth of @account.TesterMonthlyCampaignLimit campaigns this month</MudChip>
                            }
                        </p>
                        </div>
                    </div>
                    <div class="admin-user-actions">
                        <MudButton Href="@EmailLink(account.UserId)" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Email">Email</MudButton>
                        <TesterForm UserId="@account.UserId" IsTester="@account.IsTester" Query="@result.Query" TestersView="@TestersView" />
                        @if (account.IsTester)
                        {
                            <form action="/admin/users/testers/limit" method="post" class="admin-impersonate-form tester-limit-form">
                                <AntiforgeryToken />
                                <input type="hidden" name="userId" value="@account.UserId" />
                                <input type="hidden" name="q" value="@result.Query" />
                                <input type="hidden" name="testers" value="@(TestersView ? "true" : "false")" />
                                <label for="@($"limit-{account.UserId}")">Campaigns / month</label>
                                <input id="@($"limit-{account.UserId}")" name="limit" type="number" min="0"
                                       max="@PlatformTesters.MaximumMonthlyCampaignLimit" value="@account.TesterMonthlyCampaignLimit" required />
                                <MudButton ButtonType="ButtonType.Submit" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">Save limit</MudButton>
                            </form>
                        }
                        @if (!account.IsPlatformAdmin)
                        {
                            <ImpersonateForm UserId="@account.UserId" Query="@result.Query" ReturnUrl="/auth"
                                             Label="Open workspace as user" Primary="true" />
                        }
                    </div>
                </header>

                @if (account.Workspaces.Count == 0)
                {
                    <p class="admin-empty">This user does not belong to a workspace.</p>
                }
                @foreach (var workspace in account.Workspaces)
                {
                    <section class="admin-workspace">
                        <h3>
                            @workspace.Name
                            <small>@workspace.Role · @workspace.Properties.Count @(workspace.Properties.Count == 1 ? "property" : "properties")</small>
                        </h3>
                        @if (workspace.Properties.Count == 0)
                        {
                            <p class="admin-empty">No properties yet.</p>
                        }
                        else
                        {
                            <div class="admin-table-wrap">
                                <table class="admin-table">
                                    <thead><tr><th>Property</th><th>Status</th><th>Updated</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                                    <tbody>
                                        @foreach (var property in workspace.Properties)
                                        {
                                            <tr>
                                                <td><strong>@property.Address1</strong><br /><span class="admin-user-meta">@property.City, @property.State @property.ZipCode</span></td>
                                                <td>@(property.IsArchived ? "Archived" : PropertyDisplay.Name(property.ListingStatus))</td>
                                                <td>@property.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                                                <td class="admin-table-action">
                                                    @if (!account.IsPlatformAdmin)
                                                    {
                                                        <ImpersonateForm UserId="@account.UserId" Query="@result.Query"
                                                                         ReturnUrl="@($"/properties/{property.Id}")" Label="Open property" />
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }
                @if (account.IsPlatformAdmin)
                {
                    <p class="admin-empty">Other platform administrators cannot be impersonated.</p>
                }
            </MudPaper>
        }
    </div>
}

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-6">
    Opening a workspace or property signs you in as that user for up to
    @((int)PlatformAdminImpersonation.MaximumDuration.TotalMinutes) minutes. Each start and stop, every Testers
    change and every email is written to the <MudLink Href="/admin/audit">audit log</MudLink>. Billing changes are
    blocked while you are impersonating.
</MudAlert>

@code {
    private AdminAccountSearchResult? result;

    [SupplyParameterFromQuery]
    public string? Q { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public bool? Testers { get; set; }

    [SupplyParameterFromQuery]
    public string? Notice { get; set; }

    private bool TestersView => Testers == true;

    // Where the email page sends the admin back to: this search, or the Testers list.
    private string ReturnQuery => TestersView ? string.Empty : Q?.Trim() ?? string.Empty;

    private string EmailLink(string userId) =>
        $"/admin/email?to={Uri.EscapeDataString(userId)}&q={Uri.EscapeDataString(ReturnQuery)}";

    private (Severity Severity, string Text)? NoticeMessage => Notice switch
    {
        "tester-added-emailed" => (Severity.Success, $"Added to Testers. They get every feature and {PlatformTesters.DefaultMonthlyCampaignLimit} campaigns a month, and a welcome email is queued (see Sent emails)."),
        "tester-added" => (Severity.Success, $"Added to Testers. They get every feature and {PlatformTesters.DefaultMonthlyCampaignLimit} campaigns a month. They have no email address, so no welcome email was sent."),
        "tester-removed" => (Severity.Success, "Removed from Testers. Their workspace's plan and allowance apply again."),
        "tester-limit-saved" => (Severity.Success, "Saved the tester's monthly campaign limit. It applies right away."),
        "tester-limit-invalid" => (Severity.Warning, $"Enter a monthly campaign limit from 0 to {PlatformTesters.MaximumMonthlyCampaignLimit}."),
        "tester-unchanged" => (Severity.Info, "Nothing changed; the user was already in that state."),
        "tester-UserNotFound" => (Severity.Warning, "That user no longer exists."),
        "tester-NotPlatformAdmin" => (Severity.Warning, "Your account no longer has platform administrator access."),
        "tester-invited-new" => (Severity.Success, "Tester account created. Their welcome email with a temporary password is queued, and they must change it after signing in."),
        "tester-invited-existing" => (Severity.Success, "The existing account was added to Testers and a welcome email is queued."),
        "tester-invite-unchanged" => (Severity.Info, "That account is already in Testers; no email or password change was needed."),
        "tester-invite-invalid-email" => (Severity.Warning, "Enter a valid tester email address."),
        "tester-invite-account-failed" => (Severity.Warning, "The tester account could not be created. Check whether the email is already in use and try again."),
        "tester-invite-not-admin" => (Severity.Warning, "Your account no longer has platform administrator access."),
        _ => null,
    };

    private string? ErrorMessage => Enum.TryParse<ImpersonationStartFailure>(Error, out var failure)
        ? failure switch
        {
            ImpersonationStartFailure.UserNotFound => "That user no longer exists.",
            ImpersonationStartFailure.SelfImpersonation => "You cannot impersonate your own account.",
            ImpersonationStartFailure.TargetIsPlatformAdmin => "Other platform administrators cannot be impersonated.",
            ImpersonationStartFailure.NotPlatformAdmin => "Your account no longer has platform administrator access.",
            _ => null,
        }
        : null;

    protected override async Task OnParametersSetAsync()
    {
        result = null;
        if (TestersView)
        {
            result = await AccountDirectory.ListTestersAsync();
        }
        else if (!string.IsNullOrWhiteSpace(Q) && Q.Trim().Length >= IPlatformAdminAccountDirectory.MinimumQueryLength)
        {
            result = await AccountDirectory.SearchAsync(Q);
        }
    }
}
