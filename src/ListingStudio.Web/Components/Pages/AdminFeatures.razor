@page "/admin/features"
@attribute [Authorize(Policy = PlatformAdministration.Policy)]
@rendermode InteractiveServer
@using ListingStudio.Domain.Administration
@inject IFeatureRolloutService Rollout
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<AdminFeatures> Logger

<PageTitle>Release switches</PageTitle>

<div class="section-row admin-page-heading">
    <div>
        <span class="eyebrow">CONTROLLED RELEASE</span>
        <MudText Typo="Typo.h3" HtmlTag="h1">Release switches</MudText>
        <MudText Typo="Typo.body1">Turn a feature on for pilot workspaces first, then for everyone. The global switch is the kill switch: off always wins over the pilot list. Changes reach the Web and Worker within 15 seconds, with no deployment.</MudText>
    </div>
    <MudButton Href="/admin" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">System overview</MudButton>
</div>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" aria-live="polite" data-testid="features-error">@error</MudAlert>
}
@if (notice is not null)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" aria-live="polite" data-testid="features-notice">@notice</MudAlert>
}

@if (view is not null)
{
    <MudPaper Elevation="0" Class="admin-panel feature-switch" data-testid="@($"feature-{featureKey}")">
        <div class="feature-unit-picker" role="group" aria-label="Release unit" data-testid="feature-picker">
            <button type="button"
                    class="@(featureKey == FeatureFlagKeys.VerticalVideoLibraryV1 ? "selected" : null)"
                    aria-pressed="@(featureKey == FeatureFlagKeys.VerticalVideoLibraryV1)"
                    disabled="@busy"
                    @onclick="@(() => ChangeFeatureAsync(FeatureFlagKeys.VerticalVideoLibraryV1))">
                Vertical video library
            </button>
            <button type="button"
                    class="@(featureKey == FeatureFlagKeys.Kling4FullTourV1 ? "selected" : null)"
                    aria-pressed="@(featureKey == FeatureFlagKeys.Kling4FullTourV1)"
                    disabled="@busy"
                    @onclick="@(() => ChangeFeatureAsync(FeatureFlagKeys.Kling4FullTourV1))">
                Kling 4 continuous Tour Map
            </button>
            <button type="button"
                    class="@(featureKey == FeatureFlagKeys.Kling4NativePresenterV1 ? "selected" : null)"
                    aria-pressed="@(featureKey == FeatureFlagKeys.Kling4NativePresenterV1)"
                    disabled="@busy"
                    @onclick="@(() => ChangeFeatureAsync(FeatureFlagKeys.Kling4NativePresenterV1))">
                Kling 4 native presenter
            </button>
        </div>
        <header class="feature-switch-head">
            <div>
                <MudText Typo="Typo.h5" HtmlTag="h2">@FeatureName</MudText>
                <code>@featureKey</code>
            </div>
            <span class="@($"feature-state {(view.State.IsGloballyEnabled ? "on" : "off")}")" data-testid="feature-summary">@view.Summary</span>
        </header>
        <p class="feature-help">
            @FeatureHelp
        </p>

        <div class="feature-toggles">
            <MudSwitch T="bool" @bind-Value="global" Color="Color.Primary" Label="Global switch (kill switch)" Disabled="busy" data-testid="feature-global" />
            <MudSwitch T="bool" @bind-Value="everyone" Color="Color.Primary" Label="Every workspace (leave off for a pilot)" Disabled="busy" data-testid="feature-everyone" />
        </div>

        <section aria-labelledby="pilot-heading" class="feature-pilots">
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="pilot-heading">Pilot workspaces (@pilots.Count)</MudText>
            @if (pilots.Count == 0)
            {
                <p class="feature-help">No pilot workspaces yet.</p>
            }
            else
            {
                <ul class="feature-workspaces" data-testid="feature-pilots">
                    @foreach (var workspace in pilots.Values.OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <li @key="workspace.Id">
                            <span><strong>@workspace.Name</strong> · @workspace.Members @(workspace.Members == 1 ? "member" : "members")@(workspace.Reason is null ? null : $" · {workspace.Reason}")</span>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="busy" OnClick="@(() => pilots.Remove(workspace.Id))"
                                       aria-label="@($"Remove {workspace.Name} from the pilot")">Remove</MudButton>
                        </li>
                    }
                </ul>
            }

            @if (Suggested.Count > 0)
            {
                <div class="feature-suggested">
                    <p class="feature-help">
                        Start with testers and platform admins: @Suggested.Count @(Suggested.Count == 1 ? "workspace has" : "workspaces have") a Tester or platform admin and @(Suggested.Count == 1 ? "isn't" : "aren't") in the pilot.
                    </p>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="busy" OnClick="AddSuggested" data-testid="feature-add-suggested">
                        Add tester and admin workspaces (@Suggested.Count)
                    </MudButton>
                </div>
            }

            <div class="feature-search">
                <label for="feature-search">Add a workspace by name</label>
                <div>
                    <input id="feature-search" type="search" @bind="query" @bind:event="oninput" placeholder="At least 2 letters" data-testid="feature-search" />
                    <MudButton Variant="Variant.Text" Disabled="@(busy || (query?.Trim().Length ?? 0) < 2)" OnClick="SearchAsync" data-testid="feature-search-go">Search</MudButton>
                </div>
                @if (results.Count > 0)
                {
                    <ul class="feature-workspaces">
                        @foreach (var workspace in results.Where(item => !pilots.ContainsKey(item.Id)))
                        {
                            <li @key="workspace.Id">
                                <span><strong>@workspace.Name</strong> · @workspace.Members @(workspace.Members == 1 ? "member" : "members")</span>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => pilots[workspace.Id] = workspace)">Add</MudButton>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        <footer class="feature-save">
            <p class="feature-help" data-testid="feature-pending">After saving: @FeatureRolloutText.Summary(global, everyone, pilots.Count)</p>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || !Changed)" OnClick="SaveAsync" data-testid="feature-save">Save</MudButton>
        </footer>
        @if (view.State.UpdatedAtUtc is { } updated)
        {
            <p class="feature-help">Last changed @updated.ToString("MMM d, yyyy · HH:mm") UTC. Every change is written to the audit log.</p>
        }
    </MudPaper>
}

@code {
    private FeatureRolloutView? view;
    private string featureKey = FeatureFlagKeys.VerticalVideoLibraryV1;
    private bool global;
    private bool everyone;
    private Dictionary<Guid, FeatureWorkspaceChoice> pilots = [];
    private IReadOnlyList<FeatureWorkspaceChoice> results = [];
    private string? query;
    private bool busy;
    private string? error;
    private string? notice;

    private IReadOnlyList<FeatureWorkspaceChoice> Suggested =>
        view?.SuggestedPilots.Where(item => !pilots.ContainsKey(item.Id)).ToArray() ?? [];

    private bool Changed => view is not null && (global != view.State.IsGloballyEnabled || everyone != view.State.IsEnabledForAllOrganizations
        || !pilots.Keys.ToHashSet().SetEquals(view.State.PilotOrganizationIds));

    private string FeatureName => featureKey switch
    {
        FeatureFlagKeys.Kling4FullTourV1 => "Kling 4 continuous Tour Map",
        FeatureFlagKeys.Kling4NativePresenterV1 => "Kling 4 native presenter",
        _ => "Vertical video library",
    };

    private string FeatureHelp => featureKey switch
    {
        FeatureFlagKeys.Kling4FullTourV1 => "Experimental 30-second 1080p continuous tours generated from the approved Tour Map, with the agent presenter limited to the lip-synced opening and closing. Off restores the established CLS edit for every workspace, including queued campaigns that have not submitted to the provider yet. Existing deliverables are retained for comparison.",
        FeatureFlagKeys.Kling4NativePresenterV1 => "Experimental single-call 30-second Kling 4 video using the consented profile headshot as the opening and closing frame, approved Tour Map photos in between, and Kling's native speech and music. Off restores the established CLS edit for queued work that has not reached Higgsfield. Existing deliverables are retained for comparison.",
        _ => "Recommended multi-format vertical videos, the Creative format testing tab, performance tracking and the One Listing Four TikToks article. Off gives every workspace the single shared vertical video and the previous copy. Turning it off never deletes libraries, tests or recorded numbers; unfinished library campaigns fall back to the shared video and queued creative tests wait.",
    };

    protected override Task OnInitializedAsync() => LoadFeatureAsync(featureKey);

    private async Task ChangeFeatureAsync(string key)
    {
        if (!FeatureFlagKeys.IsKnown(key))
        {
            return;
        }

        featureKey = key;
        await LoadFeatureAsync(key);
    }

    private Task LoadFeatureAsync(string key) => RunAsync(async userId =>
        Apply(await Rollout.GetAsync(userId, key)));

    private void Apply(FeatureRolloutView loaded)
    {
        view = loaded;
        global = loaded.State.IsGloballyEnabled;
        everyone = loaded.State.IsEnabledForAllOrganizations;
        pilots = loaded.Pilots.ToDictionary(item => item.Id);
    }

    private void AddSuggested()
    {
        foreach (var workspace in Suggested)
        {
            pilots[workspace.Id] = workspace;
        }
    }

    private Task SearchAsync() => RunAsync(async userId => results = await Rollout.SearchWorkspacesAsync(userId, query ?? string.Empty));

    private Task SaveAsync() => RunAsync(async userId =>
    {
        Apply(await Rollout.SaveAsync(userId, featureKey, global, everyone, pilots.Keys.ToArray()));
        notice = $"Saved. {view!.Summary} It takes effect within 15 seconds.";
    });

    private async Task RunAsync(Func<string, Task> action)
    {
        busy = true;
        error = null;
        notice = null;
        try
        {
            await action(await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider));
        }
        catch (UnauthorizedAccessException)
        {
            error = "Platform administration access is required.";
        }
        catch (ArgumentException exception)
        {
            error = exception.Message.Split(" (Parameter", 2)[0];
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Changing a release switch failed");
            error = "That didn't work. Refresh the page and try again.";
        }
        finally
        {
            busy = false;
        }
    }
}
