@page "/"
<PageTitle>Listing Studio</PageTitle>

<section class="hero-section">
    <div class="hero-copy">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                 Icon="@Icons.Material.Filled.AutoAwesome">CREATIVE WORKSPACE FOR REAL ESTATE</MudChip>
        <MudText Typo="Typo.h1" HtmlTag="h1" Class="hero-title">
            Every listing deserves a <span>standout story.</span>
        </MudText>
        <MudText Typo="Typo.h6" HtmlTag="p" Class="hero-subtitle">
            Organize property details and media, develop grounded marketing narratives, and prepare campaign assets from one polished workspace.
        </MudText>
        <MudStack Row="true" Spacing="2" Class="hero-actions">
            <AuthorizeView>
                <Authorized>
                    <MudButton Href="/properties" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               EndIcon="@Icons.Material.Filled.ArrowForward">Open properties</MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="/Account/Register" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               EndIcon="@Icons.Material.Filled.ArrowForward">Start creating</MudButton>
                    <MudButton Href="/Account/Login" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large">Log in</MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </MudStack>
        <div class="trust-row">
            <span><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" /> Organization-scoped data</span>
            <span><MudIcon Icon="@Icons.Material.Filled.FactCheck" /> Grounded content</span>
        </div>
    </div>

    <div class="hero-visual" aria-label="Listing Studio workspace preview">
        <div class="visual-glow"></div>
        <MudPaper Elevation="8" Class="preview-window">
            <div class="preview-toolbar">
                <span class="preview-dot red"></span><span class="preview-dot amber"></span><span class="preview-dot green"></span>
                <span class="preview-address">Listing workspace</span>
            </div>
            <div class="preview-content">
                <div class="property-image-placeholder">
                    <MudIcon Icon="@Icons.Material.Filled.HolidayVillage" />
                    <span>PROPERTY MEDIA</span>
                </div>
                <div class="preview-details">
                    <span class="eyebrow">CAMPAIGN READY</span>
                    <MudText Typo="Typo.h5">A clear path from data to creative</MudText>
                    <div class="preview-progress"><span></span></div>
                    <div class="preview-metrics">
                        <div><strong>01</strong><small>Property</small></div>
                        <div><strong>06</strong><small>Media</small></div>
                        <div><strong>03</strong><small>Outputs</small></div>
                    </div>
                </div>
            </div>
        </MudPaper>
        <MudPaper Elevation="5" Class="floating-card story-card">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" Color="Color.Primary" />
            <div><small>MARKETING STORY</small><strong>Grounded and ready</strong></div>
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
        </MudPaper>
        <MudPaper Elevation="5" Class="floating-card media-card-float">
            <MudIcon Icon="@Icons.Material.Filled.Collections" Color="Color.Secondary" />
            <div><small>MEDIA LIBRARY</small><strong>Organized in one place</strong></div>
        </MudPaper>
    </div>
</section>

<section class="agent-spotlight" aria-labelledby="agent-spotlight-title">
    <figure class="agent-portrait">
        <img src="/images/agent-portrait.webp" width="640" height="640" loading="lazy"
             alt="Portrait of a real estate agent in a white fedora" />
        <figcaption>
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
            <span>Listing agent</span>
        </figcaption>
    </figure>
    <div class="agent-copy">
        <span class="eyebrow">BUILT FOR LISTING AGENTS</span>
        <MudText Typo="Typo.h3" HtmlTag="h2" id="agent-spotlight-title">Spend your time with clients, not on edit timelines</MudText>
        <MudText Typo="Typo.body1" HtmlTag="p">
            Add the property facts and photos once. Listing Studio turns them into a grounded marketing story,
            a narrated video script, three campaign videos and ready-to-post social captions.
        </MudText>
        <ul class="agent-points">
            <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> Every claim comes from your verified listing data</li>
            <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> HERO, FEATURE and TEASER videos from one set of photos</li>
            <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> Your listings stay private to your organization</li>
        </ul>
    </div>
</section>

<section class="feature-section">
    <div class="section-heading">
        <span class="eyebrow">ONE CONNECTED WORKFLOW</span>
        <MudText Typo="Typo.h3" HtmlTag="h2">From property intake to campaign delivery</MudText>
    </div>
    <MudGrid Spacing="3">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="feature-card">
                <span class="feature-icon indigo"><MudIcon Icon="@Icons.Material.Filled.HomeWork" /></span>
                <MudText Typo="Typo.h5" HtmlTag="h3">Property workspace</MudText>
                <MudText Typo="Typo.body2">Keep listing facts, pricing, status, and descriptive details structured and easy to update.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="feature-card">
                <span class="feature-icon sky"><MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" /></span>
                <MudText Typo="Typo.h5" HtmlTag="h3">Media intelligence</MudText>
                <MudText Typo="Typo.body2">Upload, order, and review property imagery alongside practical analysis and quality signals.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="feature-card">
                <span class="feature-icon amber"><MudIcon Icon="@Icons.Material.Filled.MovieCreation" /></span>
                <MudText Typo="Typo.h5" HtmlTag="h3">Campaign production</MudText>
                <MudText Typo="Typo.body2">Turn approved property inputs into reusable story and campaign deliverables with a traceable workflow.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</section>
