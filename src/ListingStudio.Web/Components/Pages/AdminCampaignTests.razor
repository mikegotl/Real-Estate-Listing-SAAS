@page "/admin/campaign-tests"
@attribute [Authorize(Policy = PlatformAdministration.Policy)]
@attribute [StreamRendering]
@rendermode InteractiveServer
@inherits OwningComponentBase<ICampaignReviewService>
@using Microsoft.Extensions.DependencyInjection
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<AdminCampaignTests> Logger

<PageTitle>TikTok campaign review</PageTitle>
<PropertyPageProviders />

<div class="section-row admin-page-heading">
    <div>
        <span class="eyebrow">CAMPAIGN QUALITY</span>
        <MudText Typo="Typo.h3" HtmlTag="h1">TikTok review studio</MudText>
        <MudText Typo="Typo.body1">Watch your workspace's vertical campaigns, record approval, and work through requested changes.</MudText>
    </div>
    <div class="admin-heading-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="LoadAsync"
                   StartIcon="@Icons.Material.Filled.Refresh">@(busy ? "Refreshing…" : "Refresh gallery")</MudButton>
        <MudButton Href="/properties" Variant="Variant.Outlined" Color="Color.Primary">Open properties</MudButton>
        <MudButton Href="/admin" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">Overview</MudButton>
    </div>
</div>

<div class="review-guidance">
    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" aria-hidden="true" />
    <p>
        <strong>Your approval belongs to one video version.</strong>
        <span>A replacement render needs a fresh review. Requesting changes saves your feedback; use the video chat to propose and render the edit.</span>
    </p>
</div>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@error</MudAlert>
}
@if (notice is not null)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">@notice</MudAlert>
}

@if (items is null)
{
    @if (error is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading campaign gallery" />
    }
}
else
{
    var awaiting = items.Count(item => CanReview(item) && item.Decision is null);
    <dl class="workspace-metrics" aria-label="Campaign review summary">
        <div class="@(awaiting > 0 ? "attention" : null)"><dt>Awaiting review</dt><dd>@awaiting</dd></div>
        <div><dt>Approved</dt><dd>@items.Count(item => item.Decision == CampaignVideoReviewDecision.Approved)</dd></div>
        <div><dt>Changes requested</dt><dd>@items.Count(item => item.Decision == CampaignVideoReviewDecision.ChangesRequested)</dd></div>
        <div><dt>In progress</dt><dd>@items.Count(item => item.CampaignStatus is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)</dd></div>
    </dl>

    <section class="review-suite" aria-labelledby="suite-heading">
        <div class="review-suite-intro">
            <span class="eyebrow">BACKGROUND TEST WORKER</span>
            <MudText Typo="Typo.h5" HtmlTag="h2" id="suite-heading">Run three TikTok cases</MudText>
            <p>Choose a test property. The worker generates three new vertical campaigns in sequence (short voiceover, music and text, full voiceover) and keeps running when you leave this page. Starting a suite uses generation credits and campaign allowance.</p>
        </div>
        <div class="review-suite-start">
            <div class="review-property-choice">
                <label for="review-test-property">Test property</label>
                <select id="review-test-property" @bind="selectedPropertyId" disabled="@busy">
                    <option value="">Choose a property</option>
                    @foreach (var property in propertyChoices)
                    {
                        <option value="@property.Id">@property.Address</option>
                    }
                </select>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || !Guid.TryParse(selectedPropertyId, out _))"
                       OnClick="StartSuiteAsync" StartIcon="@Icons.Material.Filled.PlayArrow">Start three TikTok tests</MudButton>
        </div>
    </section>

    <div class="section-row review-gallery-heading">
        <MudText Typo="Typo.h5" HtmlTag="h2">Video gallery</MudText>
        <span>Latest @items.Count campaigns · your workspace only</span>
    </div>

    @if (items.Count == 0 && suites.Count == 0)
    {
        <div class="review-empty">
            <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Size="Size.Large" aria-hidden="true" />
            <h3>No TikTok campaigns yet</h3>
            <p>Open a property and generate a vertical campaign. Its progress and video will appear here.</p>
            <MudButton Href="/properties" Variant="Variant.Filled" Color="Color.Primary">Choose a property</MudButton>
        </div>
    }
    else
    {
        <label class="review-archive-filter">
            <input type="checkbox" @bind="showArchived" />
            Show archived sessions (@suites.Count(s => s.ArchivedAtUtc is not null))
        </label>
        @foreach (var group in SessionGroups())
        {
            var expanded = !collapsedSessions.Contains(group.Id);
            <section class="review-session" @key="group.Id" aria-label="@group.Title">
                <header class="review-session-header">
                    <button type="button" class="review-session-toggle" aria-expanded="@(expanded ? "true" : "false")"
                            aria-controls="@($"session-body-{group.Id}")" @onclick="() => ToggleSession(group.Id)">
                        <span class="review-session-chevron" aria-hidden="true">@(expanded ? "▾" : "▸")</span>
                        <span>
                            <strong>@group.Title</strong>
                            @if (group.Suite is { } details)
                            {
                                <span class="review-session-meta">@details.Address · @details.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</span>
                            }
                            <span class="review-session-meta">@group.Items.Count video campaigns · @(expanded ? "Collapse" : "Expand")</span>
                        </span>
                    </button>
                    @if (group.Suite is { } session)
                    {
                        <span class="review-status @SuiteClass(session.Status)">@session.Status</span>
                        @if (session.ArchivedAtUtc is not null)
                        {
                            <span class="review-status">Archived</span>
                        }
                        <div class="review-session-actions">
                            <MudButton Size="Size.Small" Color="Color.Warning" Disabled="@(busy || !IsActive(session))"
                                       OnClick="() => CancelSuiteAsync(session.Id)">Cancel session</MudButton>
                            <MudButton Size="Size.Small" Disabled="@(busy || IsActive(session))"
                                       OnClick="() => ArchiveSuiteAsync(session.Id, session.ArchivedAtUtc is null)">
                                @(session.ArchivedAtUtc is null ? "Archive session" : "Restore session")
                            </MudButton>
                        </div>
                    }
                </header>
                @if (expanded)
                {
                    <div class="review-session-body" id="@($"session-body-{group.Id}")">
                        @if (group.Suite is { } sessionInfo)
                        {
                            @if (IsActive(sessionInfo))
                            {
                                <p class="review-session-help">Cancel stops remaining cases and requests cancellation of the active campaign. Cancel before archiving.</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(sessionInfo.Error))
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@sessionInfo.Error</MudAlert>
                            }
                            <ol class="review-case-list">
                                @for (var index = 0; index < TestCaseNames.Length; index++)
                                {
                                    var jobId = sessionInfo.CaseJobIds.ElementAtOrDefault(index);
                                    <li>
                                        <strong>Case @(index + 1): @TestCaseNames[index]</strong>
                                        @if (jobId.HasValue && group.Items.Any(i => i.JobId == jobId))
                                        {
                                            <a href="@($"/admin/campaign-tests#campaign-{jobId.Value}")">View campaign</a>
                                        }
                                        else if (jobId.HasValue)
                                        {
                                            <a href="@($"/properties/{sessionInfo.PropertyId}?tab=campaign")">Open older campaign</a>
                                        }
                                        else
                                        {
                                            <span class="review-case-waiting">@(IsActive(sessionInfo) ? "Waiting" : "Not started")</span>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                        <div class="review-grid">
            @foreach (var item in group.Items)
            {
                var draft = DraftFor(item.JobId, item.Version);
                <article id="@($"campaign-{item.JobId}")" class="review-card" @key="item.JobId">
                    <header class="review-card-heading">
                        <div>
                            <span class="review-kicker">TikTok · 9:16</span>
                            <h3>@CaseTitle(item.JobId)</h3>
                            <p class="review-card-address">@item.Address</p>
                            <p>@item.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</p>
                        </div>
                        <span class="review-status @DecisionClass(item)">@DecisionText(item)</span>
                    </header>

                    @if (CanReview(item))
                    {
                        <div class="review-player">
                            <video @key="@($"{item.JobId}-{item.Version}")" controls preload="metadata" playsinline
                                   aria-label="@($"TikTok video for {item.Address}, version {item.Version}")">
                                <source src="@VideoUrl(item)" type="video/mp4" />
                                Your browser does not support MP4 playback.
                            </video>
                        </div>
                        <div class="review-video-links">
                            <span>Version @item.Version</span>
                            <a href="@(VideoUrl(item) + "&download=true")">
                                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" aria-hidden="true" />Download MP4
                            </a>
                        </div>
                    }
                    else if (item.CampaignStatus is CampaignGenerationStatus.Failed or CampaignGenerationStatus.Cancelled)
                    {
                        <div class="review-pending stopped" role="status">
                            <span class="review-pending-icon"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline" aria-hidden="true" /></span>
                            <strong>@(item.CampaignStatus == CampaignGenerationStatus.Failed ? "Campaign failed" : "Campaign cancelled")</strong>
                            <span>Stopped while @StageText(item.Stage)</span>
                        </div>
                    }
                    else
                    {
                        <div class="review-pending" role="status">
                            <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
                            <strong>@(item.CampaignStatus == CampaignGenerationStatus.Queued ? "Queued" : "In progress")</strong>
                            <span>@(char.ToUpperInvariant(StageText(item.Stage)[0]) + StageText(item.Stage)[1..])</span>
                            <p>Refresh the gallery to check progress. You can leave this page while the campaign runs.</p>
                        </div>
                    }

                    <div class="review-card-content">
                        <ul class="review-settings" aria-label="Campaign settings">
                            @foreach (var setting in SettingLabels(item.Settings))
                            {
                                <li>@setting</li>
                            }
                        </ul>
                        @if (!string.IsNullOrWhiteSpace(item.Error))
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@item.Error</MudAlert>
                        }
                        <a class="review-property-link" href="@($"/properties/{item.PropertyId}?tab=campaign")">Open property campaign →</a>

                        @if (CanReview(item))
                        {
                            <div class="review-decision">
                                <h4>Review version @item.Version</h4>
                                <p>Check the property facts, framing, captions, voice, music and closing card.</p>
                                <MudTextField T="string" @bind-Value="draft.Feedback" Label="Review notes or requested changes"
                                              Variant="Variant.Outlined" Lines="3" MaxLength="1000" Counter="1000"
                                              Disabled="busy" />
                                <div class="review-decision-actions">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="busy"
                                               StartIcon="@Icons.Material.Filled.Check"
                                               OnClick="() => DecideAsync(item, CampaignVideoReviewDecision.Approved)">
                                        Approve version @item.Version
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                               Disabled="@(busy || string.IsNullOrWhiteSpace(draft.Feedback))"
                                               OnClick="() => DecideAsync(item, CampaignVideoReviewDecision.ChangesRequested)">
                                        Request changes
                                    </MudButton>
                                </div>
                            </div>
                            <CampaignVideoChatPanel @key="@($"chat-{item.JobId}-{item.Version}")"
                                                    JobId="item.JobId" Kind="CampaignOutputKind.TikTok"
                                                    VideoName="TikTok video" VersionChanged="LoadAsync" />
                        }

                        @if (item.History.Count > 0)
                        {
                            <details class="review-history">
                                <summary>Review history (@item.History.Count)</summary>
                                <ol>
                                    @foreach (var entry in item.History)
                                    {
                                        <li>
                                            <strong>Version @entry.Version · @(entry.Decision == CampaignVideoReviewDecision.Approved ? "Approved" : "Changes requested")</strong>
                                            <time>@entry.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</time>
                                            @if (!string.IsNullOrWhiteSpace(entry.Feedback))
                                            {
                                                <p>@entry.Feedback</p>
                                            }
                                        </li>
                                    }
                                </ol>
                            </details>
                        }
                    </div>
                </article>
            }
        </div>
                    </div>
                }
            </section>
        }

    }
}

@code {
    private readonly CancellationTokenSource disposal = new();
    private readonly Dictionary<(Guid JobId, int Version), ReviewDraft> drafts = [];
    private static readonly string[] TestCaseNames = ["Short voiceover · 30s", "Music and text · 30s", "Full voiceover · 60s"];
    private IReadOnlyList<CampaignReviewItem>? items;
    private IReadOnlyList<TikTokTestPropertyChoice> propertyChoices = [];
    private IReadOnlyList<TikTokTestSuiteResult> suites = [];
    private string? selectedPropertyId;
    private bool showArchived;
    private readonly HashSet<Guid> collapsedSessions = [];
    private readonly HashSet<Guid> knownSessions = [];
    private bool busy;
    private string? error;
    private string? notice;

    protected override Task OnInitializedAsync() => LoadAsync();

    private ITikTokTestSuiteService SuiteService => ScopedServices.GetRequiredService<ITikTokTestSuiteService>();

    private async Task LoadAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        error = null;
        notice = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            await LoadDataAsync(userId);
        }
        catch (OperationCanceledException) when (disposal.IsCancellationRequested)
        {
        }
        catch (UnauthorizedAccessException)
        {
            error = "This gallery requires platform administrator access to your current workspace.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Loading the campaign review gallery failed");
            error = "The gallery could not be loaded. Try refreshing in a moment.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadDataAsync(string userId)
    {
        // Both services share this component's owning scope; keep EF operations sequential.
        items = await Service.ListAsync(userId, disposal.Token);
        propertyChoices = await SuiteService.PropertyChoicesAsync(userId, disposal.Token);
        suites = await SuiteService.ListAsync(userId, disposal.Token);
        var latest = suites.OrderByDescending(s => s.CreatedAtUtc).ThenByDescending(s => s.Id).FirstOrDefault()?.Id;
        foreach (var suite in suites)
        {
            if (knownSessions.Add(suite.Id) && suite.Id != latest)
                collapsedSessions.Add(suite.Id);
        }
        if (knownSessions.Add(Guid.Empty)) collapsedSessions.Add(Guid.Empty);
        foreach (var suite in suites.Where(s => !collapsedSessions.Contains(s.Id) && (showArchived || s.ArchivedAtUtc is null)))
        {
            var sessionItems = await Service.ListSessionAsync(userId, suite.Id, disposal.Token);
            items = items.Where(item => !sessionItems.Any(video => video.JobId == item.JobId))
                .Concat(sessionItems).OrderByDescending(item => item.CreatedAtUtc).ToArray();
        }
    }

    private Task StartSuiteAsync() => Guid.TryParse(selectedPropertyId, out var propertyId)
        ? MutateSuiteAsync(async userId =>
        {
            await SuiteService.StartAsync(userId, propertyId, disposal.Token);
            notice = "The three-case suite is queued. You can leave this page; refresh later to review the outputs.";
        })
        : Task.CompletedTask;

    private Task CancelSuiteAsync(Guid suiteId) => MutateSuiteAsync(async userId =>
    {
        await SuiteService.CancelAsync(userId, suiteId, disposal.Token);
        notice = "Session cancelled. The active campaign was asked to stop; completed videos are kept.";
    });

    private Task ArchiveSuiteAsync(Guid suiteId, bool archived) => MutateSuiteAsync(async userId =>
    {
        await SuiteService.SetArchivedAsync(userId, suiteId, archived, disposal.Token);
        notice = archived ? "Session archived. Use Show archived sessions to restore it." : "Session restored.";
    });

    private async Task MutateSuiteAsync(Func<string, Task> action)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        error = null;
        notice = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            await action(userId);
            await LoadDataAsync(userId);
        }
        catch (OperationCanceledException) when (disposal.IsCancellationRequested)
        {
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        catch (UnauthorizedAccessException)
        {
            error = "This test suite is not available in your current workspace.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Updating a TikTok test suite failed");
            error = "The test suite could not be updated. Refresh the gallery before trying again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DecideAsync(CampaignReviewItem item, CampaignVideoReviewDecision decision)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        error = null;
        notice = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            await Service.DecideAsync(userId, item.JobId, item.Version, decision, DraftFor(item.JobId, item.Version).Feedback, disposal.Token);
            await LoadDataAsync(userId);
            DraftFor(item.JobId, item.Version).Feedback = null;
            notice = decision == CampaignVideoReviewDecision.Approved
                ? $"Version {item.Version} approved. Future renders will need a new review."
                : $"Changes requested for version {item.Version}. Use the video chat to propose and render the update.";
        }
        catch (OperationCanceledException) when (disposal.IsCancellationRequested)
        {
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        catch (UnauthorizedAccessException)
        {
            error = "This review is not available in your current workspace.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Saving a campaign review decision failed");
            error = "Your review could not be saved. Refresh the gallery before trying again.";
        }
        finally
        {
            busy = false;
        }
    }

    private ReviewDraft DraftFor(Guid jobId, int version)
    {
        if (!drafts.TryGetValue((jobId, version), out var draft))
        {
            draft = new ReviewDraft();
            drafts.Add((jobId, version), draft);
        }

        return draft;
    }

    private async Task ToggleSession(Guid id)
    {
        if (busy) return;
        if (!collapsedSessions.Contains(id))
        {
            collapsedSessions.Add(id);
            return;
        }
        if (id == Guid.Empty)
        {
            collapsedSessions.Remove(id);
            return;
        }
        busy = true;
        error = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            var sessionItems = await Service.ListSessionAsync(userId, id, disposal.Token);
            items = (items ?? []).Where(item => !sessionItems.Any(video => video.JobId == item.JobId))
                .Concat(sessionItems).OrderByDescending(item => item.CreatedAtUtc).ToArray();
            collapsedSessions.Remove(id);
        }
        catch (OperationCanceledException) when (disposal.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Loading a test session failed");
            error = "The session videos could not be loaded. Refresh and try again.";
        }
        finally { busy = false; }
    }

    private static bool IsActive(TikTokTestSuiteResult suite) =>
        suite.Status is TikTokTestSuiteStatus.Queued or TikTokTestSuiteStatus.Running;

    private IEnumerable<SessionGroup> SessionGroups()
    {
        var assigned = suites.SelectMany(s => s.CaseJobIds).Where(id => id.HasValue).Select(id => id!.Value).ToHashSet();
        var byId = (items ?? []).ToDictionary(i => i.JobId);
        foreach (var suite in suites.OrderByDescending(s => s.CreatedAtUtc).ThenByDescending(s => s.Id))
        {
            if (!showArchived && suite.ArchivedAtUtc is not null) continue;
            var videos = suite.CaseJobIds.Where(id => id.HasValue && byId.ContainsKey(id.Value))
                .Select(id => byId[id!.Value]).ToArray();
            yield return new SessionGroup(suite.Id, $"Test session · {suite.Id.ToString("N")[..8]}", suite, videos);
        }
        var other = (items ?? []).Where(i => !assigned.Contains(i.JobId)).ToArray();
        if (other.Length > 0)
            yield return new SessionGroup(Guid.Empty, "Other campaigns · outside test sessions", null, other);
    }

    private sealed record SessionGroup(Guid Id, string Title, TikTokTestSuiteResult? Suite, IReadOnlyList<CampaignReviewItem> Items);

    private string CaseTitle(Guid jobId)
    {
        foreach (var suite in suites)
        {
            for (var index = 0; index < TestCaseNames.Length; index++)
            {
                if (suite.CaseJobIds.ElementAtOrDefault(index) == jobId)
                {
                    return $"Case {index + 1}: {TestCaseNames[index]}";
                }
            }
        }

        return "TikTok vertical campaign";
    }

    private static bool CanReview(CampaignReviewItem item) => item.CampaignStatus == CampaignGenerationStatus.Completed
        && item.DeliverableStatus == CampaignDeliverableStatus.Rendered;

    private static string VideoUrl(CampaignReviewItem item) => $"/campaigns/{item.JobId}/deliverables/TikTok?v={item.Version}";

    private static string DecisionText(CampaignReviewItem item) => item.Decision switch
    {
        CampaignVideoReviewDecision.Approved => $"Approved · v{item.Version}",
        CampaignVideoReviewDecision.ChangesRequested => "Changes requested",
        _ when CanReview(item) => "Awaiting review",
        _ => item.CampaignStatus == CampaignGenerationStatus.Running ? "In progress" : item.CampaignStatus.ToString(),
    };

    private static string DecisionClass(CampaignReviewItem item) => item.Decision switch
    {
        CampaignVideoReviewDecision.Approved => "approved",
        CampaignVideoReviewDecision.ChangesRequested => "changes",
        _ when CanReview(item) => "awaiting",
        _ => item.CampaignStatus is CampaignGenerationStatus.Failed or CampaignGenerationStatus.Cancelled ? "failed" : "running",
    };

    private static string SuiteClass(TikTokTestSuiteStatus status) => status switch
    {
        TikTokTestSuiteStatus.Completed => "approved",
        TikTokTestSuiteStatus.Failed or TikTokTestSuiteStatus.Cancelled => "failed",
        _ => "running",
    };

    private static string StageText(CampaignGenerationStage stage) => stage switch
    {
        CampaignGenerationStage.ValidateProperty => "checking the property",
        CampaignGenerationStage.AnalyzeMedia => "analyzing photos",
        CampaignGenerationStage.GenerateStory => "writing the story",
        CampaignGenerationStage.GenerateMasterVideoPlan => "planning the video",
        CampaignGenerationStage.GenerateNarration => "recording the voiceover",
        CampaignGenerationStage.GenerateDerivativePlans => "planning the short edits",
        CampaignGenerationStage.GenerateRequiredAiVideo => "generating AI video",
        CampaignGenerationStage.RenderHero or CampaignGenerationStage.RenderFeature
            or CampaignGenerationStage.RenderTeaser or CampaignGenerationStage.RenderLongForm => "rendering the video",
        CampaignGenerationStage.GenerateSocialCopy => "writing social posts",
        _ => "finishing up",
    };

    // Settings arrive as "Template · Pace · Voiceover · Soundtrack · Spoken/Caption" enum names; show plain words.
    private static IEnumerable<string> SettingLabels(string settings)
    {
        var parts = settings.Split(" · ", StringSplitOptions.TrimEntries);
        for (var index = 0; index < parts.Length; index++)
        {
            var part = parts[index];
            yield return (index, part) switch
            {
                (2, nameof(CampaignVoiceoverMode.ShortHook)) => "Short voiceover",
                (2, nameof(CampaignVoiceoverMode.None)) => "Music and text",
                (2, nameof(CampaignVoiceoverMode.Full)) => "Full voiceover",
                (3, nameof(CampaignSoundtrack.None)) => "No music",
                (3, _) => $"{Words(part)} music",
                (1, _) => $"{part} pace",
                (4, _) when part.Split('/') is [var spoken, var caption] => spoken == caption
                    ? spoken : $"{spoken} voice · {caption} captions",
                _ => Words(part),
            };
        }
    }

    private static string Words(string pascalCase) =>
        System.Text.RegularExpressions.Regex.Replace(pascalCase, "(?<=[a-z])(?=[A-Z])", " ").ToLowerInvariant() is { Length: > 0 } words
            ? char.ToUpperInvariant(words[0]) + words[1..]
            : pascalCase;

    protected override async ValueTask DisposeAsyncCore()
    {
        await disposal.CancelAsync();
        disposal.Dispose();
        await base.DisposeAsyncCore();
    }

    private sealed class ReviewDraft
    {
        public string? Feedback { get; set; }
    }
}
