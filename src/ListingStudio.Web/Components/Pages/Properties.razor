@page "/properties"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPropertyService PropertyService

<PageTitle>Properties</PageTitle>

<PropertyPageProviders />

<section class="page-heading">
    <div>
        <span class="eyebrow">INVENTORY</span>
        <MudText Typo="Typo.h3" HtmlTag="h1">Properties</MudText>
        <MudText Typo="Typo.body1">Manage the listings in your organization.</MudText>
    </div>
    <MudButton Href="/properties/new" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">New property</MudButton>
</section>

<div class="property-toolbar">
    <MudTextField T="string" @bind-Value="search" Immediate="true" DebounceInterval="200" Clearable="true"
                  Placeholder="Search by address, city or ZIP" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Class="property-search" aria-label="Search properties" />
    <MudCheckBox T="bool" Value="includeArchived" ValueChanged="IncludeArchivedChangedAsync" Label="Show archived" Color="Color.Primary" />
    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadAsync"
               StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>
</div>

@if (!loaded)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (properties.Count == 0)
{
    <MudPaper Elevation="0" Class="content-card">
        <div class="empty-state">
            <span class="empty-state-icon"><MudIcon Icon="@Icons.Material.Filled.AddHomeWork" Size="Size.Large" /></span>
            <MudText Typo="Typo.h5" HtmlTag="h2">Your property workspace is ready</MudText>
            <MudText Typo="Typo.body2">Add your first listing to organize its details, media, story, and campaign assets.</MudText>
            <MudButton Href="/properties/new" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">Add first property</MudButton>
        </div>
    </MudPaper>
}
else if (Filtered.Count == 0)
{
    <MudPaper Elevation="0" Class="content-card">
        <div class="empty-state">
            <span class="empty-state-icon"><MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" /></span>
            <MudText Typo="Typo.h5" HtmlTag="h2">No properties match "@search"</MudText>
            <MudText Typo="Typo.body2">Try a street name, city or ZIP code.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => search = null)">Clear search</MudButton>
        </div>
    </MudPaper>
}
else
{
    <p class="property-count">@Filtered.Count @(Filtered.Count == 1 ? "property" : "properties")</p>
    <div class="property-card-grid">
        @foreach (var property in Filtered)
        {
            <PropertyCard @key="property.Id" Property="property" />
        }
    </div>
}

@code {
    private IReadOnlyList<PropertySummary> properties = [];
    private bool includeArchived;
    private bool loaded;
    private string? search;

    private IReadOnlyList<PropertySummary> Filtered => string.IsNullOrWhiteSpace(search)
        ? properties
        : [.. properties.Where(property => Matches(property, search.Trim()))];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task IncludeArchivedChangedAsync(bool value)
    {
        includeArchived = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loaded = false;
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        properties = await PropertyService.ListAsync(userId, includeArchived);
        loaded = true;
    }

    private static bool Matches(PropertySummary property, string term) =>
        property.Address1.Contains(term, StringComparison.OrdinalIgnoreCase)
        || property.City.Contains(term, StringComparison.OrdinalIgnoreCase)
        || property.ZipCode.Contains(term, StringComparison.OrdinalIgnoreCase);
}
