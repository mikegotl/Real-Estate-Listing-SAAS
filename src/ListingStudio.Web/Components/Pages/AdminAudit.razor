@page "/admin/audit"
@attribute [Authorize(Policy = PlatformAdministration.Policy)]
@attribute [StreamRendering]
@inject IPlatformAdminDashboardService DashboardService
@inject TimeProvider TimeProvider

<PageTitle>Platform administrator audit log</PageTitle>

<div class="section-row admin-page-heading">
    <div>
        <span class="eyebrow">PLATFORM SECURITY</span>
        <MudText Typo="Typo.h3" HtmlTag="h1">Administrator audit log</MudText>
        <MudText Typo="Typo.body1">Append-only records of sensitive platform-role changes and user impersonation, plus every error answer from an external provider (Higgsfield, HeyGen, OpenAI, ElevenLabs), every change users asked for in campaign video chats and every question asked in the Ask AI help chat.</MudText>
    </div>
    <MudButton Href="/admin" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">Overview</MudButton>
</div>

@if (events is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Elevation="0" Class="admin-panel">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Time</th><th>Action</th><th>Actor</th><th>Actor reference</th><th>Target reference</th><th>Outcome</th></tr></thead>
                <tbody>
                    @foreach (var item in events)
                    {
                        <tr><td>@item.OccurredAtUtc.ToLocalTime().ToString("g")</td><td>@item.Action</td><td>@item.ActorType</td><td>@if (item.ActorReference is { } actor){<code>@actor[..12]</code>}</td><td><code>@item.TargetReference[..12]</code></td><td>@item.Outcome</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </MudPaper>
}

<section class="admin-video-chat" aria-labelledby="provider-errors-heading">
    <MudText Typo="Typo.h5" HtmlTag="h2" id="provider-errors-heading" Class="mt-8 mb-1">Provider errors</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Each time an external provider refused a request or reported that a generation failed: what was being done, the
        HTTP status, the provider's own reply (API keys and tokens removed) and, where known, the exact request that was
        sent. Last 90 days, newest first.
    </MudText>
    @if (providerErrors is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (providerErrors.Count == 0)
    {
        <MudText Typo="Typo.body2" data-testid="provider-errors-empty">No provider errors.</MudText>
    }
    else
    {
        <MudPaper Elevation="0" Class="admin-panel">
            <div class="admin-table-wrap">
                <table class="admin-table admin-video-chat-table" data-testid="provider-errors">
                    <thead><tr><th>Time</th><th>Provider</th><th>What failed</th><th>HTTP</th><th>Provider reply</th><th>Where</th></tr></thead>
                    <tbody>
                        @foreach (var item in providerErrors)
                        {
                            <tr>
                                <td>@item.OccurredAtUtc.ToLocalTime().ToString("g")</td>
                                <td>@item.Provider</td>
                                <td>
                                    @item.Action
                                    @if (item.Stage is { } stage)
                                    {
                                        <br /><span class="mud-text-secondary">@stage@(item.Attempt is { } attempt ? $" · attempt {attempt}" : null)@(item.WillRetry ? " · will retry" : null)</span>
                                    }
                                </td>
                                <td>@(item.StatusCode?.ToString() ?? "—")</td>
                                <td class="admin-chat-text">
                                    @(item.ResponseText ?? "No reply text")
                                    @if (item.ProviderRequestId is { } requestId)
                                    {
                                        <br /><span class="mud-text-secondary">Request <code>@requestId</code></span>
                                    }
                                    @if (item.RequestBody is { } body)
                                    {
                                        <details class="mt-1">
                                            <summary class="mud-typography-caption">Request that was sent</summary>
                                            <pre style="white-space:pre-wrap;font-size:0.75rem;max-height:320px;overflow:auto;">@FormatJson(body)</pre>
                                        </details>
                                    }
                                </td>
                                <td>
                                    @(item.WorkspaceName ?? "")
                                    @if (item.PropertyAddress is { } address)
                                    {
                                        <br /><a href="@($"/properties/{item.PropertyId}")">@address</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>
    }
</section>

<section class="admin-video-chat" aria-labelledby="video-chat-heading">
    <MudText Typo="Typo.h5" HtmlTag="h2" id="video-chat-heading" Class="mt-8 mb-1">Video chat change requests</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        What users typed in the chat beside a campaign video, what the AI answered, the changes it proposed, whether they were rendered and whether the user said the new video fixed it. Use these to decide which adjustments should become permanent campaign features. Last 90 days, newest first.
    </MudText>
    @if (chatRequests is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (chatRequests.Count == 0)
    {
        <MudText Typo="Typo.body2">No video chat requests yet.</MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2">
            @chatRequests.Count(item => item.FixConfirmed == true) confirmed fixed ·
            @chatRequests.Count(item => item.FixConfirmed == false) said not fixed ·
            @chatRequests.Count(item => item.FixConfirmed is null && item.Outcome.StartsWith("Rendered", StringComparison.Ordinal)) rendered but not answered
        </MudText>
        <MudPaper Elevation="0" Class="admin-panel">
            <div class="admin-table-wrap">
                <table class="admin-table admin-video-chat-table">
                    <thead><tr><th>Time</th><th>User</th><th>Property</th><th>Video</th><th>Request</th><th>AI reply</th><th>Proposed changes</th><th>Outcome</th><th>Did it fix it?</th></tr></thead>
                    <tbody>
                        @foreach (var item in chatRequests)
                        {
                            <tr>
                                <td>@item.OccurredAtUtc.ToLocalTime().ToString("g")</td>
                                <td>@(item.UserEmail ?? "Unknown")@if (item.WorkspaceName is { } workspace){<br /><span class="mud-text-secondary">@workspace</span>}</td>
                                <td>@(item.PropertyAddress ?? "Unknown")</td>
                                <td>@item.Video<br /><span class="mud-text-secondary">version @item.VideoVersion</span></td>
                                <td class="admin-chat-text">@item.Request</td>
                                <td class="admin-chat-text">@item.AssistantReply</td>
                                <td>
                                    @if (item.ProposedChanges.Count == 0)
                                    {
                                        <span class="mud-text-secondary">None</span>
                                    }
                                    else
                                    {
                                        <ul class="admin-chat-changes">
                                            @foreach (var change in item.ProposedChanges)
                                            {
                                                <li>@change</li>
                                            }
                                        </ul>
                                    }
                                </td>
                                <td>@item.Outcome@if (item.OutcomeDetail is { } detail){<br /><span class="mud-text-secondary">@detail</span>}</td>
                                <td class="admin-chat-text">
                                    @switch (item.FixConfirmed)
                                    {
                                        case true:
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Yes, it worked</MudChip>
                                            break;
                                        case false:
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">No, not fixed</MudChip>
                                            break;
                                        default:
                                            <span class="mud-text-secondary">@(item.Outcome.StartsWith("Rendered", StringComparison.Ordinal) ? "Not answered" : "")</span>
                                            break;
                                    }
                                    @if (item.FixFeedback is { } feedback)
                                    {
                                        <br /><span>“@feedback”</span>
                                    }
                                    @if (item.FixConfirmedAtUtc is { } answeredAt)
                                    {
                                        <br /><span class="mud-text-secondary">@answeredAt.ToLocalTime().ToString("g")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>
    }
</section>

<section class="admin-video-chat" aria-labelledby="help-chat-heading">
    <MudText Typo="Typo.h5" HtmlTag="h2" id="help-chat-heading" Class="mt-8 mb-1">Ask AI help questions</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        What users asked the Ask AI chat available on every page (outside a single video's chat), the page they were on and what the AI answered. Questions the AI couldn't answer point to missing help or features. Last 90 days, newest first.
    </MudText>
    @if (helpQuestions is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (helpQuestions.Count == 0)
    {
        <MudText Typo="Typo.body2">No help questions yet.</MudText>
    }
    else
    {
        <MudPaper Elevation="0" Class="admin-panel">
            <div class="admin-table-wrap">
                <table class="admin-table admin-video-chat-table">
                    <thead><tr><th>Time</th><th>User</th><th>Page</th><th>Question</th><th>AI reply</th></tr></thead>
                    <tbody>
                        @foreach (var item in helpQuestions)
                        {
                            <tr>
                                <td>@item.OccurredAtUtc.ToLocalTime().ToString("g")</td>
                                <td>@(item.UserEmail ?? "Unknown")@if (item.WorkspaceName is { } workspace){<br /><span class="mud-text-secondary">@workspace</span>}</td>
                                <td><code>@(item.PagePath ?? "")</code>@if (item.PropertyAddress is { } address){<br /><span class="mud-text-secondary">@address</span>}</td>
                                <td class="admin-chat-text">@item.Question</td>
                                <td class="admin-chat-text">@item.AssistantReply</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>
    }
</section>

@code {
    private IReadOnlyList<AdminAuditRow>? events;
    private IReadOnlyList<AdminVideoChatRequestRow>? chatRequests;
    private IReadOnlyList<AdminHelpChatQuestionRow>? helpQuestions;
    private IReadOnlyList<AdminProviderErrorRow>? providerErrors;

    protected override async Task OnInitializedAsync()
    {
        var range = AdminDateRange.LastDays(90, TimeProvider);
        events = await DashboardService.GetAuditEventsAsync(range);
        providerErrors = await DashboardService.GetProviderErrorsAsync(range, 300);
        chatRequests = await DashboardService.GetVideoChatRequestsAsync(range, 300);
        helpQuestions = await DashboardService.GetHelpChatQuestionsAsync(range, 300);
    }

    private static string FormatJson(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(
                document.RootElement,
                new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true,
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                });
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }
}
