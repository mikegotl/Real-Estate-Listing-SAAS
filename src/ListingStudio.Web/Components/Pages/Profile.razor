@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAgentPortraitService AgentPortraitService
@inject IAgentProfileService AgentProfileService
@inject IAgentAvatarPreviewService AgentAvatarPreviewService
@inject IAgentAvatarVideoService AgentAvatarVideoService
@inject IPlanFeatureGate PlanFeatureGate

<PageTitle>Agent profile</PageTitle>

<section class="page-heading">
    <div>
        <span class="eyebrow">ACCOUNT</span>
        <MudText Typo="Typo.h3" HtmlTag="h1">Agent profile</MudText>
        <MudText Typo="Typo.body1">Manage the identity and headshot used in your campaign branding.</MudText>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(error))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}
@if (!string.IsNullOrWhiteSpace(success))
{
    <MudAlert Severity="Severity.Success" Class="mb-4">@success</MudAlert>
}

<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Class="content-card pa-6 h-100">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">SIGNED IN AS</MudText>
            <MudText Typo="Typo.h5" Class="mt-1">@email</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                Your profile photo is private to your account. Other members of your organization cannot select or download it.
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudPaper Elevation="0" Class="content-card pa-6">
            <MudText Typo="Typo.h5" HtmlTag="h2">Campaign headshot</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Upload a clear photo of yourself. JPEG, PNG, and WebP files up to 10 MB are supported.
            </MudText>

            <InputFile OnChange="UploadAsync" accept="image/jpeg,image/png,image/webp" disabled="@busy" />

            @if (portrait is not null)
            {
                <MudDivider Class="my-5" />
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="5">
                        <div class="agent-crop-preview @CropShapeClass" aria-label="Headshot crop preview">
                            <img src="@PortraitUrl" alt="Current agent headshot"
                                 style="@PreviewStyle" />
                        </div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                            @portrait.OriginalFilename · @portrait.Width × @portrait.Height
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="7">
                        <MudText Typo="Typo.subtitle2">Manual crop</MudText>
                        <MudSelect T="AgentPortraitCropShape" Label="Crop shape" @bind-Value="cropShape"
                                   Variant="Variant.Outlined" Disabled="busy" Class="mt-2">
                            <MudSelectItem Value="AgentPortraitCropShape.Square">Square profile photo</MudSelectItem>
                            <MudSelectItem Value="AgentPortraitCropShape.PortraitFourByFive">Portrait 4:5</MudSelectItem>
                        </MudSelect>
                        <MudText Typo="Typo.caption" Class="d-block mt-3">Zoom</MudText>
                        <MudSlider T="double" @bind-Value="cropZoom" Min="1" Max="4" Step="0.05" Disabled="busy" />
                        <MudText Typo="Typo.caption" Class="d-block mt-2">Horizontal focus</MudText>
                        <MudSlider T="double" @bind-Value="focusX" Min="0" Max="1" Step="0.01" Disabled="busy" />
                        <MudText Typo="Typo.caption" Class="d-block mt-2">Vertical focus</MudText>
                        <MudSlider T="double" @bind-Value="focusY" Min="0" Max="1" Step="0.01" Disabled="busy" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Crop"
                                   Disabled="busy" OnClick="SaveCropAsync" Class="mt-2">
                            Save crop
                        </MudButton>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-5" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh"
                               Disabled="@(busy || !AgentPortraitService.IsAiFixEnabled)" OnClick="AiFixAsync">
                        AI Fix
                    </MudButton>
                    @if (busy)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                    AI Fix corrects lighting, color, background distractions, noise, and sharpness while instructing the provider to preserve your identity, clothing, pose, and age.
                </MudText>
                @if (!AgentPortraitService.IsAiFixEnabled)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        AI Fix is visible but unavailable until the workspace owner enables the approved image-edit provider.
                    </MudAlert>
                }

                <MudDivider Class="my-5" />
                <div class="@(planIncludesPresenter ? null : "is-plan-locked")">
                <div class="plan-unlock-row">
                    <MudText Typo="Typo.h6" HtmlTag="h3">AI agent presenter (avatar)</MudText>
                    @if (!planIncludesPresenter)
                    {
                        <PlanUnlock Feature="AI agent presenter (avatar)" />
                    }
                </div>
                @if (!planIncludesPresenter)
                {
                    <MudText Typo="Typo.body2" Class="plan-upgrade-note mb-2" data-testid="presenter-plan-note">
                        Included with Professional and Enterprise. On your plan, campaigns show this photo on the closing card instead.
                    </MudText>
                }
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                    Use this approved headshot during the opening and closing of new campaign videos while the disclosed AI voice narrates.
                </MudText>
                <MudCheckBox T="bool"
                             Value="includeAvatarInCampaigns"
                             ValueChanged="SetAvatarDefaultAsync"
                             Disabled="@(busy || !planIncludesPresenter)"
                             Color="Color.Primary"
                             Label="Include my agent presenter in new campaign videos by default. I confirm this is my photo and consent to this use." />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    @if (AgentAvatarVideoService.IsEnabled)
                    {
                        <span>New campaigns use short, lip-synced opening and closing clips generated from this approved photo and the selected AI narration. The campaign keeps a static-photo fallback if the provider is unavailable.</span>
                    }
                    else
                    {
                        <span>Lip-sync is not enabled in this environment, so campaigns safely use the existing static-photo presenter. You can still change it for an individual campaign.</span>
                    }
                </MudAlert>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayCircle"
                           Disabled="@(busy || !planIncludesPresenter)"
                           OnClick="PrepareAvatarPreviewAsync"
                           Class="mt-3">
                    Preview presenter
                </MudButton>
                @if (preparingAvatarPreview && AgentAvatarVideoService.IsEnabled)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                        Making your talking preview. This usually takes a minute or two.
                    </MudText>
                }
                @if (avatarPreviewReady)
                {
                    <MudPaper Outlined="true" Class="pa-3 mt-3 avatar-preview-window">
                        <MudText Typo="Typo.subtitle2">Presenter preview</MudText>
                        @if (avatarPreviewLipSynced)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                                Your presenter saying a short greeting, lip-synced from this photo. Campaign videos use the same treatment with each video's own narration.
                            </MudText>
                            <video @key="@($"{portrait.Id}-talking")"
                                   src="@AvatarPreviewUrl"
                                   controls
                                   autoplay
                                   playsinline
                                   style="width:100%;max-height:560px;border-radius:12px;background:#0d1b2a;"
                                   aria-label="Your agent presenter saying a short greeting"></video>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                                @(AgentAvatarVideoService.IsEnabled
                                    ? "Silent layout preview of where your photo appears."
                                    : "Silent layout preview. Lip-sync is not enabled in this environment, so campaigns use this still-photo presenter.")
                            </MudText>
                            <video @key="portrait.Id"
                                   src="@AvatarPreviewUrl"
                                   controls
                                   autoplay
                                   muted
                                   loop
                                   playsinline
                                   style="width:100%;max-height:560px;border-radius:12px;background:#0d1b2a;"
                                   aria-label="Preview the agent presenter in a campaign video"></video>
                        }
                    </MudPaper>
                }
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

<style>
    .agent-crop-preview {
        width: min(100%, 300px);
        overflow: hidden;
        border-radius: 18px;
        background: #eee9e1;
        border: 1px solid var(--mud-palette-divider);
    }
    .agent-crop-preview.square { aspect-ratio: 1 / 1; }
    .agent-crop-preview.portrait { aspect-ratio: 4 / 5; }
    .agent-crop-preview img { width: 100%; height: 100%; object-fit: cover; transform-origin: center; }
    .avatar-preview-window { max-width: 430px; background: #f7f4ef; }
</style>

@code {
    private AgentPortraitItem? portrait;
    private string email = "Loading…";
    private string? error;
    private string? success;
    private bool busy;
    private double cropZoom = 1;
    private double focusX = 0.5;
    private double focusY = 0.5;
    private AgentPortraitCropShape cropShape = AgentPortraitCropShape.Square;
    private bool includeAvatarInCampaigns;
    private bool planIncludesPresenter = true;
    private bool avatarPreviewReady;
    private bool avatarPreviewLipSynced;
    private bool preparingAvatarPreview;

    private string PortraitUrl => portrait is null ? string.Empty : $"/agent-portraits/{portrait.Id}?v={portrait.UpdatedAtUtc.ToUnixTimeMilliseconds()}";
    private string CropShapeClass => cropShape == AgentPortraitCropShape.Square ? "square" : "portrait";
    private string AvatarPreviewUrl => portrait is null
        ? string.Empty
        : $"/agent-portraits/{portrait.Id}/avatar-preview?v={portrait.UpdatedAtUtc.ToUnixTimeMilliseconds()}{(avatarPreviewLipSynced ? "&talking=1" : string.Empty)}";
    private string PreviewStyle => FormattableString.Invariant(
        $"object-position:{focusX * 100:0}% {focusY * 100:0}%;transform:scale({cropZoom:0.00});");

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        email = state.User.Identity?.Name ?? "Agent";
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        portrait = await AgentPortraitService.GetLatestAsync(userId);
        includeAvatarInCampaigns = (await AgentProfileService.GetAsync(userId)).IncludeAvatarInCampaigns;
        planIncludesPresenter = (await PlanFeatureGate.GetAccessAsync(userId)).IncludesPremiumAi;
    }

    private async Task UploadAsync(InputFileChangeEventArgs args) => await RunAsync(async userId =>
    {
        var file = args.File;
        await using var stream = file.OpenReadStream(IAgentPortraitService.MaximumFileSize);
        portrait = await AgentPortraitService.UploadAsync(
            userId,
            new AgentPortraitUpload(file.Name, file.ContentType, file.Size, stream));
        ResetCrop();
        avatarPreviewReady = false;
        avatarPreviewLipSynced = false;
        success = "Headshot uploaded. You can now crop it, run AI Fix, or select it in a campaign.";
    });

    private async Task SaveCropAsync() => await RunAsync(async userId =>
    {
        if (portrait is null)
        {
            return;
        }

        portrait = await AgentPortraitService.CropAsync(
            userId,
            portrait.Id,
            new AgentPortraitCrop((decimal)focusX, (decimal)focusY, (decimal)cropZoom, cropShape))
            ?? throw new InvalidOperationException("The headshot is no longer available.");
        ResetCrop();
        avatarPreviewReady = false;
        avatarPreviewLipSynced = false;
        success = "The manual crop is saved and will be used by new campaigns.";
    });

    private async Task AiFixAsync() => await RunAsync(async userId =>
    {
        if (portrait is null)
        {
            return;
        }

        portrait = await AgentPortraitService.AiFixAsync(userId, portrait.Id)
            ?? throw new InvalidOperationException("The headshot is no longer available.");
        ResetCrop();
        avatarPreviewReady = false;
        avatarPreviewLipSynced = false;
        success = "AI Fix completed. Review the result before using it in a campaign.";
    });

    private async Task SetAvatarDefaultAsync(bool value) => await RunAsync(async userId =>
    {
        includeAvatarInCampaigns = (await AgentProfileService.SetAvatarDefaultAsync(userId, value))
            .IncludeAvatarInCampaigns;
        success = includeAvatarInCampaigns
            ? "Your agent presenter will be selected by default for new campaigns."
            : "Your agent presenter will no longer be selected automatically for new campaigns.";
    });

    private async Task PrepareAvatarPreviewAsync() => await RunAsync(async userId =>
    {
        if (portrait is null)
        {
            throw new InvalidOperationException("The headshot is no longer available.");
        }

        preparingAvatarPreview = true;
        try
        {
            var preview = await AgentAvatarPreviewService.PrepareAsync(userId, portrait.Id)
                ?? throw new InvalidOperationException("The headshot is no longer available.");
            avatarPreviewReady = true;
            avatarPreviewLipSynced = preview.LipSynced;
            if (preview.FallbackReason is null)
            {
                success = "Presenter preview is ready.";
            }
            else
            {
                error = preview.FallbackReason;
            }
        }
        finally
        {
            preparingAvatarPreview = false;
        }
    });

    private async Task RunAsync(Func<string, Task> action)
    {
        busy = true;
        error = null;
        success = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            await action(userId);
        }
        catch (Exception exception) when (exception is InvalidOperationException or InvalidDataException or IOException)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void ResetCrop()
    {
        cropZoom = 1;
        focusX = 0.5;
        focusY = 0.5;
    }
}
