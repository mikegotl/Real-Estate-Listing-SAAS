@page "/properties/{PropertyId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits OwningComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>@(property is null ? "Property details" : property.Address1)</PageTitle>

<PropertyPageProviders />

@if (!loaded)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (property is null)
{
    <MudAlert Severity="Severity.Warning">Property not found or unavailable to your organization.</MudAlert>
    <MudButton Href="/properties" Variant="Variant.Text" Class="mt-4">Back to properties</MudButton>
}
else
{
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/properties">Properties</a>
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
        <span aria-current="page">@property.Address1</span>
    </nav>

    <section class="property-hero @(coverMediaId is null ? "no-cover" : null)"
             style="@(coverMediaId is null ? null : $"background-image: url('/property-media/{coverMediaId}')")">
        <div class="property-hero-top">
            <MudChip T="string" Size="Size.Small" Class="hero-status">
                @(property.IsArchived ? "Archived" : Display(property.ListingStatus))
            </MudChip>
            <div class="property-hero-actions">
                @if (!property.IsArchived)
                {
                    <MudButton Href="@($"/properties/{PropertyId}/edit")" Variant="Variant.Filled" Class="cta-on-night"
                               StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                    <MudButton Variant="Variant.Text" Class="hero-text-button" OnClick="ArchiveAsync"
                               StartIcon="@Icons.Material.Filled.Archive">Archive</MudButton>
                }
            </div>
        </div>
        @if (coverMediaId is null)
        {
            <div class="property-hero-empty">
                <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" />
                <span>Your first listing photo becomes the cover image</span>
            </div>
        }
        <div class="property-hero-copy">
            <span class="hero-price">@property.ListingPrice.ToString("C0")</span>
            <MudText Typo="Typo.h3" HtmlTag="h1">@property.Address1</MudText>
            <span class="hero-locality">
                @(string.IsNullOrWhiteSpace(property.Address2) ? null : $"{property.Address2} · ")@property.City, @property.State @property.ZipCode
            </span>
        </div>
    </section>

    <dl class="fact-strip">
        <div><dt>Bedrooms</dt><dd>@property.Bedrooms</dd></div>
        <div><dt>Bathrooms</dt><dd>@property.Bathrooms.ToString("0.#")</dd></div>
        <div><dt>Square feet</dt><dd>@(property.SquareFeet?.ToString("N0") ?? "—")</dd></div>
        <div><dt>Lot size</dt><dd>@(property.LotSize is null ? "—" : $"{property.LotSize:0.##} ac")</dd></div>
        <div><dt>Year built</dt><dd>@(property.YearBuilt?.ToString() ?? "—")</dd></div>
        <div><dt>Type</dt><dd>@Display(property.PropertyType)</dd></div>
    </dl>

    @if (nextStep is not null)
    {
        <section class="next-step" aria-live="polite">
            <span class="next-step-icon"><MudIcon Icon="@Icons.Material.Filled.Flag" /></span>
            <div>
                <span class="eyebrow">Next step</span>
                <strong>@nextStep.Title</strong>
                <p>@nextStep.Description</p>
            </div>
            @if (nextStep.Tab is { } tab && nextStep.ActionLabel is not null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ShowTabAsync(tab))"
                           EndIcon="@Icons.Material.Filled.ArrowForward">@nextStep.ActionLabel</MudButton>
            }
        </section>
    }

    <MudTabs @bind-ActivePanelIndex="activeTab" @bind-ActivePanelIndex:after="RefreshSummaryAsync"
             KeepPanelsAlive="true" Elevation="0" ApplyEffectsToContainer="true"
             Class="property-tabs" TabPanelsClass="property-tab-panels">
        <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Info">
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3">About this property</MudText>
                <MudText Typo="Typo.body1" Class="property-description">
                    @(string.IsNullOrWhiteSpace(property.Description) ? "No description yet. Add one from Edit so generated marketing can draw on it." : property.Description)
                </MudText>
                <MudDivider Class="my-6" />
                <MudGrid Spacing="3">
                    <MudItem xs="6" md="3"><Detail Label="Listing price" Value="@property.ListingPrice.ToString("C0")" /></MudItem>
                    <MudItem xs="6" md="3"><Detail Label="Status" Value="@Display(property.ListingStatus)" /></MudItem>
                    <MudItem xs="6" md="3"><Detail Label="Property type" Value="@Display(property.PropertyType)" /></MudItem>
                    <MudItem xs="6" md="3"><Detail Label="Address line 2" Value="@(property.Address2 ?? "—")" /></MudItem>
                </MudGrid>
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="Media" Icon="@Icons.Material.Filled.PhotoLibrary" BadgeData="@(photoCount > 0 ? photoCount : null)" BadgeColor="Color.Secondary">
            <PropertyMediaManager PropertyId="PropertyId" IsReadOnly="property.IsArchived" MediaChanged="RefreshSummaryAsync" />
            <PropertyVideoManager PropertyId="PropertyId" IsReadOnly="property.IsArchived" />
        </MudTabPanel>
        <MudTabPanel Text="Neighborhood" Icon="@Icons.Material.Filled.Map">
            <NeighborhoodInsightsManager PropertyId="PropertyId" IsReadOnly="property.IsArchived" />
        </MudTabPanel>
        <MudTabPanel Text="Story & script" Icon="@Icons.Material.Filled.AutoStories">
            <PropertyStoryManager PropertyId="PropertyId" IsReadOnly="property.IsArchived" />
            <PropertyNarrationScriptManager PropertyId="PropertyId" IsReadOnly="property.IsArchived" />
        </MudTabPanel>
        <MudTabPanel Text="Campaign" Icon="@Icons.Material.Filled.MovieCreation">
            <CampaignGenerationManager PropertyId="PropertyId" IsReadOnly="property.IsArchived" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public Guid PropertyId { get; set; }

    // Lets property cards and the workspace link straight to the tab a next step points at, such as ?tab=media.
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private PropertyDetailsResult? property;
    private bool loaded;
    private int activeTab;
    private int photoCount;
    private Guid? coverMediaId;
    private PropertyNextStep? nextStep;

    private IPropertyService PropertyService => ScopedServices.GetRequiredService<IPropertyService>();

    protected override void OnInitialized()
    {
        if (Enum.TryParse<PropertyDetailsTab>(Tab, ignoreCase: true, out var tab) && Enum.IsDefined(tab))
        {
            activeTab = (int)tab;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        property = await PropertyService.GetAsync(userId, PropertyId);
        if (property is not null)
        {
            await LoadSummaryAsync(userId);
        }

        loaded = true;
    }

    private async Task RefreshSummaryAsync()
    {
        if (property is null)
        {
            return;
        }

        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        await LoadSummaryAsync(userId);
    }

    private async Task LoadSummaryAsync(string userId)
    {
        var media = await ScopedServices.GetRequiredService<IPropertyMediaService>().ListAsync(userId, PropertyId);
        var campaign = await ScopedServices.GetRequiredService<ICampaignGenerationService>().GetLatestAsync(userId, PropertyId);
        photoCount = media.Count;
        coverMediaId = media.OrderBy(item => item.DisplayOrder).Select(item => (Guid?)item.Id).FirstOrDefault();
        nextStep = PropertyNextSteps.Determine(
            property!.IsArchived,
            media.Count,
            media.Count(item => item.AnalysisStatus == PropertyMediaAnalysisStatus.Failed),
            campaign?.Status);
    }

    private async Task ShowTabAsync(PropertyDetailsTab tab)
    {
        activeTab = (int)tab;
        await RefreshSummaryAsync();
    }

    private async Task ArchiveAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Archive this property?",
            "Archived properties and their media become read-only and are hidden from the default property list.",
            yesText: "Archive",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        if (await PropertyService.ArchiveAsync(userId, PropertyId))
        {
            Navigation.NavigateTo("/properties");
        }
        else
        {
            property = null;
        }
    }

    private static string Display(Enum value) => value switch
    {
        PropertyType.SingleFamily => "Single family",
        PropertyType.MultiFamily => "Multi-family",
        ListingStatus.ComingSoon => "Coming soon",
        ListingStatus.OffMarket => "Off market",
        _ => value.ToString(),
    };
}
