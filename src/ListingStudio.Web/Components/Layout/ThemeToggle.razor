@* Dark mode switch. Works on static pages too: theme.js handles the click and keeps aria-checked in sync. *@
<button type="button" class="theme-toggle" role="switch" aria-checked="false" aria-label="Dark mode"
        title="Switch to dark mode" data-theme-toggle>
    <MudIcon Icon="@Icons.Material.Outlined.DarkMode" Size="Size.Small" Class="theme-toggle-moon" />
    <MudIcon Icon="@Icons.Material.Outlined.LightMode" Size="Size.Small" Class="theme-toggle-sun" />
</button>
