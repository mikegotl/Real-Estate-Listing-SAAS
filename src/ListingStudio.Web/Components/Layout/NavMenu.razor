<nav class="nav-shell" aria-label="Primary navigation">
    <a class="brand-link" href="/" aria-label="Creative Listing Studio home">
        <span class="brand-mark"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /></span>
        <span class="brand-copy">
            <strong>Creative Listing Studio</strong>
            <small>Real estate marketing</small>
        </span>
    </a>

    <AuthorizeView>
        <Authorized Context="auth">
            <div class="nav-links">
                <MudButton Href="/auth" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Dashboard">Workspace</MudButton>
                <MudButton Href="/properties" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.HomeWork">Properties</MudButton>
                <MudButton Href="/leads" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.PersonSearch">Leads</MudButton>
                <MudButton Href="/billing" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.CreditCard">Billing</MudButton>
                <MudButton Href="/profile" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.AccountCircle">Profile</MudButton>
                <MudButton Href="/articles" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Article">Articles</MudButton>
                <AuthorizeView Policy="@PlatformAdministration.Policy">
                    <MudButton Href="/admin" Variant="Variant.Text" Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.AdminPanelSettings">Admin</MudButton>
                </AuthorizeView>
            </div>
            <div class="account-actions">
                <CommentsButton @rendermode="InteractiveServer" />
                <NotificationBell @rendermode="InteractiveServer" />
                <span class="user-pill">
                    <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" />
                    <span>@auth.User.Identity?.Name</span>
                </span>
                <form action="/Account/Logout" method="post">
                    <AntiforgeryToken />
                    <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout"
                                   Color="Color.Inherit" aria-label="Log out" />
                </form>
                <details class="mobile-nav">
                    <summary aria-label="Open navigation menu">
                        <MudIcon Icon="@Icons.Material.Filled.Menu" />
                    </summary>
                    <div class="mobile-nav-panel">
                        <a href="/auth"><MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /> Workspace</a>
                        <a href="/properties"><MudIcon Icon="@Icons.Material.Filled.HomeWork" Size="Size.Small" /> Properties</a>
                        <a href="/leads"><MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Small" /> Leads</a>
                        <a href="/billing"><MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" /> Billing</a>
                        <a href="/profile"><MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" /> Profile</a>
                        <a href="/articles"><MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" /> Articles</a>
                        <AuthorizeView Policy="@PlatformAdministration.Policy">
                            <a href="/admin"><MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" /> Admin</a>
                        </AuthorizeView>
                    </div>
                </details>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="guest-actions">
                <MudButton Href="/articles" Variant="Variant.Text" Color="Color.Inherit" Class="nav-articles"
                           StartIcon="@Icons.Material.Filled.Article">Articles</MudButton>
                <MudButton Href="/Account/Login" Variant="Variant.Text" Color="Color.Inherit">Log in</MudButton>
                <MudButton Href="/Account/Register" Variant="Variant.Filled" Color="Color.Primary"
                           Class="nav-cta cta-on-night">Get started</MudButton>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>
