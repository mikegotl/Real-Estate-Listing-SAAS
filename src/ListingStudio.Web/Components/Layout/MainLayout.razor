@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme" />
@* The dark palette is always sent; CSS applies it only when dark mode is on (see theme.js and App.razor). *@
<DarkThemeVariables Theme="Theme" IsDarkMode="true" ObserveSystemDarkModeChange="false" DefaultScrollbar="true" />

<MudLayout Class="app-shell">
    <MudAppBar Elevation="0" Class="app-header">
        <NavMenu />
    </MudAppBar>
    <MudMainContent Class="app-content">
        <ImpersonationBanner />
        <MudContainer MaxWidth="MaxWidth.Large" Class="page-container">
            @Body
        </MudContainer>
        <footer class="site-footer">
            <span>Creative Listing Studio · Listing videos and campaigns for real estate agents</span>
            <nav aria-label="Site">
                <a href="/">Home</a>
                <a href="/articles">Articles</a>
                <a href="/privacy">Privacy</a>
                <AuthorizeView>
                    <NotAuthorized>
                        <a href="/Account/Register">Create an account</a>
                        <a href="/Account/Login">Log in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </nav>
        </footer>
    </MudMainContent>
    <AuthorizeView>
        <Authorized>
            <HelpChatWindow @rendermode="InteractiveServer" />
        </Authorized>
    </AuthorizeView>
</MudLayout>

@code {
    private static readonly string[] BodyFont = ["Inter Variable", "Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"];
    private static readonly string[] DisplayFont = ["Fraunces Variable", "Georgia", "Cambria", "Times New Roman", "serif"];

    // Creative Listing Studio brand: harbor navy for actions, brass for accents, warm paper backgrounds.
    // app.css reads these values through the --mud-palette-* variables, so this is the single source of colour.
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1F4B6E",
            Secondary = "#9A6A2A",
            Tertiary = "#4F7A65",
            Info = "#2D6A9F",
            Success = "#2F7D4F",
            Warning = "#B7791F",
            Error = "#B42318",
            Dark = "#0E1B2B",
            Background = "#F7F5F1",
            Surface = "#FFFFFF",
            AppbarBackground = "#0E1B2B",
            AppbarText = "#F5F1EA",
            TextPrimary = "#1B2430",
            TextSecondary = "#5B6573",
            Divider = "#E6E1D8",
            TableLines = "#ECE8E1",
            LinesDefault = "#E6E1D8",
        },
        // Dark mode keeps the harbor navy shell and brass accents but moves pages onto deep navy paper,
        // with lighter tints of the brand colours so text and buttons keep their contrast.
        PaletteDark = new PaletteDark
        {
            Primary = "#8DB8DD",
            PrimaryContrastText = "#0B1622",
            Secondary = "#D9AE6E",
            SecondaryContrastText = "#1A1206",
            Tertiary = "#8FBBA4",
            TertiaryContrastText = "#0B1622",
            Info = "#86B9E6",
            Success = "#6FC392",
            Warning = "#E5AE52",
            Error = "#F2877C",
            Dark = "#08111B",
            Black = "#05090F",
            Background = "#0D1824",
            BackgroundGray = "#132131",
            Surface = "#142231",
            DrawerBackground = "#142231",
            DrawerText = "#ECE6DC",
            AppbarBackground = "#08111B",
            AppbarText = "#F5F1EA",
            TextPrimary = "#ECE6DC",
            TextSecondary = "#A8B3C0",
            TextDisabled = "rgba(236, 230, 220, .38)",
            ActionDefault = "#B8C2CD",
            ActionDisabled = "rgba(236, 230, 220, .26)",
            ActionDisabledBackground = "rgba(236, 230, 220, .12)",
            Divider = "#26384B",
            DividerLight = "#1E2E3F",
            TableLines = "#22344A",
            TableStriped = "rgba(255, 255, 255, .03)",
            TableHover = "rgba(255, 255, 255, .05)",
            LinesDefault = "#26384B",
            LinesInputs = "#4A5D72",
            OverlayDark = "rgba(2, 6, 12, .6)",
            Skeleton = "rgba(255, 255, 255, .08)",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = BodyFont, LetterSpacing = "normal" },
            H1 = new H1Typography { FontFamily = DisplayFont, FontWeight = "600", LetterSpacing = "-.02em" },
            H2 = new H2Typography { FontFamily = DisplayFont, FontWeight = "600", LetterSpacing = "-.02em" },
            H3 = new H3Typography { FontFamily = DisplayFont, FontWeight = "600", LetterSpacing = "-.015em" },
            H4 = new H4Typography { FontFamily = DisplayFont, FontWeight = "600", LetterSpacing = "-.01em" },
            H5 = new H5Typography { FontFamily = BodyFont, FontWeight = "650", LetterSpacing = "-.01em" },
            H6 = new H6Typography { FontFamily = BodyFont, FontWeight = "600" },
            Subtitle1 = new Subtitle1Typography { FontFamily = BodyFont },
            Subtitle2 = new Subtitle2Typography { FontFamily = BodyFont },
            Body1 = new Body1Typography { FontFamily = BodyFont },
            Body2 = new Body2Typography { FontFamily = BodyFont },
            Caption = new CaptionTypography { FontFamily = BodyFont },
            Overline = new OverlineTypography { FontFamily = BodyFont, FontWeight = "700", LetterSpacing = ".08em" },
            Button = new ButtonTypography { FontFamily = BodyFont, FontWeight = "600", TextTransform = "none", LetterSpacing = "normal" },
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",
        },
    };
}
