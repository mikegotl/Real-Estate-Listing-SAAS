@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password reset</PageTitle>

<div class="state-page">
    <span class="state-icon success"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" /></span>
    <MudText Typo="Typo.h3" HtmlTag="h1">Password reset</MudText>
    <MudText Typo="Typo.body1">Your new password is ready to use.</MudText>
    <MudButton Href="/Account/Login" Variant="Variant.Filled" Color="Color.Primary">Log in</MudButton>
</div>
