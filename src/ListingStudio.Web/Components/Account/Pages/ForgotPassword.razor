@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using ListingStudio.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Forgot password</PageTitle>

<h1>Forgot your password?</h1>
<p>Enter your email to create a password-reset link.</p>

<EditForm Model="Input" method="post" OnValidSubmit="SendResetLinkAsync" FormName="forgot-password" class="account-form">
    <DataAnnotationsValidator />
    <ValidationSummary class="error" />
    <label>
        Email
        <InputText @bind-Value="Input.Email" autocomplete="username" />
        <ValidationMessage For="() => Input.Email" />
    </label>
    <button type="submit">Reset password</button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task SendResetLinkAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is not null)
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var encodedToken = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = encodedToken });

            await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, callbackUrl);
        }

        RedirectManager.RedirectTo(
            "Account/ForgotPasswordConfirmation",
            new Dictionary<string, object?> { ["email"] = Input.Email });
    }

    private sealed class InputModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
