@page "/Account/ForgotPasswordConfirmation"

@inject IHostEnvironment Environment
@inject DevelopmentEmailStore EmailStore

<PageTitle>Password reset requested</PageTitle>

<div class="state-page">
    <span class="state-icon success"><MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Large" /></span>
    <MudText Typo="Typo.h3" HtmlTag="h1">Check your email</MudText>
    <MudText Typo="Typo.body1">If the account exists, a password-reset link has been created.</MudText>
    @if (Environment.IsDevelopment() && EmailStore.TryGetPasswordResetLink(Email, out var link))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Local development email: <a href="@link">reset your password</a>.
        </MudAlert>
    }
    <MudButton Href="/Account/Login" Variant="Variant.Filled" Color="Color.Primary">Return to login</MudButton>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Email { get; set; } = string.Empty;
}
