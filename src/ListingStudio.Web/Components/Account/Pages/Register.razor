@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using ListingStudio.Application.Authentication
@using ListingStudio.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity

@inject IAccountRegistrationService RegistrationService
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Register</PageTitle>

<AccountPanel Title="Create your workspace" Eyebrow="GET STARTED"
              Description="Your first account becomes the owner of a new organization."
              Icon="@Icons.Material.Filled.RocketLaunch">
    <StatusMessage Message="@message" />

    <EditForm Model="Input" method="post" OnValidSubmit="RegisterUserAsync" FormName="register" class="account-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />
        <div class="ls-field">
            <label for="register-organization">Organization name</label>
            <div class="ls-input-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                <InputText id="register-organization" class="ls-input" @bind-Value="Input.OrganizationName" autocomplete="organization" placeholder="Northstar Realty" />
            </div>
            <ValidationMessage For="() => Input.OrganizationName" />
        </div>
        <div class="ls-field">
            <label for="register-email">Email address</label>
            <div class="ls-input-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                <InputText id="register-email" class="ls-input" @bind-Value="Input.Email" autocomplete="username" placeholder="you@agency.com" />
            </div>
            <ValidationMessage For="() => Input.Email" />
        </div>
        <div class="form-columns">
            <div class="ls-field">
                <label for="register-password">Password</label>
                <div class="ls-input-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" />
                    <InputText id="register-password" class="ls-input" type="password" @bind-Value="Input.Password" autocomplete="new-password" placeholder="8+ characters" />
                </div>
                <ValidationMessage For="() => Input.Password" />
            </div>
            <div class="ls-field">
                <label for="register-confirm-password">Confirm password</label>
                <div class="ls-input-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" />
                    <InputText id="register-confirm-password" class="ls-input" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" placeholder="Repeat password" />
                </div>
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>
        </div>
        <MudButton ButtonType="ButtonType.Submit" FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
            Create workspace
        </MudButton>
    </EditForm>

    <ExternalLoginPicker Label="Or register with" ReturnUrl="@ReturnUrl" />
    <p class="account-footer">Already have an account? <a href="/Account/Login">Log in</a></p>
</AccountPanel>

@code {
    private string? message;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task RegisterUserAsync()
    {
        var result = await RegistrationService.RegisterAsync(
            new RegisterAccountCommand(Input.Email, Input.Password, Input.OrganizationName));

        if (!result.Succeeded)
        {
            message = $"Error: {string.Join(", ", result.Errors)}";
            return;
        }

        var user = await UserManager.FindByIdAsync(result.UserId!);
        if (user is null)
        {
            message = "Error: The new account could not be loaded.";
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    private sealed class InputModel
    {
        [Required, StringLength(200)]
        public string OrganizationName { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required, StringLength(100, MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
