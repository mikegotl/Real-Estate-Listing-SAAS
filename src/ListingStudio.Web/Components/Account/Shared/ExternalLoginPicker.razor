@using ListingStudio.Infrastructure.Identity
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager

@if (schemes.Count > 0)
{
    <section class="external-logins" aria-label="External account sign in">
        <div class="account-divider"><span>@Label</span></div>
        @foreach (var scheme in schemes)
        {
            <form action="/Account/ExternalLogin" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="provider" value="@scheme.Name" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <MudButton ButtonType="ButtonType.Submit" FullWidth="true" Variant="Variant.Outlined"
                           Color="Color.Dark" Size="Size.Large" StartIcon="@ProviderIcon(scheme.Name)">
                    Continue with @(scheme.DisplayName ?? scheme.Name)
                </MudButton>
            </form>
        }
        @if (schemes.Any(IsGoogle))
        {
            <p class="external-login-help">
                Google may block sign-in inside an in-app browser. On iPhone or iPad, open Creative Listing Studio in Safari or Chrome and try again.
            </p>
        }
    </section>
}

@code {
    private IReadOnlyList<AuthenticationScheme> schemes = [];

    [Parameter]
    public string Label { get; set; } = "Or continue with";

    [Parameter]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        schemes = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }

    private static string ProviderIcon(string provider) => provider.Equals("Apple", StringComparison.OrdinalIgnoreCase)
        ? Icons.Material.Filled.PhoneIphone
        : Icons.Material.Filled.AccountCircle;

    private static bool IsGoogle(AuthenticationScheme scheme) =>
        scheme.Name.Equals("Google", StringComparison.OrdinalIgnoreCase);
}
