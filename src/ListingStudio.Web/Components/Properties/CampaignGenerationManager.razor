    private sealed record CreativeElementOption(CampaignVideoElement Element, string Name, string Details);

    private static string TemplateName(CampaignMarketingTemplate template) => template switch
    {
        CampaignMarketingTemplate.BalancedShowcase => "Balanced showcase",
        CampaignMarketingTemplate.PriceDrop => "Price-drop announcement",
        CampaignMarketingTemplate.QuickTour => "Fast social tour",
        CampaignMarketingTemplate.FeatureSpotlight => "Feature spotlight",
        CampaignMarketingTemplate.AgentShowcase => "Agent-branded showcase",
