    private bool IsSelected(CampaignOutputSelection selection) => selectedOutputs.HasFlag(selection);

    private bool SettingsVisible => job is null || job.Status is CampaignGenerationStatus.Completed or CampaignGenerationStatus.Cancelled;

    /// <summary>The recommendation-led workflow: the library is on for the workspace and a vertical video is selected.</summary>
    private bool LibraryMode => libraryEnabled && !IsReadOnly && selectedOutputs.HasFlag(CampaignOutputSelection.TikTok);

    /// <summary>
    /// Every video in the campaign is a Kling 4 native-presenter video: Kling makes the speech and music, so voice,
    /// music, style and walk-through motion settings do nothing and are hidden. Still-image posts use none of them.
    /// </summary>
    private bool KlingOnlyCampaign => selectedVideoStrategy == CampaignVideoStrategy.Kling4NativePresenter
        && LibraryMode
        && KlingVideoSlots.Count > 0
        && LongLibraryVideos.Count == 0
        && (selectedOutputs & ~(CampaignOutputSelection.TikTok | CampaignOutputSelection.FacebookStillPost)) == CampaignOutputSelection.None;

    /// <summary>Eligible videos exist but the agent unticked them all.</summary>
    private bool LibraryNeedsPick => LibraryMode && verticalPicker is { Chosen.Count: 0, Eligible.Count: > 0 };

    private string GenerateLabel => LibraryMode
        ? "Generate high-potential vertical videos"
        : job?.Status == CampaignGenerationStatus.Completed ? "Generate updated campaign" : "Generate campaign";

    private int OtherOutputCount =>
        (IsSelected(CampaignOutputSelection.YouTubeTour) ? 1 : 0)
        + (IsSelected(CampaignOutputSelection.FacebookFeed) ? 1 : 0)
        + (IsSelected(CampaignOutputSelection.FacebookStillPost) ? 2 : 0)
        + (IsSelected(CampaignOutputSelection.FullNarratedTour) ? 1 : 0);

    private bool SilentLibraryVideo => LibraryMode
        && verticalPicker?.IsChosen(VerticalCreativeFormat.WowFeature) == true
        && selectedSoundtrack == CampaignSoundtrack.None;

    private string OptionName(OutputOption option) => LibraryMode && option.Selection == CampaignOutputSelection.TikTok
        ? "Vertical videos for TikTok, Reels and Shorts"
        : option.Name;

    private string OptionDetails(OutputOption option) => libraryEnabled && !IsReadOnly && option.Selection == CampaignOutputSelection.TikTok
        ? "Vertical 1080 × 1920 · the videos this listing supports best, each with its own hook. Post each file to TikTok, Reels or Shorts."
        : option.Details;

    private static string VerticalRequestSummary(CampaignVerticalRequestResult request)
    {
        var how = request.Selection switch
        {
            VerticalVideoSelection.RecommendedThree => "the recommended vertical videos",
            VerticalVideoSelection.AllEligible => "every eligible vertical video",
            VerticalVideoSelection.AgentChosen => string.Join(", ", request.Formats.Select(VerticalFormatNames.Name)),
            _ => "one shared vertical video",
        };
        return request.Goal is { } goal
            ? $"Vertical videos: {how}. Goal: {VerticalFormatNames.Goal(goal)}."
            : $"Vertical videos: {how}.";
    }

