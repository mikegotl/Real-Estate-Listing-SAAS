@inherits OwningComponentBase<ICampaignGenerationService>
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPropertyMediaService MediaService
@inject IPropertyNarrationScriptService NarrationScriptService
@inject IAgentPortraitService AgentPortraitService
@inject ILogger<CampaignGenerationManager> Logger

<MudPaper Class="pa-6 mt-6">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h2">Campaign</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">
                Generate, monitor, and download the complete video campaign.
            </MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.caption">
                Video narration is generated with an AI voice.
            </MudText>
        </div>
        @if (job is null || job.Status is CampaignGenerationStatus.Completed or CampaignGenerationStatus.Cancelled)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(busy || IsReadOnly || selectedOutputs == CampaignOutputSelection.None || !TemplateReady)"
                       OnClick="GenerateAsync">
                @(job?.Status == CampaignGenerationStatus.Completed ? "Generate updated campaign" : "Generate campaign")
            </MudButton>
        }
    </MudStack>

    @if (job is null || job.Status is CampaignGenerationStatus.Completed or CampaignGenerationStatus.Cancelled)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">Choose your deliverables</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Listing Studio creates one verified story and narration, then produces only the formats you select.
                Standard formats count as one successful property campaign.
            </MudText>
            <MudGrid Spacing="2">
                @foreach (var option in OutputOptions)
                {
                    var unavailable = option.Selection == CampaignOutputSelection.FullNarratedTour && !longFormAvailable;
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-3 h-100">
                            <MudCheckBox T="bool"
                                         Value="@IsSelected(option.Selection)"
                                         ValueChanged="@(value => SetSelected(option.Selection, value))"
                                         Disabled="@(busy || IsReadOnly || unavailable)"
                                         Label="@option.Name"
                                         Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @option.Details
                            </MudText>
                            @if (unavailable)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Info">
                                    Accept a narration script longer than @IPropertyNarrationScriptService.ShortFormWordLimit words to enable this format.
                                </MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
            @if (selectedOutputs == CampaignOutputSelection.None)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">
                    Choose at least one output before generating the campaign.
                </MudText>
            }
        </MudPaper>
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">Creative direction</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Start with a marketing template, then customize its verified content, branding, and presentation.
                Each output gets a platform-specific edit instead of a simple crop.
            </MudText>
            <MudSelect T="CampaignMarketingTemplate"
                       Label="Marketing template"
                       Value="selectedMarketingTemplate"
                       ValueChanged="ApplyTemplate"
                       Variant="Variant.Outlined"
                       Disabled="@(busy || IsReadOnly)"
                       Class="mb-2">
                @foreach (var template in Enum.GetValues<CampaignMarketingTemplate>())
                {
                    <MudSelectItem Value="template">@TemplateName(template)</MudSelectItem>
                }
            </MudSelect>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                @TemplateDescription(selectedMarketingTemplate)
            </MudAlert>
            @if (selectedMarketingTemplate == CampaignMarketingTemplate.PriceDrop)
            {
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?"
                                         Label="Price reduction amount"
                                         @bind-Value="selectedPriceReductionAmount"
                                         Min="0.01m"
                                         Max="100000000m"
                                         Format="C0"
                                         Variant="Variant.Outlined"
                                         Disabled="@(busy || IsReadOnly)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool"
                                     @bind-Value="selectedPriceReductionVerified"
                                     Disabled="@(busy || IsReadOnly)"
                                     Label="I confirm this price reduction is accurate and approved for marketing" />
                    </MudItem>
                </MudGrid>
                @if (!TemplateReady)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-3">
                        Enter the reduction amount and confirm it before generating this template.
                    </MudText>
                }
            }
            <MudGrid Spacing="2">
                @foreach (var option in CreativeElementOptions)
                {
                    var unavailable = option.Element == CampaignVideoElement.KitchenIslandOrbit && !kitchenOrbitEligible;
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool"
                                     Value="@IsCreativeElementSelected(option.Element)"
                                     ValueChanged="@(value => SetCreativeElement(option.Element, value))"
                                     Disabled="@(busy || IsReadOnly || unavailable)"
                                     Label="@option.Name" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@option.Details</MudText>
                    </MudItem>
                }
            </MudGrid>
            @if (!kitchenOrbitEligible)
            {
                <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-2">
                    Kitchen island turnaround becomes available after analysis verifies an island and at least three kitchen viewpoints.
                </MudText>
            }
            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignSoundtrack" Label="Soundtrack" @bind-Value="selectedSoundtrack" Variant="Variant.Outlined">
                        <MudSelectItem Value="CampaignSoundtrack.None">No background music</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.AutoByHomeEra">Choose for the home's era</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.HeritageWarm">Heritage warm</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.ModernAmbient">Modern ambient</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.UpbeatLifestyle">Upbeat lifestyle</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignCaptionStyle" Label="Caption look" @bind-Value="selectedCaptionStyle" Variant="Variant.Outlined">
                        <MudSelectItem Value="CampaignCaptionStyle.Pop">Poppy social captions</MudSelectItem>
                        <MudSelectItem Value="CampaignCaptionStyle.Classic">Classic captions</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">Narration and captions</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                Choose the presentation region, spoken language, caption language, and voice accent. Region guides wording and pronunciation; it does not infer anyone's nationality.
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignNarrationRegion" Label="Narration region" @bind-Value="selectedNarrationRegion" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var region in Enum.GetValues<CampaignNarrationRegion>())
                        {
                            <MudSelectItem Value="region">@Display(region)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignLanguage" Label="Spoken language" @bind-Value="selectedSpokenLanguage" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var language in Enum.GetValues<CampaignLanguage>())
                        {
                            <MudSelectItem Value="language">@Display(language)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignLanguage" Label="Caption language" @bind-Value="selectedCaptionLanguage" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var language in Enum.GetValues<CampaignLanguage>())
                        {
                            <MudSelectItem Value="language">@Display(language)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignVoiceAccent" Label="Voice accent" @bind-Value="selectedVoiceAccent" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var accent in Enum.GetValues<CampaignVoiceAccent>())
                        {
                            <MudSelectItem Value="accent">@Display(accent)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                Accent is an AI voice direction and may vary by voice. Listing Studio always discloses that narration is AI-generated.
            </MudAlert>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">Optional agent photo</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                Upload a headshot or full-body photo. It stays private and is used only when “Agent photo on closing card” is checked.
            </MudText>
            <InputFile OnChange="UploadPortraitAsync" accept="image/jpeg,image/png,image/webp" />
            @if (portrait is not null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                    <img src="@($"/agent-portraits/{portrait.Id}")" alt="Agent photo preview" style="width:72px;height:72px;object-fit:cover;border-radius:50%;" />
                    <MudText Typo="Typo.caption">@portrait.OriginalFilename · @portrait.Width × @portrait.Height</MudText>
                </MudStack>
            }
            <MudCheckBox T="bool"
                         @bind-Value="selectedLocalizeAgentCard"
                         Disabled="@(busy || IsReadOnly || !selectedCreativeElements.HasFlag(CampaignVideoElement.AgentPortrait))"
                         Label="Use the selected language and accent during the agent closing card" />
        </MudPaper>
    }
    else if (job.RequestedOutputs != CampaignOutputSelection.LegacyStandard)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
            Creating: @SelectedOutputNames(job.RequestedOutputs)
        </MudText>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
    }

    @if (refreshError is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@refreshError</MudAlert>
    }

    @if (failedAnalysisCount > 0 && job?.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Analysis failed for @failedAnalysisCount @(failedAnalysisCount == 1 ? "photo" : "photos"). Listing Studio is retrying,
            and the campaign will stop if a photo runs out of attempts. See Listing photos for details.
        </MudAlert>
    }

    @if (mediaCount is > 0 and < 3)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Only @mediaCount @(mediaCount == 1 ? "photo is" : "photos are") available. Listing Studio can create a conservative
            fallback plan, but at least three analyzed interior and exterior photos are recommended for a varied video.
        </MudAlert>
    }

    @if (job is null)
    {
        <MudText Typo="Typo.body1">No campaign has been generated yet.</MudText>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudChip T="string" Color="@StatusColor(job.Status)" Variant="Variant.Filled">
                @Display(job.Status)
            </MudChip>
            <MudText Typo="Typo.body2">@Display(job.CurrentStage)</MudText>
        </MudStack>
        <MudProgressLinear Value="job.ProgressPercent" Color="Color.Primary" Class="mb-4" />

        @if (!string.IsNullOrWhiteSpace(job.LastError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@DisplayError(job)</MudAlert>
        }

        <MudList T="CampaignStageResult" Dense="true" Class="mb-4">
            @foreach (var stage in job.Stages)
            {
                <MudListItem T="CampaignStageResult"
                             Icon="@StageIcon(stage.Status)"
                             IconColor="@StageColor(stage.Status)">
                    @Display(stage.Stage)
                    @if (stage.AttemptCount > 1)
                    {
                        <span> · attempt @stage.AttemptCount</span>
                    }
                </MudListItem>
            }
        </MudList>

        @if (job.Deliverables.Count > 0)
        {
            <MudGrid Spacing="2" Class="mb-4">
                @foreach (var deliverable in job.Deliverables)
                {
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.h6">@OutputName(deliverable.Kind)</MudText>
                            <MudText Class="mud-text-secondary" Typo="Typo.body2">
                                @deliverable.DurationSeconds seconds · @deliverable.AspectRatio · @Dimensions(deliverable.AspectRatio)
                            </MudText>
                            @if (deliverable.Status == CampaignDeliverableStatus.Rendered)
                            {
                                <video controls
                                       preload="metadata"
                                       style="width: 100%; margin-top: 1rem; border-radius: 4px;"
                                       aria-label="@($"Preview {deliverable.Kind} video")">
                                    <source src="@PreviewUrl(job.Id, deliverable.Kind)" type="video/mp4" />
                                    Your browser does not support MP4 video playback.
                                </video>
                                <MudButton Href="@DownloadUrl(job.Id, deliverable.Kind)"
                                           Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Class="mt-3">
                                    Download MP4
                                </MudButton>
                            }
                            else
                            {
                                <MudProgressLinear Indeterminate="true" Class="mt-3" />
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (job.Status == CampaignGenerationStatus.Completed)
        {
            <MudText Class="mud-text-secondary" Typo="Typo.overline">Short social caption</MudText>
            <MudText Typo="Typo.body1" Class="mb-3">@job.SocialCaptionShort</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.overline">Long social caption</MudText>
            <MudText Typo="Typo.body1">@job.SocialCaptionLong</MudText>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            @if (job.Status == CampaignGenerationStatus.Failed)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="RetryAsync">
                    Retry failed stage
                </MudButton>
            }
            @if (job.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="busy" OnClick="CancelAsync">
                    Cancel campaign
                </MudButton>
            }
            <MudButton Variant="Variant.Text" Disabled="busy" OnClick="LoadAsync">Refresh</MudButton>
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter]
    public Guid PropertyId { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    /// <summary>Raised when the latest campaign's status changes, so the page can update its next step.</summary>
    [Parameter]
    public EventCallback StatusChanged { get; set; }

    private readonly CancellationTokenSource pollingCancellation = new();
    private CampaignGenerationResult? job;
    private bool busy;
    private bool pollingStarted;
    private string? error;
    private string? refreshError;
    private int mediaCount;
    private int failedAnalysisCount;
    private bool longFormAvailable;
    private bool kitchenOrbitEligible;
    private AgentPortraitItem? portrait;
    private CampaignVideoElement selectedCreativeElements = CampaignCreativeOptions.SocialDefault.Elements;
    private CampaignSoundtrack selectedSoundtrack = CampaignCreativeOptions.SocialDefault.Soundtrack;
    private CampaignCaptionStyle selectedCaptionStyle = CampaignCreativeOptions.SocialDefault.CaptionStyle;
    private CampaignMarketingTemplate selectedMarketingTemplate = CampaignCreativeOptions.SocialDefault.MarketingTemplate;
    private decimal? selectedPriceReductionAmount;
    private bool selectedPriceReductionVerified;
    private CampaignNarrationRegion selectedNarrationRegion = CampaignNarrationPreferences.Default.Region;
    private CampaignLanguage selectedSpokenLanguage = CampaignNarrationPreferences.Default.SpokenLanguage;
    private CampaignLanguage selectedCaptionLanguage = CampaignNarrationPreferences.Default.CaptionLanguage;
    private CampaignVoiceAccent selectedVoiceAccent = CampaignNarrationPreferences.Default.VoiceAccent;
    private bool selectedLocalizeAgentCard = CampaignNarrationPreferences.Default.LocalizeAgentCard;
    private bool selectionInitialized;
    private Guid? loadedPropertyId;
    private CampaignOutputSelection selectedOutputs = CampaignOutputSelectionPolicy.Recommended;
    private bool statusLoaded;
    private CampaignGenerationStatus? reportedStatus;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedPropertyId != PropertyId)
        {
            loadedPropertyId = PropertyId;
            selectionInitialized = false;
            selectedOutputs = CampaignOutputSelectionPolicy.Recommended;
            job = null;
            statusLoaded = false;
            reportedStatus = null;
        }

        await LoadAsync();
        StartPolling();
    }

    private async Task LoadAsync()
    {
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            job = await Service.GetLatestAsync(userId, PropertyId, pollingCancellation.Token);
            var script = await NarrationScriptService.GetAsync(userId, PropertyId, pollingCancellation.Token);
            longFormAvailable = script is { MarketingUseAccepted: true }
                && NarrationScriptPolicy.RequiresLongForm(script.ExtractedText);
            if (!selectionInitialized)
            {
                if (job is not null && job.RequestedOutputs != CampaignOutputSelection.LegacyStandard)
                {
                    selectedOutputs = job.RequestedOutputs;
                }
                if (job is not null)
                {
                    selectedCreativeElements = job.CreativeOptions.Elements;
                    selectedSoundtrack = job.CreativeOptions.Soundtrack;
                    selectedCaptionStyle = job.CreativeOptions.CaptionStyle;
                    selectedMarketingTemplate = job.CreativeOptions.MarketingTemplate;
                    selectedPriceReductionAmount = job.CreativeOptions.PriceReductionAmount;
                    selectedPriceReductionVerified = job.CreativeOptions.PriceReductionVerified;
                    selectedNarrationRegion = job.NarrationPreferences.Region;
                    selectedSpokenLanguage = job.NarrationPreferences.SpokenLanguage;
                    selectedCaptionLanguage = job.NarrationPreferences.CaptionLanguage;
                    selectedVoiceAccent = job.NarrationPreferences.VoiceAccent;
                    selectedLocalizeAgentCard = job.NarrationPreferences.LocalizeAgentCard;
                }

                selectionInitialized = true;
            }
            if (!longFormAvailable)
            {
                selectedOutputs &= ~CampaignOutputSelection.FullNarratedTour;
            }
            var media = (await MediaService.ListAsync(userId, PropertyId, pollingCancellation.Token))
                .Where(item => !item.IsInGallery)
                .ToArray();
            mediaCount = media.Length;
            var kitchenViews = media.Where(item => string.Equals(item.WalkthroughStop, "Kitchen", StringComparison.OrdinalIgnoreCase)
                || item.Analysis?.Category == PropertyMediaCategory.Kitchen).ToArray();
            kitchenOrbitEligible = kitchenViews.Length >= 3
                && kitchenViews.Any(item => item.Analysis?.Description.Contains("island", StringComparison.OrdinalIgnoreCase) == true);
            if (!kitchenOrbitEligible)
            {
                selectedCreativeElements &= ~CampaignVideoElement.KitchenIslandOrbit;
            }
            portrait = await AgentPortraitService.GetLatestAsync(userId, pollingCancellation.Token);
            failedAnalysisCount = media.Count(item => item.AnalysisStatus == PropertyMediaAnalysisStatus.Failed);
            error = null;
            refreshError = null;
            await ReportStatusAsync();
        }
        catch (OperationCanceledException) when (pollingCancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Refreshing campaign status for property {PropertyId} failed", PropertyId);
            refreshError = "Campaign status could not be refreshed. Listing Studio will keep trying.";
        }
    }

    private async Task GenerateAsync() => await MutateAsync(async userId =>
    {
        var elements = selectedCreativeElements;
        if (selectedSoundtrack == CampaignSoundtrack.None)
        {
            elements &= ~CampaignVideoElement.BackgroundMusic;
        }
        else
        {
            elements |= CampaignVideoElement.BackgroundMusic;
        }

        var portraitId = elements.HasFlag(CampaignVideoElement.AgentPortrait) ? portrait?.Id : null;
        job = await Service.EnqueueAsync(
            userId,
            PropertyId,
            selectedOutputs,
            new CampaignCreativeOptions(
                elements,
                selectedSoundtrack,
                selectedCaptionStyle,
                portraitId,
                selectedMarketingTemplate,
                selectedPriceReductionAmount,
                selectedPriceReductionVerified),
            new CampaignNarrationPreferences(
                selectedNarrationRegion,
                selectedSpokenLanguage,
                selectedCaptionLanguage,
                selectedVoiceAccent,
                selectedLocalizeAgentCard));
    });

    private async Task UploadPortraitAsync(InputFileChangeEventArgs args)
    {
        busy = true;
        error = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            var file = args.File;
            await using var stream = file.OpenReadStream(IAgentPortraitService.MaximumFileSize);
            portrait = await AgentPortraitService.UploadAsync(
                userId,
                new AgentPortraitUpload(file.Name, file.ContentType, file.Size, stream));
        }
        catch (Exception exception) when (exception is InvalidOperationException or InvalidDataException or IOException)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RetryAsync() => await MutateAsync(async userId =>
    {
        if (job is not null && await Service.RetryAsync(userId, job.Id))
        {
            job = await Service.GetAsync(userId, job.Id);
        }
    });

    private async Task CancelAsync() => await MutateAsync(async userId =>
    {
        if (job is not null && await Service.CancelAsync(userId, job.Id))
        {
            job = await Service.GetAsync(userId, job.Id);
        }
    });

    private async Task MutateAsync(Func<string, Task> action)
    {
        busy = true;
        error = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            await action(userId);
            if (job is null)
            {
                error = "Property not found or unavailable to your organization.";
            }

            await ReportStatusAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or InvalidDataException)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    // The first load only records the status; later changes tell the page.
    private async Task ReportStatusAsync()
    {
        var status = job?.Status;
        if (statusLoaded && status == reportedStatus)
        {
            return;
        }

        var notify = statusLoaded;
        statusLoaded = true;
        reportedStatus = status;
        if (notify)
        {
            await StatusChanged.InvokeAsync();
        }
    }

    private void StartPolling()
    {
        if (pollingStarted)
        {
            return;
        }

        pollingStarted = true;
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(pollingCancellation.Token))
            {
                if (job?.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadAsync();
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException) when (pollingCancellation.IsCancellationRequested)
        {
        }
    }

    protected override async ValueTask DisposeAsyncCore()
    {
        pollingCancellation.Cancel();
        pollingCancellation.Dispose();
        await base.DisposeAsyncCore();
    }

    private static string DownloadUrl(Guid jobId, CampaignOutputKind kind) =>
        $"/campaigns/{jobId}/deliverables/{kind}?download=true";

    private static string PreviewUrl(Guid jobId, CampaignOutputKind kind) =>
        $"/campaigns/{jobId}/deliverables/{kind}";

    private static string Display(Enum value) => string.Concat(value.ToString().Select((character, index) =>
        index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString()));

    private static readonly OutputOption[] OutputOptions =
    [
        new(CampaignOutputSelection.TikTok, "TikTok", "Vertical 1080 × 1920 · approximately 30 seconds · quick hook, captions, and CTA."),
        new(CampaignOutputSelection.InstagramReel, "Instagram Reel", "Vertical 1080 × 1920 · approximately 30 seconds · Reel-safe framing and captions."),
        new(CampaignOutputSelection.YouTubeShort, "YouTube Short", "Vertical 1080 × 1920 · approximately 30 seconds · concise highlight edit."),
        new(CampaignOutputSelection.YouTubeTour, "YouTube property tour", "Horizontal 1920 × 1080 · approximately 60 seconds · logical walkthrough order."),
        new(CampaignOutputSelection.FacebookFeed, "Facebook Feed", "Horizontal 1920 × 1080 · approximately 30 seconds · feed-ready highlights with the long social caption as post copy."),
        new(CampaignOutputSelection.FullNarratedTour, "Full narrated tour", "Horizontal 1920 × 1080 · duration follows the complete accepted script."),
    ];

    private bool IsSelected(CampaignOutputSelection selection) => selectedOutputs.HasFlag(selection);

    private void SetSelected(CampaignOutputSelection selection, bool selected)
    {
        selectedOutputs = selected
            ? selectedOutputs | selection
            : selectedOutputs & ~selection;
    }

    private bool IsCreativeElementSelected(CampaignVideoElement element) => selectedCreativeElements.HasFlag(element);

    private bool TemplateReady => selectedMarketingTemplate != CampaignMarketingTemplate.PriceDrop
        || selectedPriceReductionAmount is > 0 and <= 100_000_000m
            && selectedPriceReductionVerified;

    private void ApplyTemplate(CampaignMarketingTemplate template)
    {
        selectedMarketingTemplate = template;
        if (template != CampaignMarketingTemplate.PriceDrop)
        {
            selectedPriceReductionAmount = null;
            selectedPriceReductionVerified = false;
        }

        var preset = template == CampaignMarketingTemplate.PriceDrop
            ? CampaignCreativeOptions.SocialDefault with
            {
                MarketingTemplate = template,
                Soundtrack = CampaignSoundtrack.UpbeatLifestyle,
            }
            : CampaignCreativeOptions.ForTemplate(template, portrait?.Id);
        selectedCreativeElements = preset.Elements;
        selectedSoundtrack = preset.Soundtrack;
        selectedCaptionStyle = preset.CaptionStyle;
    }

    private void SetCreativeElement(CampaignVideoElement element, bool selected)
    {
        selectedCreativeElements = selected
            ? selectedCreativeElements | element
            : selectedCreativeElements & ~element;
        if (element == CampaignVideoElement.AgentPortrait && selected && portrait is null)
        {
            selectedCreativeElements &= ~CampaignVideoElement.AgentPortrait;
            error = "Upload an agent photo before adding it to the video.";
        }

        if (element == CampaignVideoElement.KitchenIslandOrbit && selected)
        {
            selectedCreativeElements |= CampaignVideoElement.WalkthroughMotion;
        }
    }

    private static string SelectedOutputNames(CampaignOutputSelection selection) => string.Join(", ",
        OutputOptions.Where(option => selection.HasFlag(option.Selection)).Select(option => option.Name));

