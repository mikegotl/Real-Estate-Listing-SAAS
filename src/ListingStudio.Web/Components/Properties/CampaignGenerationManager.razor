@inherits OwningComponentBase<ICampaignGenerationService>
@using Microsoft.JSInterop
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPropertyMediaService MediaService
@inject IPropertyNarrationScriptService NarrationScriptService
@inject IAgentPortraitService AgentPortraitService
@inject IAgentProfileService AgentProfileService
@inject IAgentAvatarVideoService AgentAvatarVideoService
@inject IPlanFeatureGate PlanFeatureGate
@inject IServiceScopeFactory ScopeFactory
@inject IDialogService DialogService
@inject ILogger<CampaignGenerationManager> Logger
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<MudPaper Class="pa-6 mt-6">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h2">Campaign</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">
                Generate, monitor, and download the complete video campaign.
            </MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.caption">
                Video narration is generated with an AI voice.
            </MudText>
        </div>
        @if (job is null || job.Status is CampaignGenerationStatus.Completed or CampaignGenerationStatus.Cancelled)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(busy || IsReadOnly || selectedOutputs == CampaignOutputSelection.None || !TemplateReady || NoTourPhotos || NoVideoElements || LibraryNeedsPick)"
                       OnClick="GenerateAsync"
                       data-testid="generate-campaign">
                @GenerateLabel
            </MudButton>
        }
    </MudStack>

    @if (job is null || job.Status is CampaignGenerationStatus.Completed or CampaignGenerationStatus.Cancelled)
    {
        @if (selectionInitialized && !IsReadOnly)
        {
            <CampaignSettingsPresetBar @key="PropertyId"
                                       Current="CurrentPresetSettings"
                                       ApplyPreset="ApplySavedSettings"
                                       OnApplied="@(() => { })"
                                       ApplyDefault="@(job is null)"
                                       Disabled="busy" />
        }
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">Choose your deliverables</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Creative Listing Studio creates one verified story and narration, then produces only the formats you select.
                Standard formats count as one successful property campaign.
            </MudText>
            <MudGrid Spacing="2">
                @foreach (var option in OutputOptions)
                {
                    var unavailable = option.Selection == CampaignOutputSelection.FullNarratedTour && !longFormAvailable;
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-3 h-100">
                            <MudCheckBox T="bool"
                                         Value="@IsSelected(option.Selection)"
                                         ValueChanged="@(value => SetSelected(option.Selection, value))"
                                         Disabled="@(busy || IsReadOnly || unavailable)"
                                         Label="@OptionName(option)"
                                         Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @OptionDetails(option)
                            </MudText>
                            @if (unavailable)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Info">
                                    Accept a narration script, or use room-by-room narration, longer than @IPropertyNarrationScriptService.ShortFormWordLimit words to enable this format.
                                </MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
            @if (selectedOutputs == CampaignOutputSelection.None)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">
                    Choose at least one output before generating the campaign.
                </MudText>
            }
            @if (libraryEnabled)
            {
                <ArticleGuideLink Placement="@ArticleLinks.Placements.DeliverableSelector" Class="mt-3" />
            }
        </MudPaper>
        @if (klingFullTourEnabled || klingNativePresenterEnabled)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4" data-testid="video-strategy-picker">
                <MudText Typo="Typo.subtitle1">Tour video strategy</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                    Compare the established CLS edit with separately switchable Kling 4 pilots. Both pilots use only
                    approved Tour Map photos and affect 30-second campaign edits; longer outputs keep the established edit.
                </MudText>
                <MudRadioGroup T="CampaignVideoStrategy" Value="selectedVideoStrategy" ValueChanged="VideoStrategyChanged">
                    <MudRadio Value="CampaignVideoStrategy.Established" Color="Color.Primary">
                        Established CLS edit (control)
                    </MudRadio>
                    @if (klingFullTourEnabled)
                    {
                        <MudRadio Value="CampaignVideoStrategy.Kling4FullTour" Color="Color.Primary">
                            Kling 4 continuous Tour Map (pilot)
                        </MudRadio>
                    }
                    @if (klingNativePresenterEnabled)
                    {
                        <MudRadio Value="CampaignVideoStrategy.Kling4NativePresenter" Color="Color.Primary">
                            Kling 4 native presenter, speech and music (pilot)
                        </MudRadio>
                    }
                </MudRadioGroup>
                @if (selectedVideoStrategy == CampaignVideoStrategy.Kling4FullTour)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        The agent presenter still appears only for the lip-synced opening and closing. The property keeps
                        the center of the video, and longer or non-30-second outputs continue to use the established edit.
                    </MudAlert>
                }
                else if (selectedVideoStrategy == CampaignVideoStrategy.Kling4NativePresenter)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        Kling places you, from your consented profile headshot, in front of the house for the opening shot only,
                        then walks through up to eight approved Tour Map photos while your voice continues, and generates the
                        speech and instrumental music.
                        @(KlingVideoSlots.Count > 0
                            ? $"Each vertical video below gets its own Kling call ({KlingVideoSlots.Count} in all), with its own length and script."
                            : "One 30-second call makes the vertical video.")
                        Exact wording and room order are generative and the finished video is validated.
                        @if (klingNativePresenterPilot)
                        {
                            <span data-testid="kling-pilot-note"> Pilot mode: every video is a 15-second 720p Kling video; live mode makes each one its full length at 1080p.</span>
                        }
                    </MudAlert>
                    @if (klingNativePresenterPilot && !LibraryMode)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-testid="kling-pilot-needs-library">
                            @NativePresenterVideoPolicy.PilotNeedsLibraryMessage
                        </MudAlert>
                    }
                    @if (KlingVideoSlots.Count > 0)
                    {
                        @foreach (var slot in KlingVideoSlots)
                        {
                            var draft = DraftFor(slot.Format);
                            var maximumWords = NativePresenterScript.MaximumWordsFor(slot.Seconds);
                            <MudPaper Outlined="true" Class="pa-3 mt-2" data-testid="@($"presenter-script-{slot.Format}")">
                                <MudText Typo="Typo.subtitle2">@VerticalFormatNames.Name(slot.Format) · @slot.Seconds seconds</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                                    This video's own Kling call. Kling is told to say these words exactly. @slot.Seconds seconds holds about @maximumWords words.
                                </MudText>
                                <MudTextField T="string" @bind-Value="draft.Opening" Label="Opening (agent on camera in front of the house)"
                                              Variant="Variant.Outlined" Lines="2" Immediate="true" Disabled="@(busy || IsReadOnly)"
                                              MaxLength="NativePresenterScript.MaximumOpeningLength" />
                                <MudTextField T="string" @bind-Value="draft.Tour" Label="Tour voiceover (over the AI tour)"
                                              Variant="Variant.Outlined" Lines="3" Immediate="true" Disabled="@(busy || IsReadOnly)" Class="mt-2"
                                              MaxLength="NativePresenterScript.MaximumTourLength" />
                                <MudTextField T="string" @bind-Value="draft.Closing" Label="Closing (agent's voice over the tour)"
                                              Variant="Variant.Outlined" Lines="2" Immediate="true" Disabled="@(busy || IsReadOnly)" Class="mt-2"
                                              MaxLength="NativePresenterScript.MaximumClosingLength" />
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2">
                                    <MudText Typo="Typo.caption" Color="@(draft.WordCount > maximumWords ? Color.Error : Color.Default)">
                                        @draft.WordCount / @maximumWords words
                                    </MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                               Disabled="@(busy || IsReadOnly)" OnClick="@(() => UseSuggestedFormatScriptAsync(slot))">
                                        Use suggested script
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        }
                        @if (LongLibraryVideos.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2" data-testid="kling-long-videos">
                                @string.Join(", ", LongLibraryVideos.Select(VerticalFormatNames.Name)) @(LongLibraryVideos.Count == 1 ? "is" : "are") longer than Kling's 30 seconds, so @(LongLibraryVideos.Count == 1 ? "it keeps" : "they keep") the established edit.
                            </MudText>
                        }
                    }
                    else
                    {
                        <MudPaper Outlined="true" Class="pa-3 mt-2" data-testid="presenter-script">
                            <MudText Typo="Typo.subtitle2">Presenter script</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                                Kling is told to say these words exactly. 30 seconds holds about @NativePresenterScript.MaximumWords words.
                            </MudText>
                            <MudTextField T="string" @bind-Value="presenterOpening" Label="Opening (agent on camera in front of the house)"
                                          Variant="Variant.Outlined" Lines="2" Immediate="true" Disabled="@(busy || IsReadOnly)"
                                          MaxLength="NativePresenterScript.MaximumOpeningLength" data-testid="presenter-opening" />
                            <MudTextField T="string" @bind-Value="presenterTour" Label="Tour voiceover (over the AI tour)"
                                          Variant="Variant.Outlined" Lines="4" Immediate="true" Disabled="@(busy || IsReadOnly)" Class="mt-2"
                                          MaxLength="NativePresenterScript.MaximumTourLength" data-testid="presenter-tour" />
                            <MudTextField T="string" @bind-Value="presenterClosing" Label="Closing (agent's voice over the tour)"
                                          Variant="Variant.Outlined" Lines="2" Immediate="true" Disabled="@(busy || IsReadOnly)" Class="mt-2"
                                          MaxLength="NativePresenterScript.MaximumClosingLength" data-testid="presenter-closing" />
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2">
                                <MudText Typo="Typo.caption" Color="@(PresenterWordCount > NativePresenterScript.MaximumWords ? Color.Error : Color.Default)"
                                         data-testid="presenter-word-count">
                                    @PresenterWordCount / @NativePresenterScript.MaximumWords words
                                </MudText>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           Disabled="@(busy || IsReadOnly)" OnClick="UseSuggestedScriptAsync">
                                    Use suggested script
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    }
                    @if (NativePresenterBlockers.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-testid="native-presenter-blockers">
                            <span>Before you can generate:</span>
                            <ul class="mb-0">
                                @foreach (var blocker in NativePresenterBlockers)
                                {
                                    <li>@blocker</li>
                                }
                            </ul>
                        </MudAlert>
                    }
                    @if (isPlatformAdmin && !IsReadOnly)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2"
                                   StartIcon="@Icons.Material.Filled.Preview"
                                   Disabled="@(busy || previewingKling)"
                                   OnClick="PreviewKlingAsync"
                                   data-testid="preview-kling-request">
                            Preview Kling request (free)
                        </MudButton>
                        @if (klingPreview is not null)
                        {
                            <div class="mt-3" data-testid="kling-preview">
                                @if (klingPreview.IsReady)
                                {
                                    <MudAlert Severity="Severity.Success" Dense="true">
                                        Ready. Generate would send @(klingPreview.Videos is { Count: > 1 } ? $"these {klingPreview.Videos.Count} requests" : "this request") to Kling 4 (estimated @klingPreview.EstimatedCostUsd.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))). Nothing has been sent.
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true">
                                        <span>Generate would be refused:</span>
                                        <ul class="mb-0">
                                            @foreach (var problem in klingPreview.Problems)
                                            {
                                                <li>@problem</li>
                                            }
                                        </ul>
                                    </MudAlert>
                                }
                                @if (klingPreview.Videos is { Count: > 0 } previewVideos && previewVideos.Any(video => video.Format != VerticalCreativeFormat.LegacySingle))
                                {
                                    @foreach (var video in previewVideos)
                                    {
                                        <MudText Typo="Typo.subtitle1" Class="mt-3" data-testid="@($"kling-preview-{video.Format}")">@VerticalFormatNames.Name(video.Format) · @video.DurationSeconds seconds</MudText>
                                        <MudText Typo="Typo.subtitle2" Class="mt-1">Keyframes</MudText>
                                        <ol class="mb-2">
                                            <li>Your profile headshot (you, in front of the house for the opening shot)</li>
                                            @foreach (var frame in video.Frames)
                                            {
                                                <li>@frame.StopName@(frame.DirectionToNext is null ? null : $", then {frame.DirectionToNext.ToLowerInvariant()}")</li>
                                            }
                                        </ol>
                                        @if (video.Request is { } request)
                                        {
                                            <MudText Typo="Typo.subtitle2">Request sent to Kling 4</MudText>
                                            <KlingRequestDetails BodyJson="@request.BodyJson"
                                                                 Method="@request.Method"
                                                                 Url="@request.Url"
                                                                 AgentPortraitId="video.AgentPortraitId"
                                                                 Frames="video.Frames"
                                                                 IsPreview="true"
                                                                 TestId="@($"kling-preview-request-{video.Format}")" />
                                        }
                                        else if (video.Prompt is not null)
                                        {
                                            <MudText Typo="Typo.subtitle2">Prompt</MudText>
                                            <pre style="white-space:pre-wrap;font-size:0.8rem;">@video.Prompt</pre>
                                        }
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.subtitle2" Class="mt-2">Keyframes</MudText>
                                    <ol class="mb-2">
                                        <li>Your profile headshot (you, in front of the house for the opening shot)</li>
                                        @foreach (var frame in klingPreview.Frames)
                                        {
                                            <li>@frame.StopName@(frame.DirectionToNext is null ? null : $", then {frame.DirectionToNext.ToLowerInvariant()}")@(frame.ApprovedHighlight is null ? " (no approved detail)" : null)</li>
                                        }
                                    </ol>
                                    @if (klingPreview.Prompt is not null)
                                    {
                                        <MudText Typo="Typo.subtitle2">Prompt</MudText>
                                        <pre style="white-space:pre-wrap;font-size:0.8rem;" data-testid="kling-preview-prompt">@klingPreview.Prompt</pre>
                                    }
                                    @if (klingPreview.Videos is { Count: > 0 } singleVideo && singleVideo[0].Request is { } singleRequest)
                                    {
                                        <MudText Typo="Typo.subtitle2">Request sent to Kling 4</MudText>
                                        <KlingRequestDetails BodyJson="@singleRequest.BodyJson"
                                                             Method="@singleRequest.Method"
                                                             Url="@singleRequest.Url"
                                                             AgentPortraitId="singleVideo[0].AgentPortraitId"
                                                             Frames="singleVideo[0].Frames"
                                                             IsPreview="true"
                                                             TestId="kling-preview-request" />
                                    }
                                }
                            </div>
                        }
                    }
                }
            </MudPaper>
        }
        @if (LibraryMode)
        {
            <VerticalCampaignPlanner Plan="verticalPlan"
                                     Picker="verticalPicker"
                                     Goal="selectedGoal"
                                     GoalChanged="ChooseGoal"
                                     SelectionChanged="VerticalSelectionChangedAsync"
                                     Disabled="@(busy || IsReadOnly)"
                                     OtherOutputCount="OtherOutputCount">
                @if (!IsReadOnly)
                {
                    <VerticalFormatInputs PropertyId="PropertyId" Disabled="busy" Changed="ReloadVerticalPlanAsync" />
                }
            </VerticalCampaignPlanner>
        }
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">Creative direction</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Start with a marketing template, then customize its verified content, branding, and presentation.
                Each output gets a platform-specific edit instead of a simple crop.
            </MudText>
            <MudSelect T="CampaignMarketingTemplate"
                       Label="Marketing template"
                       Value="selectedMarketingTemplate"
                       ValueChanged="ApplyTemplate"
                       Variant="Variant.Outlined"
                       Disabled="@(busy || IsReadOnly)"
                       Class="mb-2">
                @foreach (var template in Enum.GetValues<CampaignMarketingTemplate>())
                {
                    <MudSelectItem Value="template">@TemplateName(template)</MudSelectItem>
                }
            </MudSelect>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                @TemplateDescription(selectedMarketingTemplate)
            </MudAlert>
            @if (templateNote is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3" data-testid="template-note">@templateNote</MudText>
            }
            @if (selectedMarketingTemplate == CampaignMarketingTemplate.PriceDrop)
            {
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?"
                                         Label="Price reduction amount"
                                         @bind-Value="selectedPriceReductionAmount"
                                         Min="0.01m"
                                         Max="100000000m"
                                         Format="C0"
                                         Variant="Variant.Outlined"
                                         Disabled="@(busy || IsReadOnly)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool"
                                     @bind-Value="selectedPriceReductionVerified"
                                     Disabled="@(busy || IsReadOnly)"
                                     Label="I confirm this price reduction is accurate and approved for marketing" />
                    </MudItem>
                </MudGrid>
                @if (!TemplateReady)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-3">
                        Enter the reduction amount and confirm it before generating this template.
                    </MudText>
                }
            }
            @if (selectedMarketingTemplate == CampaignMarketingTemplate.OpenHouse)
            {
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Open house day and time"
                                      Placeholder="Sat 1-3 PM"
                                      @bind-Value="selectedOpenHouseText"
                                      MaxLength="CampaignCreativeOptions.MaximumOpenHouseTextLength"
                                      Counter="CampaignCreativeOptions.MaximumOpenHouseTextLength"
                                      Variant="Variant.Outlined"
                                      Disabled="@(busy || IsReadOnly)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool"
                                     @bind-Value="selectedOpenHouseVerified"
                                     Disabled="@(busy || IsReadOnly)"
                                     Label="I confirm the open house day and time are accurate" />
                    </MudItem>
                </MudGrid>
                @if (!TemplateReady)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-3">
                        Enter the open house day and time and confirm them before generating this template.
                    </MudText>
                }
            }
            @if (KlingOnlyCampaign)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" data-testid="kling-hidden-options">
                    Kling 4 makes the speech and music for every video in this campaign, so the voiceover, music, voice,
                    style and walk-through motion settings are hidden. Your script for each video is under Tour video
                    strategy above.
                </MudAlert>
            }
            @if (roomNarration.HasNarration && !KlingOnlyCampaign)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">Voiceover script</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                    You wrote narration for @(roomNarration.NarratedStopCount == 1 ? "1 room" : $"{roomNarration.NarratedStopCount} rooms")
                    on the walkthrough map (@roomNarration.WordCount words). Choose what the voice reads in the tour videos.
                </MudText>
                <MudSelect T="bool" Label="Narration" Value="roomNarration.IsInUse" ValueChanged="ChooseNarrationSourceAsync"
                           Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly || choosingNarration)" Class="mb-2"
                           data-testid="narration-source">
                    <MudSelectItem Value="true">Room-by-room narration from the walkthrough map</MudSelectItem>
                    <MudSelectItem Value="false">AI-generated script from the property story</MudSelectItem>
                </MudSelect>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                    @if (roomNarration.IsInUse)
                    {
                        <text>
                            Your words are read exactly as written, each starting as the tour reaches that room. The 30-second
                            short voiceover for TikTok, Reels and Shorts is still written from the property story.
                        </text>
                    }
                    else
                    {
                        <text>The tour videos read the AI script. Your room narration stays saved on the map.</text>
                    }
                </MudText>
                @if (roomNarration.IsInUse && roomNarration.WordCount > IPropertyNarrationScriptService.ShortFormWordLimit)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        At @roomNarration.WordCount words your narration is too long for a 60-second video, so those use the
                        AI script. Choose the full narrated tour to hear all of it, or shorten it to
                        @IPropertyNarrationScriptService.ShortFormWordLimit words.
                    </MudAlert>
                }
            }
            @if (!KlingOnlyCampaign)
            {
            <MudText Typo="Typo.subtitle2" Class="mt-2">Sound</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                The music plays in every video you selected.
            </MudText>
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignSoundtrack" Label="Music" Value="selectedSoundtrack" ValueChanged="SetSoundtrack" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        <MudSelectItem Value="CampaignSoundtrack.AutoByHomeEra">Choose for the home's era</MudSelectItem>
                        @foreach (var track in CampaignCreativeDirector.LibrarySoundtracks)
                        {
                            <MudSelectItem Value="track">@SoundtrackName(track)</MudSelectItem>
                        }
                        <MudSelectItem Value="CampaignSoundtrack.AddInApp">None, I'll add a sound in TikTok or Instagram</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.None">No music</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (PreviewSoundtrack is { } previewSoundtrack)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Preview</MudText>
                        <audio controls preload="none" src="@($"/campaigns/soundtracks/{previewSoundtrack}")"
                               style="width:100%;" aria-label="Preview the selected music"></audio>
                    }
                    else if (selectedSoundtrack == CampaignSoundtrack.AutoByHomeEra)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Older homes get Warm acoustic, mid-century homes Upbeat pop, newer homes Modern chill.
                        </MudText>
                    }
                    else if (selectedSoundtrack == CampaignSoundtrack.AddInApp)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            The videos have no music, so a trending sound you add in the app won't clash.
                        </MudText>
                    }
                </MudItem>
            </MudGrid>
            }
            <CaptionStylePicker Value="selectedCaptionStyle" ValueChanged="SetCaptionStyle" Disabled="@(busy || IsReadOnly)" />
            @if (LibraryMode)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">Vertical videos</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                    Each recommended video has its own hook, voice and caption plan. Your brand, language, voice, caption
                    look, music and agent card apply to all of them.
                </MudText>
                <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudCheckBox T="bool"
                                 Value="@IsCreativeElementSelected(CampaignVideoElement.AgentContact)"
                                 ValueChanged="@(value => SetCreativeElement(CampaignVideoElement.AgentContact, value))"
                                 Disabled="@(busy || IsReadOnly)"
                                 Label="Show my name and phone on short videos" />
                </MudItem>
                </MudGrid>
                @if (!KlingOnlyCampaign)
                {
                <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-2">
                    <MudExpansionPanel Text="Customize" data-testid="vertical-customize">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                            The campaign message comes from your goal; change it under Creative direction above. The style
                            and voiceover below are used only if none of the picked videos can be made and the campaign
                            falls back to one shared vertical video. Each format's own timing and captions are fixed so
                            every line stays tied to a verified fact.
                        </MudText>
                        <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignPace" Label="Style" @bind-Value="selectedPace" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        <MudSelectItem Value="CampaignPace.Fast">Fast cuts on the beat</MudSelectItem>
                        <MudSelectItem Value="CampaignPace.Cinematic">Cinematic glide</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignVoiceoverMode" Label="Voiceover" @bind-Value="selectedVoiceover" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        <MudSelectItem Value="CampaignVoiceoverMode.ShortHook">Short voiceover (30 seconds)</MudSelectItem>
                        <MudSelectItem Value="CampaignVoiceoverMode.None">Music and text only (30 seconds)</MudSelectItem>
                        <MudSelectItem Value="CampaignVoiceoverMode.Full">Full tour voiceover (60 seconds)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                </MudExpansionPanels>
                }
            }
            else
            {
            <MudText Typo="Typo.subtitle2" Class="mt-2">TikTok, Reels and Shorts</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                Short videos open with the price and location, cut on the music beat, and end on your contact card.
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignPace" Label="Style" @bind-Value="selectedPace" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        <MudSelectItem Value="CampaignPace.Fast">Fast cuts on the beat</MudSelectItem>
                        <MudSelectItem Value="CampaignPace.Cinematic">Cinematic glide</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignVoiceoverMode" Label="Voiceover" @bind-Value="selectedVoiceover" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        <MudSelectItem Value="CampaignVoiceoverMode.ShortHook">Short voiceover (30 seconds)</MudSelectItem>
                        <MudSelectItem Value="CampaignVoiceoverMode.None">Music and text only (30 seconds)</MudSelectItem>
                        <MudSelectItem Value="CampaignVoiceoverMode.Full">Full tour voiceover (60 seconds)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool"
                                 Value="@IsCreativeElementSelected(CampaignVideoElement.AgentContact)"
                                 ValueChanged="@(value => SetCreativeElement(CampaignVideoElement.AgentContact, value))"
                                 Disabled="@(busy || IsReadOnly)"
                                 Label="Show my name and phone on short videos" />
                </MudItem>
            </MudGrid>
            }
            @if (SilentLibraryVideo && !KlingOnlyCampaign)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-testid="silent-vertical">
                    The Wow feature video has no voiceover, so with No music it will be silent. Pick a music track, or
                    choose "None, I'll add a sound in TikTok or Instagram" if you'll add one there.
                </MudAlert>
            }
            @if (SilentVerticalVideo && !LibraryMode && !KlingOnlyCampaign)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-testid="silent-vertical">
                    With no voiceover and no music, the vertical video will be silent. Pick a music track or a voiceover,
                    or choose "None, I'll add a sound in TikTok or Instagram" if you'll add one there.
                </MudAlert>
            }
            @if (aerialIntro is { IsUsedInVideos: true } && !KlingOnlyCampaign)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-3" data-testid="approved-aerial-campaign-option">
                    <MudCheckBox T="bool"
                                 Value="@IsCreativeElementSelected(CampaignVideoElement.WalkthroughMotion)"
                                 ValueChanged="@(value => SetCreativeElement(CampaignVideoElement.WalkthroughMotion, value))"
                                 Disabled="@(busy || IsReadOnly)"
                                 Label="Start campaign videos with this approved AI drone flyover"
                                 Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                        Opening sequence: approved flyover → Exterior front and front door → entryway walk-through clip,
                        when that finished transition is available → the remaining Tour Map. This also turns on uploaded
                        walkthrough video and finished AI walk-through clips; leave it unchecked for photos only.
                    </MudText>
                </MudPaper>
            }
            <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                <MudExpansionPanel Text="Advanced: on-screen elements">
            <MudGrid Spacing="2">
                @foreach (var option in CreativeElementOptions)
                {
                    if (option.Element == CampaignVideoElement.WalkthroughMotion
                        && (aerialIntro is { IsUsedInVideos: true } || KlingOnlyCampaign))
                    {
                        continue;
                    }

                    var lockedByPlan = option.Element == CampaignVideoElement.AgentAvatar && !planIncludesPresenter;
                    <MudItem xs="12" sm="6" Class="@(lockedByPlan ? "is-plan-locked" : null)">
                        <MudCheckBox T="bool"
                                     Value="@IsCreativeElementSelected(option.Element)"
                                     ValueChanged="@(value => SetCreativeElement(option.Element, value))"
                                     Disabled="@(busy || IsReadOnly || lockedByPlan)"
                                     Label="@option.Name" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@option.Details</MudText>
                        @if (lockedByPlan)
                        {
                            <div class="plan-unlock-row" data-testid="presenter-plan-note">
                                <span class="plan-upgrade-note">Included with Professional and Enterprise.</span>
                                <PlanUnlock Feature="AI agent presenter (avatar)" />
                            </div>
                        }
                    </MudItem>
                }
            </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
            @if (NoVideoElements)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block mt-2" data-testid="no-elements">
                    Turn on at least one on-screen element, your name and phone, or music before generating the campaign.
                </MudText>
            }
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">@(KlingOnlyCampaign ? "Captions" : "Narration and captions")</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                @(KlingOnlyCampaign
                    ? "Choose the caption language. Kling speaks each video's script as written."
                    : "Choose the presentation region, spoken language, caption language, and voice accent. Region guides wording and pronunciation; it does not infer anyone's nationality.")
            </MudText>
            <MudGrid Spacing="2">
                @if (!KlingOnlyCampaign)
                {
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignNarrationRegion" Label="Narration region" @bind-Value="selectedNarrationRegion" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var region in Enum.GetValues<CampaignNarrationRegion>())
                        {
                            <MudSelectItem Value="region">@Display(region)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignLanguage" Label="Spoken language" @bind-Value="selectedSpokenLanguage" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var language in Enum.GetValues<CampaignLanguage>())
                        {
                            <MudSelectItem Value="language">@Display(language)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignLanguage" Label="Caption language" @bind-Value="selectedCaptionLanguage" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var language in Enum.GetValues<CampaignLanguage>())
                        {
                            <MudSelectItem Value="language">@Display(language)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (!KlingOnlyCampaign)
                {
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignVoiceAccent" Label="Voice accent" @bind-Value="selectedVoiceAccent" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var accent in Enum.GetValues<CampaignVoiceAccent>())
                        {
                            <MudSelectItem Value="accent">@Display(accent)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                }
            </MudGrid>
            @if (!KlingOnlyCampaign)
            {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                Accent is an AI voice direction and may vary by voice. Creative Listing Studio always discloses that narration is AI-generated.
            </MudAlert>
            }
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">Agent presenter</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                Your private profile headshot can appear on the closing card or as an on-screen presenter while the disclosed AI voice narrates.
            </MudText>
            @if (portrait is not null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                    <img src="@($"/agent-portraits/{portrait.Id}")" alt="Agent photo preview" style="width:72px;height:72px;object-fit:cover;border-radius:50%;" />
                    <div>
                        <MudText Typo="Typo.caption">@portrait.OriginalFilename · @portrait.Width × @portrait.Height</MudText>
                        <MudLink Href="/profile" Typo="Typo.caption">Crop, replace, or AI-fix this headshot</MudLink>
                    </div>
                </MudStack>
            }
            else
            {
                <MudButton Href="/profile" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddAPhoto" Class="mt-2">
                    Add profile headshot
                </MudButton>
            }
            @if (selectedCreativeElements.HasFlag(CampaignVideoElement.AgentAvatar)
                 || selectedVideoStrategy == CampaignVideoStrategy.Kling4NativePresenter)
            {
                <MudCheckBox T="bool"
                             @bind-Value="selectedAgentAvatarConsent"
                             data-testid="presenter-consent"
                             Disabled="@(busy || IsReadOnly)"
                             Label="I confirm this is my photo and I consent to its use as an AI presenter in this campaign" />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    @if (selectedVideoStrategy == CampaignVideoStrategy.Kling4NativePresenter)
                    {
                        <span>Kling 4 will place you, from this portrait, in front of the house for the opening shot and generate native speech and music. HeyGen is not used for the native-presenter video.</span>
                    }
                    else if (AgentAvatarVideoService.IsEnabled)
                    {
                        <span>Creative Listing Studio will create short lip-synced opening and closing clips from your approved portrait and the selected AI narration. If the presenter provider is unavailable, the campaign continues with your static portrait.</span>
                    }
                    else
                    {
                        <span>Lip-sync is not enabled in this environment. The campaign will safely use your approved static portrait during the opening and closing while the selected AI voice narrates.</span>
                    }
                </MudAlert>
            }
            @if (!KlingOnlyCampaign)
            {
            <MudCheckBox T="bool"
                         @bind-Value="selectedLocalizeAgentCard"
                         Disabled="@(busy || IsReadOnly || !(selectedCreativeElements.HasFlag(CampaignVideoElement.AgentPortrait) || selectedCreativeElements.HasFlag(CampaignVideoElement.AgentAvatar)))"
                         Label="Use the selected language and accent during the agent closing card" />
            }
        </MudPaper>
    }
    else if (job.RequestedOutputs != CampaignOutputSelection.LegacyStandard)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
            Creating: @SelectedOutputNames(job.RequestedOutputs)
        </MudText>
        @if (job.VerticalRequest is { } verticalRequest)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3" data-testid="vertical-request-summary">
                @VerticalRequestSummary(verticalRequest)
            </MudText>
        }
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
    }

    @if (refreshError is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@refreshError</MudAlert>
    }

    @if (failedAnalysisCount > 0 && job?.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Analysis failed for @failedAnalysisCount @(failedAnalysisCount == 1 ? "photo" : "photos"). Creative Listing Studio is retrying,
            and the campaign will stop if a photo runs out of attempts. See Listing photos for details.
        </MudAlert>
    }

    @if (NoTourPhotos && !IsReadOnly)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Campaigns use only photos placed on the Tour Map. Place at least one photo in a stop on the
            <a href="@($"/properties/{PropertyId}?tab=media")">Media tab</a> to generate a campaign.
        </MudAlert>
    }

    @if (mediaCount is > 0 and < 3)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Only @mediaCount @(mediaCount == 1 ? "photo is" : "photos are") available. Creative Listing Studio can create a conservative
            fallback plan, but at least three analyzed interior and exterior photos are recommended for a varied video.
        </MudAlert>
    }

    @if (job is null)
    {
        <MudText Typo="Typo.body1">No campaign has been generated yet.</MudText>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudChip T="string" Color="@StatusColor(job.Status)" Variant="Variant.Filled">
                @Display(job.Status)
            </MudChip>
            <MudText Typo="Typo.body2">@Display(job.CurrentStage)</MudText>
        </MudStack>
        <MudPaper Outlined="true" Class="pa-3 mb-4" data-testid="campaign-generation-audit">
            <MudText Typo="Typo.subtitle2">Generation audit</MudText>
            <MudText Typo="Typo.body2">
                Strategy: <strong>@VideoStrategyName(job.VideoStrategy)</strong>
            </MudText>
            @if (job.ProviderAudit is { } audit)
            {
                <MudText Typo="Typo.body2">Provider: <strong>@audit.Provider</strong></MudText>
                <MudText Typo="Typo.body2">
                    Request ID: <code>@(audit.RequestId ?? "Waiting for provider submission")</code>
                </MudText>
                <MudText Typo="Typo.body2">
                    Generation version: <code>@(audit.GenerationVersion ?? "Waiting for provider submission")</code>
                </MudText>
                @if (isPlatformAdmin && !string.IsNullOrWhiteSpace(audit.SubmittedPrompt))
                {
                    <MudExpansionPanels Class="mt-2">
                        <MudExpansionPanel Text="Submitted Higgsfield prompt">
                            <MudText Typo="Typo.body2" Style="white-space: pre-wrap" data-testid="campaign-submitted-prompt">
                                @audit.SubmittedPrompt
                            </MudText>
                        </MudExpansionPanel>
                        @if (!string.IsNullOrWhiteSpace(audit.SubmittedRequestJson))
                        {
                            <MudExpansionPanel Text="Submitted Kling 4 request (every parameter)">
                                <KlingRequestDetails BodyJson="@audit.SubmittedRequestJson"
                                                     TestId="campaign-submitted-request" />
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    This campaign uses the Creative Listing Studio renderer rather than the Kling provider path.
                </MudText>
            }
            @if (job.VideoStrategy == CampaignVideoStrategy.Kling4NativePresenter
                && job.VerticalRequest is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                    Each vertical video of 30 seconds or less has its own Kling request, with its own presenter,
                    speech, music and Tour Map order; each video below shows its request ID. Longer videos are
                    labeled as established CLS edits.
                </MudText>
            }
        </MudPaper>
        <MudProgressLinear Value="job.ProgressPercent" Color="Color.Primary" Class="mb-4" />

        @if (!string.IsNullOrWhiteSpace(job.LastError))
        {
            <MudAlert Severity="@(job.Status == CampaignGenerationStatus.Failed ? Severity.Error : Severity.Warning)" Class="mb-4">
                @if (job.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
                {
                    @if (job.CancellationRequested)
                    {
                        <span><strong>Cancellation requested.</strong> The current step will stop safely; no further retries will start.</span>
                    }
                    else
                    {
                        <span><strong>Previous attempt:</strong> @DisplayError(job) Retrying automatically.</span>
                    }
                }
                else
                {
                    @DisplayError(job)
                }
            </MudAlert>
        }

        <MudList T="CampaignStageResult" Dense="true" Class="mb-4">
            @foreach (var stage in job.Stages)
            {
                <MudListItem T="CampaignStageResult"
                             Icon="@StageIcon(stage.Status)"
                             IconColor="@StageColor(stage.Status)">
                    @Display(stage.Stage)
                    @if (stage.AttemptCount > 1)
                    {
                        <span> · attempt @stage.AttemptCount</span>
                    }
                </MudListItem>
            }
        </MudList>

        @if (job.VerticalRequest is not null)
        {
            <CampaignVideoLibraryResults JobId="job.Id"
                                         Stamp="job.UpdatedAtUtc"
                                         IsReadOnly="IsReadOnly"
                                         ShowGuideLink="libraryEnabled"
                                         VideoStrategy="job.VideoStrategy"
                                         ProviderAudit="job.ProviderAudit"
                                         ShowProviderRequests="isPlatformAdmin" />
            <CampaignPerformancePanel JobId="job.Id" Stamp="job.UpdatedAtUtc" IsReadOnly="IsReadOnly" />
        }

        @if (job.Deliverables.Count > 0)
        {
            <MudGrid Spacing="2" Class="mb-4">
                @foreach (var deliverable in job.Deliverables)
                {
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.h6">@OutputName(deliverable.Kind)</MudText>
                            <MudText Class="mud-text-secondary" Typo="Typo.body2">
                                @deliverable.DurationSeconds seconds · @deliverable.AspectRatio · @Dimensions(deliverable.AspectRatio)
                            </MudText>
                            @if (deliverable.Status == CampaignDeliverableStatus.Rendered)
                            {
                                <video @key="@($"{deliverable.Kind}-{deliverable.Version}")"
                                       controls
                                       preload="metadata"
                                       style="width: 100%; margin-top: 1rem; border-radius: 4px;"
                                       aria-label="@($"Preview {deliverable.Kind} video")">
                                    <source src="@PreviewUrl(job.Id, deliverable.Kind, deliverable.Version)" type="video/mp4" />
                                    Your browser does not support MP4 video playback.
                                </video>
                                <MudButton Href="@DownloadUrl(job.Id, deliverable.Kind, deliverable.Version)"
                                           Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Class="mt-3">
                                    Download MP4
                                </MudButton>
                                @if (!IsReadOnly)
                                {
                                    <CampaignVideoChatPanel JobId="job.Id"
                                                            Kind="deliverable.Kind"
                                                            VideoName="@OutputName(deliverable.Kind)"
                                                            VersionChanged="LoadAsync" />
                                }
                            }
                            else if (job.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
                            {
                                <MudProgressLinear Indeterminate="true" Class="mt-3" />
                            }
                            else
                            {
                                @* A stopped campaign is not working on this output, so it must not look busy. *@
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3" data-testid="output-not-made">
                                    @(job.Status == CampaignGenerationStatus.Cancelled
                                        ? "Not made: the campaign was cancelled."
                                        : "Not made: the campaign stopped before this was finished.")
                                </MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (job.StillPosts.Count > 0)
        {
            <MudText Typo="Typo.h6" Class="mb-2">Still-image posts</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Download either feed-ready crop, or use Share on a supported phone to choose Facebook or another installed app.
            </MudText>
            @if (shareMessage is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@shareMessage</MudAlert>
            }
            <MudGrid Spacing="2" Class="mb-4">
                @foreach (var post in job.StillPosts)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.h6">@StillPostName(post.Kind)</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @post.Width × @post.Height · JPEG
                            </MudText>
                            @if (post.Status == CampaignStillPostStatus.Rendered)
                            {
                                <img src="@StillPostUrl(job.Id, post.Kind)"
                                     alt="@($"Preview {StillPostName(post.Kind)}")"
                                     style="width: 100%; margin-top: 1rem; border-radius: 4px;" />
                                <MudStack Row="true" Spacing="2" Class="mt-3" Style="flex-wrap: wrap;">
                                    <MudButton Href="@StillPostDownloadUrl(job.Id, post.Kind)"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary">
                                        Download JPEG
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               OnClick="@(() => CopyCaptionAsync(post.Caption))">
                                        Copy caption
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="@(() => ShareStillPostAsync(post))">
                                        Share
                                    </MudButton>
                                </MudStack>
                            }
                            else if (job.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
                            {
                                <MudProgressLinear Indeterminate="true" Class="mt-3" />
                            }
                            else
                            {
                                @* A stopped campaign is not working on this output, so it must not look busy. *@
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3" data-testid="output-not-made">
                                    @(job.Status == CampaignGenerationStatus.Cancelled
                                        ? "Not made: the campaign was cancelled."
                                        : "Not made: the campaign stopped before this was finished.")
                                </MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (job.Status == CampaignGenerationStatus.Completed)
        {
            <MudText Class="mud-text-secondary" Typo="Typo.overline">Short social caption</MudText>
            <MudText Typo="Typo.body1" Class="mb-3">@job.SocialCaptionShort</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.overline">Long social caption</MudText>
            <MudText Typo="Typo.body1">@job.SocialCaptionLong</MudText>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            @if (job.Status == CampaignGenerationStatus.Failed)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="RetryAsync">
                    Retry failed stage
                </MudButton>
            }
            @if (!IsReadOnly && job.Status is CampaignGenerationStatus.Failed
                or CampaignGenerationStatus.Queued
                or CampaignGenerationStatus.Running)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Disabled="@(busy || job.CancellationRequested)"
                           OnClick="CancelAndStartOverAsync"
                           data-testid="cancel-and-start-over">
                    @(job.CancellationRequested ? "Cancelling…" : "Cancel and start over")
                </MudButton>
            }
            <MudButton Variant="Variant.Text" Disabled="busy" OnClick="LoadAsync">Refresh</MudButton>
        </MudStack>
    }
</MudPaper>

<FeatureSuggestionBox PropertyId="PropertyId"
                      ActiveCampaignId="@(job?.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running ? job.Id : null)" />

@code {
    [Parameter]
    public Guid PropertyId { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    /// <summary>Raised when the latest campaign's status changes, so the page can update its next step.</summary>
    [Parameter]
    public EventCallback StatusChanged { get; set; }

    /// <summary>
    /// A deep link into the vertical workflow (<c>goal</c> or <c>formats</c>). Ignored, leaving the legacy campaign
    /// page as it always was, while the vertical video library is off for the workspace.
    /// </summary>
    [Parameter]
    public string? Focus { get; set; }

    private readonly CancellationTokenSource pollingCancellation = new();
    private CampaignGenerationResult? job;
    private bool busy;
    private bool previewingKling;
    private KlingNativePresenterPreview? klingPreview;
    private bool klingNativePresenterPilot;
    private string? presenterOpening;
    private string? presenterTour;
    private string? presenterClosing;
    private readonly Dictionary<VerticalCreativeFormat, PresenterDraft> formatDrafts = [];
    private bool pollingStarted;
    private string? error;
    private string? refreshError;
    private string? shareMessage;
    private int mediaCount;
    private bool mediaLoaded;
    private int failedAnalysisCount;
    private bool longFormAvailable;
    private AgentPortraitItem? portrait;
