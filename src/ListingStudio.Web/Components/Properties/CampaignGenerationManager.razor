    {
        CampaignOutputKind.TikTok => "TikTok",
        CampaignOutputKind.InstagramReel => "Instagram Reel",
        CampaignOutputKind.YouTubeShort => "YouTube Short",
        CampaignOutputKind.YouTubeTour => "YouTube property tour",
        CampaignOutputKind.FacebookFeed => "Facebook Feed",
        CampaignOutputKind.FullNarratedTour => "Full narrated tour",
        CampaignOutputKind.Hero => "HERO",
        CampaignOutputKind.Feature => "FEATURE",
        CampaignOutputKind.Teaser => "TEASER",
        CampaignOutputKind.LongForm => "LONG FORM",
        _ => Display(kind),
    };

    private static string Dimensions(string aspectRatio) =>
        aspectRatio == "16:9" ? "1920 × 1080" : "1080 × 1920";

    private sealed record OutputOption(CampaignOutputSelection Selection, string Name, string Details);

