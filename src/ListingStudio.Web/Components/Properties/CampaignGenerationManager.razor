    private async Task CopyCaptionAsync(string caption)
    {
        var copied = await JSRuntime.InvokeAsync<bool>("listingStudioCampaign.copyText", caption);
        shareMessage = copied
            ? "Caption copied."
            : "Copy is unavailable in this browser. Select the caption text below instead.";
    }

    private async Task ShareStillPostAsync(CampaignStillPostResult post)
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<string>(
                "listingStudioCampaign.shareStillPost",
                StillPostUrl(job!.Id, post.Kind),
                post.Caption,
                $"listing-studio-{post.Kind.ToString().ToLowerInvariant()}.jpg");
            shareMessage = result switch
            {
                "shared" => "The image was sent to your device's share menu.",
                "copied" => "This browser cannot share image files, so the caption was copied. Download the JPEG and attach it to your Facebook post.",
                _ => "Sharing is unavailable in this browser. Download the JPEG and copy the caption instead.",
            };
        }
        catch (JSException exception)
        {
            Logger.LogInformation(exception, "Still-post sharing was dismissed or unavailable.");
            shareMessage = "Sharing was cancelled or is unavailable. The JPEG and caption are still ready to download and copy.";
        }
    }

