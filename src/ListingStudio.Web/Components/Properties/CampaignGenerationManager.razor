    /// <summary>What still stops a native-presenter Generate, in the agent's words (empty when nothing does).</summary>
    private IReadOnlyList<string> NativePresenterBlockers
    {
        get
        {
            var blockers = new List<string>();
            if (portrait is null)
            {
                blockers.Add("Add a profile headshot on your Profile page.");
            }

            if (!selectedAgentAvatarConsent)
            {
                blockers.Add("Tick the AI presenter consent box under Agent presenter, below.");
            }

            if (!LibraryMode
                && (!selectedOutputs.HasFlag(CampaignOutputSelection.TikTok) || selectedVoiceover == CampaignVoiceoverMode.Full))
            {
                blockers.Add("Select TikTok with a short or no voiceover; Kling replaces only the 30-second vertical video.");
            }

            if (mediaLoaded && mediaCount == 0)
            {
                blockers.Add("Place at least one photo on the Tour Map.");
            }

            if (KlingVideoSlots.Count > 0)
            {
                foreach (var slot in KlingVideoSlots)
                {
                    var name = VerticalFormatNames.Name(slot.Format);
                    var draft = formatDrafts.GetValueOrDefault(slot.Format);
                    var maximum = NativePresenterScript.MaximumWordsFor(slot.Seconds);
                    if (draft is not { IsComplete: true })
                    {
                        blockers.Add($"{name}: fill in all three parts of the presenter script.");
                    }
                    else if (draft.WordCount > maximum)
                    {
                        blockers.Add($"{name}: shorten the presenter script to {maximum} words (now {draft.WordCount}).");
                    }
                    else if ((draft.Opening + draft.Tour + draft.Closing).Contains('"', StringComparison.Ordinal))
                    {
                        blockers.Add($"{name}: remove double quotation marks from the presenter script.");
                    }
                }
            }
            else if (LibraryMode && verticalPicker is { Chosen.Count: > 0 })
            {
                blockers.Add("Choose at least one vertical video of 30 seconds or less; Kling makes up to 30 seconds per call.");
            }
            else if (string.IsNullOrWhiteSpace(presenterOpening)
                || string.IsNullOrWhiteSpace(presenterTour)
                || string.IsNullOrWhiteSpace(presenterClosing))
            {
                blockers.Add("Fill in all three parts of the presenter script.");
            }
            else if (PresenterWordCount > NativePresenterScript.MaximumWords)
            {
                blockers.Add($"Shorten the presenter script to {NativePresenterScript.MaximumWords} words (now {PresenterWordCount}).");
            }
            else if ((presenterOpening + presenterTour + presenterClosing).Contains('"', StringComparison.Ordinal))
            {
                blockers.Add("Remove double quotation marks from the presenter script.");
            }

            return blockers;
        }
    }

    private int PresenterWordCount =>
        NativePresenterScript.CountWords(presenterOpening)
        + NativePresenterScript.CountWords(presenterTour)
        + NativePresenterScript.CountWords(presenterClosing);

    private async Task UseSuggestedScriptAsync()
    {
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            var suggested = await Service.SuggestNativePresenterScriptAsync(
                userId,
                PropertyId,
                selectedMarketingTemplate,
                selectedMarketingTemplate == CampaignMarketingTemplate.OpenHouse ? selectedOpenHouseText : null,
                selectedGoal,
                cancellationToken: pollingCancellation.Token);
            if (suggested is not null)
            {
                presenterOpening = suggested.Opening;
                presenterTour = suggested.Tour;
                presenterClosing = suggested.Closing;
            }
        }
        catch (Exception exception) when (exception is InvalidOperationException or UnauthorizedAccessException)
        {
            error = exception.Message;
        }
    }

    /// <summary>The library videos Kling makes, each with its own call: the chosen ones of 30 seconds or less.</summary>
    private IReadOnlyList<KlingVideoSlot> KlingVideoSlots =>
        selectedVideoStrategy == CampaignVideoStrategy.Kling4NativePresenter && LibraryMode && verticalPicker is { Chosen.Count: > 0 } picker
            ? picker.Chosen
                .Select(format => (Format: format, Recipe: verticalPlan?.Recipes.FirstOrDefault(recipe => recipe.Format == format)))
                .Select(item => (item.Format, item.Recipe, Seconds: NativePresenterVideoPolicy.DurationFor(
                    item.Recipe?.DurationSeconds ?? NativePresenterScript.DefaultSeconds,
                    klingNativePresenterPilot)))
                .Where(item => item.Seconds <= NativePresenterScript.DefaultSeconds)
                .Select(item => new KlingVideoSlot(
                    item.Format,
                    item.Seconds,
                    item.Recipe?.PrimaryPropertyMediaId))
                .ToArray()
            : [];

    /// <summary>Chosen library videos too long for one Kling call; they keep the established edit.</summary>
    private IReadOnlyList<VerticalCreativeFormat> LongLibraryVideos =>
        selectedVideoStrategy == CampaignVideoStrategy.Kling4NativePresenter && LibraryMode && verticalPicker is { Chosen.Count: > 0 } picker
            ? picker.Chosen
                .Where(format => !klingNativePresenterPilot
                    && verticalPlan?.Recipes.FirstOrDefault(recipe => recipe.Format == format) is { DurationSeconds: > NativePresenterScript.DefaultSeconds })
                .ToArray()
            : [];

    private PresenterDraft DraftFor(VerticalCreativeFormat format)
    {
        if (!formatDrafts.TryGetValue(format, out var draft))
        {
            draft = new PresenterDraft();
            formatDrafts[format] = draft;
        }

        return draft;
    }

    private async Task VerticalSelectionChangedAsync()
    {
        klingPreview = null;
        if (KlingVideoSlots.Count > 0)
        {
            await FillMissingFormatScriptsAsync();
        }

        StateHasChanged();
    }

    /// <summary>Suggests a script for every Kling video that has none yet; the agent's edits are kept.</summary>
    private async Task FillMissingFormatScriptsAsync()
    {
        foreach (var slot in KlingVideoSlots)
        {
            if (formatDrafts.TryGetValue(slot.Format, out var draft) && !draft.IsEmpty)
            {
                continue;
            }

            await UseSuggestedFormatScriptAsync(slot);
        }
    }

    private async Task UseSuggestedFormatScriptAsync(KlingVideoSlot slot)
    {
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            var suggested = await Service.SuggestNativePresenterScriptAsync(
                userId,
                PropertyId,
                selectedMarketingTemplate,
                selectedMarketingTemplate == CampaignMarketingTemplate.OpenHouse ? selectedOpenHouseText : null,
                selectedGoal,
                slot.Format,
                slot.Seconds,
                slot.LeadMediaId,
                pollingCancellation.Token);
            if (suggested is not null)
            {
                formatDrafts[slot.Format] = PresenterDraft.From(suggested);
            }
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException or UnauthorizedAccessException)
        {
            error = exception.Message;
        }
    }

    private sealed record KlingVideoSlot(VerticalCreativeFormat Format, int Seconds, Guid? LeadMediaId);

    /// <summary>One library video's presenter script while the agent edits it.</summary>
    private sealed class PresenterDraft
    {
        public string? Opening { get; set; }

        public string? Tour { get; set; }

        public string? Closing { get; set; }

        public int WordCount =>
            NativePresenterScript.CountWords(Opening) + NativePresenterScript.CountWords(Tour) + NativePresenterScript.CountWords(Closing);

        public bool IsComplete =>
            !string.IsNullOrWhiteSpace(Opening) && !string.IsNullOrWhiteSpace(Tour) && !string.IsNullOrWhiteSpace(Closing);

        public bool IsEmpty =>
            string.IsNullOrWhiteSpace(Opening) && string.IsNullOrWhiteSpace(Tour) && string.IsNullOrWhiteSpace(Closing);

        public NativePresenterScript ToScript() => new(Opening!, Tour!, Closing!);

        public static PresenterDraft From(NativePresenterScript script) =>
            new() { Opening = script.Opening, Tour = script.Tour, Closing = script.Closing };
    }

    private async Task PreviewKlingAsync()
    {
        previewingKling = true;
        error = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            klingPreview = await Service.PreviewKlingNativePresenterAsync(
                userId,
                PropertyId,
                selectedOutputs,
                BuildCreativeOptions(),
                selectedGoal,
                LibraryMode && verticalPicker is { Chosen.Count: > 0 },
                LibraryMode && verticalPicker is { Chosen.Count: > 0 } picker ? picker.Chosen : null,
                new Uri(Navigation.BaseUri),
                pollingCancellation.Token);
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException or UnauthorizedAccessException)
        {
            error = exception.Message;
        }
        finally
        {
            previewingKling = false;
        }
    }

