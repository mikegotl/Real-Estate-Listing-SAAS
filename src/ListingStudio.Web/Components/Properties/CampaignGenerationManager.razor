        selectedCreativeElements = CampaignCreativeOptions.SocialDefault.Elements;
        selectedSoundtrack = CampaignCreativeOptions.SocialDefault.Soundtrack;
        selectedCaptionStyle = CampaignCreativeOptions.SocialDefault.CaptionStyle;
        selectedMarketingTemplate = CampaignCreativeOptions.SocialDefault.MarketingTemplate;
        selectedPriceReductionAmount = null;
        selectedPriceReductionVerified = false;
        selectedOpenHouseText = null;
        selectedOpenHouseVerified = false;
        selectedAgentAvatarConsent = false;
        selectedPace = CampaignCreativeOptions.SocialDefault.Pace;
        selectedVoiceover = CampaignCreativeOptions.SocialDefault.Voiceover;
        selectedNarrationRegion = CampaignNarrationPreferences.Default.Region;
        selectedSpokenLanguage = CampaignNarrationPreferences.Default.SpokenLanguage;
        selectedCaptionLanguage = CampaignNarrationPreferences.Default.CaptionLanguage;
        selectedVoiceAccent = CampaignNarrationPreferences.Default.VoiceAccent;
        selectedLocalizeAgentCard = CampaignNarrationPreferences.Default.LocalizeAgentCard;
        selectedGoal = null;
        restoreVerticalRequest = null;
        verticalPlan = null;
        verticalPicker = null;
        selectedVideoStrategy = CampaignVideoStrategy.Established;
        presenterOpening = null;
        presenterTour = null;
        presenterClosing = null;
        formatDrafts.Clear();
        klingPreview = null;
        soundtrackChosen = false;
        captionStyleChosen = false;
        templateNote = null;
        if (profileIncludesPresenter && portrait is not null && planIncludesPresenter)
        {
            selectedCreativeElements &= ~CampaignVideoElement.AgentPortrait;
            selectedCreativeElements |= CampaignVideoElement.AgentAvatar;
            selectedAgentAvatarConsent = true;
        }
        else if (profileIncludesPresenter && portrait is not null)
        {
            selectedCreativeElements |= CampaignVideoElement.AgentPortrait;
            selectedCreativeElements &= ~CampaignVideoElement.AgentAvatar;
            selectedAgentAvatarConsent = false;
        }
        else
        {
            selectedCreativeElements &= ~CampaignVideoElement.AgentAvatar;
            selectedAgentAvatarConsent = false;
        }

        selectionInitialized = true;
    }

    private async Task MutateAsync(Func<string, Task> action)
    {
        busy = true;
        error = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            await action(userId);
            if (job is null)
            {
                error = "Property not found or unavailable to your organization.";
            }

            await ReportStatusAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or InvalidDataException)
        {
            error = exception.Message;
        }
        catch (ArgumentException exception)
        {
            // Option checks report what to change; ArgumentException adds the parameter name, which the agent never needs.
            error = exception.Message.Split(" (Parameter", 2)[0];
        }
        finally
        {
            busy = false;
        }
    }

    // The first load only records the status; later changes tell the page.
    private async Task ReportStatusAsync()
    {
        var status = job?.Status;
        if (statusLoaded && status == reportedStatus)
        {
            return;
        }

        var notify = statusLoaded;
        statusLoaded = true;
        reportedStatus = status;
        if (notify)
        {
            await StatusChanged.InvokeAsync();
        }
    }

    private void StartPolling()
    {
        if (pollingStarted)
        {
            return;
        }

        pollingStarted = true;
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(pollingCancellation.Token))
            {
                if (job?.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadAsync();
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException) when (pollingCancellation.IsCancellationRequested)
        {
        }
    }

    protected override async ValueTask DisposeAsyncCore()
    {
        pollingCancellation.Cancel();
        pollingCancellation.Dispose();
        await base.DisposeAsyncCore();
    }

