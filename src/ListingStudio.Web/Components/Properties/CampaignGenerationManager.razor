    private CampaignCreativeOptions BuildCreativeOptions()
    {
        var elements = RequestedElements;
        if (selectedVideoStrategy == CampaignVideoStrategy.Kling4NativePresenter)
        {
            elements &= ~CampaignVideoElement.AgentPortrait;
            elements |= CampaignVideoElement.AgentAvatar;
        }

        var portraitId = elements.HasFlag(CampaignVideoElement.AgentPortrait)
            || elements.HasFlag(CampaignVideoElement.AgentAvatar)
                ? portrait?.Id
                : null;
        var formatScripts = selectedVideoStrategy == CampaignVideoStrategy.Kling4NativePresenter && KlingVideoSlots.Count > 0
            ? KlingVideoSlots
                .Where(slot => formatDrafts.TryGetValue(slot.Format, out var draft) && draft.IsComplete)
                .Select(slot => new FormatPresenterScript(slot.Format, formatDrafts[slot.Format].ToScript()))
                .ToArray()
            : null;
        var script = selectedVideoStrategy == CampaignVideoStrategy.Kling4NativePresenter
            && KlingVideoSlots.Count == 0
            && !string.IsNullOrWhiteSpace(presenterOpening)
            && !string.IsNullOrWhiteSpace(presenterTour)
            && !string.IsNullOrWhiteSpace(presenterClosing)
                ? new NativePresenterScript(presenterOpening, presenterTour, presenterClosing)
                : null;
        return new CampaignCreativeOptions(
                elements,
                selectedSoundtrack,
                selectedCaptionStyle,
                portraitId,
                selectedMarketingTemplate,
                selectedPriceReductionAmount,
                selectedPriceReductionVerified,
                elements.HasFlag(CampaignVideoElement.AgentAvatar) && selectedAgentAvatarConsent,
                selectedPace,
                selectedVoiceover,
                selectedMarketingTemplate == CampaignMarketingTemplate.OpenHouse ? selectedOpenHouseText?.Trim() : null,
                selectedMarketingTemplate == CampaignMarketingTemplate.OpenHouse && selectedOpenHouseVerified,
                script,
                formatScripts is { Length: > 0 } ? formatScripts : null);
    }

    private async Task GenerateAsync() => await MutateAsync(async userId =>
    {
        var creativeOptions = BuildCreativeOptions();
        var narrationPreferences = new CampaignNarrationPreferences(
                selectedNarrationRegion,
                selectedSpokenLanguage,
                selectedCaptionLanguage,
                selectedVoiceAccent,
                selectedLocalizeAgentCard);
        // Library videos only when the agent picked some; a listing with nothing eligible keeps the shared video.
        job = LibraryMode && verticalPicker is { Chosen.Count: > 0 } picker
            ? await Service.EnqueueAsync(
                userId, PropertyId, selectedOutputs, creativeOptions, narrationPreferences,
                selectedVideoStrategy, picker.ToRequest(selectedGoal))
            : await Service.EnqueueAsync(
                userId, PropertyId, selectedOutputs, creativeOptions, narrationPreferences,
                selectedVideoStrategy);
    });

    // The plan reads the media service and claims in its own scope, so it never shares the polling DbContext.
    private async Task LoadVerticalPlanAsync(string userId, CancellationToken cancellationToken)
    {
        var portraitId = selectedCreativeElements.HasFlag(CampaignVideoElement.AgentPortrait)
            || selectedCreativeElements.HasFlag(CampaignVideoElement.AgentAvatar)
                ? portrait?.Id
                : null;
        var context = new VerticalRecommendationContext(
            portraitId,
            selectedCreativeElements.HasFlag(CampaignVideoElement.AgentAvatar) && selectedAgentAvatarConsent,
            selectedMarketingTemplate == CampaignMarketingTemplate.PriceDrop && selectedPriceReductionVerified
                ? selectedPriceReductionAmount
                : null);
        await using var scope = ScopeFactory.CreateAsyncScope();
        var plan = await scope.ServiceProvider.GetRequiredService<IVerticalCreativePlanningService>()
            .PlanAsync(userId, PropertyId, context, cancellationToken);
        var previous = verticalPicker;
        verticalPlan = plan;
        verticalPicker = plan is null ? null : new VerticalVideoPicker(plan.Recommendation);
        if (verticalPicker is null)
        {
            return;
        }

        if (previous is not null)
        {
            // Keep the agent's pick across a refresh; anything no longer eligible drops out.
            verticalPicker.Restore(VerticalVideoSelection.AgentChosen, previous.Chosen);
        }
        else if (restoreVerticalRequest is { } request)
        {
            verticalPicker.Restore(request.Selection, request.Formats);
        }
    }

    private async Task ReloadVerticalPlanAsync()
    {
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        await LoadVerticalPlanAsync(userId, pollingCancellation.Token);
    }

    private async Task ChooseGoal(VerticalCampaignGoal goal)
    {
        selectedGoal = goal;
        ApplyTemplate(VerticalFormatNames.TemplateFor(goal));
        // A confirmed price change can lift Price first, so the scores are worked out again.
        await ReloadVerticalPlanAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Focus is null || Focus == appliedFocus || !LibraryMode || verticalPlan is null)
        {
            return;
        }

        appliedFocus = Focus;
        var target = Focus.Equals("formats", StringComparison.OrdinalIgnoreCase) ? "vertical-formats" : "vertical-goal";
        try
        {
            await JSRuntime.InvokeVoidAsync("listingStudioCampaign.scrollToSection", target);
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, "Scrolling to the vertical workflow was unavailable.");
        }
    }

    private async Task RetryAsync() => await MutateAsync(async userId =>
    {
        if (job is not null && await Service.RetryAsync(userId, job.Id))
        {
            job = await Service.GetAsync(userId, job.Id);
        }
    });

    private async Task CancelAndStartOverAsync()
    {
        if (job is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Cancel this campaign and start over?",
            "Creative Listing Studio will stop this campaign and its automatic retries. Your property, Tour Map, photos, videos, narration, and profile remain saved. You will return to fresh campaign selections.",
            yesText: "Cancel and start over",
            cancelText: "Keep campaign");
        if (confirmed != true)
        {
            return;
        }

        await MutateAsync(async userId =>
        {
            if (job is not null && await Service.CancelAsync(userId, job.Id))
            {
                resetSelectionsWhenCancelled = true;
                await LoadAsync();
            }
        });
    }

