    private bool NoVideoElements => RequestedElements == CampaignVideoElement.None;

    // "Add a sound in the app" is silent on purpose; plain No music with no voiceover is usually a mistake.
    private bool SilentVerticalVideo => selectedOutputs.HasFlag(CampaignOutputSelection.TikTok)
        && selectedVoiceover == CampaignVoiceoverMode.None
        && selectedSoundtrack == CampaignSoundtrack.None;

    private bool TemplateReady =>
        (selectedMarketingTemplate != CampaignMarketingTemplate.PriceDrop
            || selectedPriceReductionAmount is > 0 and <= 100_000_000m && selectedPriceReductionVerified)
        && (selectedMarketingTemplate != CampaignMarketingTemplate.OpenHouse
            || !string.IsNullOrWhiteSpace(selectedOpenHouseText)
                && selectedOpenHouseText.Trim().Length <= CampaignCreativeOptions.MaximumOpenHouseTextLength
                && selectedOpenHouseVerified)
        && (!selectedCreativeElements.HasFlag(CampaignVideoElement.AgentAvatar) || selectedAgentAvatarConsent)
        && (selectedVideoStrategy != CampaignVideoStrategy.Kling4NativePresenter
            || portrait is not null
                && selectedCreativeElements.HasFlag(CampaignVideoElement.AgentAvatar)
                && selectedAgentAvatarConsent
                && NativePresenterBlockers.Count == 0);

    private async Task VideoStrategyChanged(CampaignVideoStrategy strategy)
    {
        selectedVideoStrategy = strategy;
        klingPreview = null;
        if (strategy != CampaignVideoStrategy.Kling4NativePresenter)
        {
            return;
        }

        // Kling only replaces the 30-second vertical video; a full voiceover makes that video 60 seconds.
        if (selectedVoiceover == CampaignVoiceoverMode.Full)
        {
            selectedVoiceover = CampaignVoiceoverMode.ShortHook;
        }

        if (KlingVideoSlots.Count > 0)
        {
            await FillMissingFormatScriptsAsync();
        }
        else if (string.IsNullOrWhiteSpace(presenterOpening)
            && string.IsNullOrWhiteSpace(presenterTour)
            && string.IsNullOrWhiteSpace(presenterClosing))
        {
            await UseSuggestedScriptAsync();
        }

        if (portrait is null)
        {
            error = "Add a profile headshot before choosing the Kling 4 native presenter.";
            return;
        }

        selectedCreativeElements &= ~CampaignVideoElement.AgentPortrait;
        selectedCreativeElements |= CampaignVideoElement.AgentAvatar;
    }

    private void ApplyTemplate(CampaignMarketingTemplate template)
    {
        selectedMarketingTemplate = template;
        if (template != CampaignMarketingTemplate.PriceDrop)
        {
            selectedPriceReductionAmount = null;
            selectedPriceReductionVerified = false;
        }

        if (template != CampaignMarketingTemplate.OpenHouse)
        {
            selectedOpenHouseText = null;
            selectedOpenHouseVerified = false;
        }

        // Placeholder details let the preset validate; the agent enters and confirms the real ones above.
        var preset = CampaignCreativeOptions.ForTemplate(
            template,
            portrait?.Id,
            template == CampaignMarketingTemplate.PriceDrop ? 1m : null,
            template == CampaignMarketingTemplate.PriceDrop,
            template == CampaignMarketingTemplate.OpenHouse ? "-" : null,
            template == CampaignMarketingTemplate.OpenHouse);
        selectedCreativeElements = preset.Elements;
        var kept = new List<string>();
        if (soundtrackChosen)
        {
            kept.Add("your music");
        }
        else
        {
            selectedSoundtrack = preset.Soundtrack;
        }

        if (captionStyleChosen)
        {
            kept.Add("your caption look");
        }
        else
        {
            selectedCaptionStyle = preset.CaptionStyle;
        }

        templateNote = $"{TemplateName(template)} set the on-screen elements"
            + (soundtrackChosen ? string.Empty : $", music ({SoundtrackName(selectedSoundtrack)})")
            + (captionStyleChosen ? string.Empty : $", caption look ({CaptionStyleName(selectedCaptionStyle)})")
            + (kept.Count == 0 ? "." : $" and kept {string.Join(" and ", kept)}.");
    }

    /// <summary>The tab's reusable choices, in the shape saved settings store them.</summary>
    private CampaignPresetSettings CurrentPresetSettings => new CampaignPresetSettings(
        selectedOutputs,
        selectedMarketingTemplate,
        selectedCreativeElements,
        selectedSoundtrack,
        selectedCaptionStyle,
        selectedPace,
        selectedVoiceover,
        selectedNarrationRegion,
        selectedSpokenLanguage,
        selectedCaptionLanguage,
        selectedVoiceAccent,
        selectedLocalizeAgentCard).Normalize();

    private CampaignPresetApplication ApplySavedSettings(CampaignSettingsPresetItem preset)
    {
        var application = CampaignPresetApplier.Apply(
            preset.Settings,
            preset.SkippedValues,
            new CampaignPresetContext(longFormAvailable, portrait is not null, profileIncludesPresenter, planIncludesPresenter));
        var settings = application.Settings;
        if (settings.MarketingTemplate != selectedMarketingTemplate)
        {
            // Listing facts belong to one template on one property, so a different template starts them empty.
            selectedPriceReductionAmount = null;
            selectedPriceReductionVerified = false;
            selectedOpenHouseText = null;
            selectedOpenHouseVerified = false;
        }

        selectedOutputs = settings.Outputs;
        selectedMarketingTemplate = settings.MarketingTemplate;
        selectedCreativeElements = settings.Elements;
        selectedSoundtrack = settings.Soundtrack;
        selectedCaptionStyle = settings.CaptionStyle;
        selectedPace = settings.Pace;
        selectedVoiceover = settings.Voiceover;
        selectedNarrationRegion = settings.NarrationRegion;
        selectedSpokenLanguage = settings.SpokenLanguage;
        selectedCaptionLanguage = settings.CaptionLanguage;
        selectedVoiceAccent = settings.VoiceAccent;
        selectedLocalizeAgentCard = settings.LocalizeAgentCard;
        selectedAgentAvatarConsent = application.AgentAvatarConsentConfirmed;
        // The saved music and caption look are the user's own choices, so switching template afterwards keeps them.
        soundtrackChosen = true;
        captionStyleChosen = true;
        templateNote = null;
        return application;
    }

