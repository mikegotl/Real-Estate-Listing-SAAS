    private static CampaignOutputSelection SharedVerticalSelection(CampaignOutputSelection selection)
    {
        const CampaignOutputSelection vertical = CampaignOutputSelection.TikTok
            | CampaignOutputSelection.InstagramReel
            | CampaignOutputSelection.YouTubeShort;
        return (selection & vertical) == 0
            ? selection
            : (selection & ~vertical) | CampaignOutputSelection.TikTok;
    }

