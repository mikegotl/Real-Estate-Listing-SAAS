@inherits OwningComponentBase<ICampaignGenerationService>
@using Microsoft.JSInterop
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPropertyMediaService MediaService
@inject IPropertyNarrationScriptService NarrationScriptService
@inject IAgentPortraitService AgentPortraitService
@inject IAgentProfileService AgentProfileService
@inject IAgentAvatarVideoService AgentAvatarVideoService
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<CampaignGenerationManager> Logger
@inject IJSRuntime JSRuntime

<MudPaper Class="pa-6 mt-6">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h2">Campaign</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">
                Generate, monitor, and download the complete video campaign.
            </MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.caption">
                Video narration is generated with an AI voice.
            </MudText>
        </div>
        @if (job is null || job.Status is CampaignGenerationStatus.Completed or CampaignGenerationStatus.Cancelled)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(busy || IsReadOnly || selectedOutputs == CampaignOutputSelection.None || !TemplateReady || NoTourPhotos)"
                       OnClick="GenerateAsync">
                @(job?.Status == CampaignGenerationStatus.Completed ? "Generate updated campaign" : "Generate campaign")
            </MudButton>
        }
    </MudStack>

    @if (job is null || job.Status is CampaignGenerationStatus.Completed or CampaignGenerationStatus.Cancelled)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">Choose your deliverables</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Listing Studio creates one verified story and narration, then produces only the formats you select.
                Standard formats count as one successful property campaign.
            </MudText>
            <MudGrid Spacing="2">
                @foreach (var option in OutputOptions)
                {
                    var unavailable = option.Selection == CampaignOutputSelection.FullNarratedTour && !longFormAvailable;
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-3 h-100">
                            <MudCheckBox T="bool"
                                         Value="@IsSelected(option.Selection)"
                                         ValueChanged="@(value => SetSelected(option.Selection, value))"
                                         Disabled="@(busy || IsReadOnly || unavailable)"
                                         Label="@option.Name"
                                         Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @option.Details
                            </MudText>
                            @if (unavailable)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Info">
                                    Accept a narration script, or use room-by-room narration, longer than @IPropertyNarrationScriptService.ShortFormWordLimit words to enable this format.
                                </MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
            @if (selectedOutputs == CampaignOutputSelection.None)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">
                    Choose at least one output before generating the campaign.
                </MudText>
            }
        </MudPaper>
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1">Creative direction</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Start with a marketing template, then customize its verified content, branding, and presentation.
                Each output gets a platform-specific edit instead of a simple crop.
            </MudText>
            <MudSelect T="CampaignMarketingTemplate"
                       Label="Marketing template"
                       Value="selectedMarketingTemplate"
                       ValueChanged="ApplyTemplate"
                       Variant="Variant.Outlined"
                       Disabled="@(busy || IsReadOnly)"
                       Class="mb-2">
                @foreach (var template in Enum.GetValues<CampaignMarketingTemplate>())
                {
                    <MudSelectItem Value="template">@TemplateName(template)</MudSelectItem>
                }
            </MudSelect>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                @TemplateDescription(selectedMarketingTemplate)
            </MudAlert>
            @if (templateNote is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3" data-testid="template-note">@templateNote</MudText>
            }
            @if (selectedMarketingTemplate == CampaignMarketingTemplate.PriceDrop)
            {
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?"
                                         Label="Price reduction amount"
                                         @bind-Value="selectedPriceReductionAmount"
                                         Min="0.01m"
                                         Max="100000000m"
                                         Format="C0"
                                         Variant="Variant.Outlined"
                                         Disabled="@(busy || IsReadOnly)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool"
                                     @bind-Value="selectedPriceReductionVerified"
                                     Disabled="@(busy || IsReadOnly)"
                                     Label="I confirm this price reduction is accurate and approved for marketing" />
                    </MudItem>
                </MudGrid>
                @if (!TemplateReady)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-3">
                        Enter the reduction amount and confirm it before generating this template.
                    </MudText>
                }
            }
            @if (selectedMarketingTemplate == CampaignMarketingTemplate.OpenHouse)
            {
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Open house day and time"
                                      Placeholder="Sat 1-3 PM"
                                      @bind-Value="selectedOpenHouseText"
                                      MaxLength="CampaignCreativeOptions.MaximumOpenHouseTextLength"
                                      Counter="CampaignCreativeOptions.MaximumOpenHouseTextLength"
                                      Variant="Variant.Outlined"
                                      Disabled="@(busy || IsReadOnly)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool"
                                     @bind-Value="selectedOpenHouseVerified"
                                     Disabled="@(busy || IsReadOnly)"
                                     Label="I confirm the open house day and time are accurate" />
                    </MudItem>
                </MudGrid>
                @if (!TemplateReady)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-3">
                        Enter the open house day and time and confirm them before generating this template.
                    </MudText>
                }
            }
            @if (roomNarration.HasNarration)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">Voiceover script</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                    You wrote narration for @(roomNarration.NarratedStopCount == 1 ? "1 room" : $"{roomNarration.NarratedStopCount} rooms")
                    on the walkthrough map (@roomNarration.WordCount words). Choose what the voice reads in the tour videos.
                </MudText>
                <MudSelect T="bool" Label="Narration" Value="roomNarration.IsInUse" ValueChanged="ChooseNarrationSourceAsync"
                           Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly || choosingNarration)" Class="mb-2"
                           data-testid="narration-source">
                    <MudSelectItem Value="true">Room-by-room narration from the walkthrough map</MudSelectItem>
                    <MudSelectItem Value="false">AI-generated script from the property story</MudSelectItem>
                </MudSelect>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                    @if (roomNarration.IsInUse)
                    {
                        <text>
                            Your words are read exactly as written, each starting as the tour reaches that room. The 30-second
                            short voiceover for TikTok, Reels and Shorts is still written from the property story.
                        </text>
                    }
                    else
                    {
                        <text>The tour videos read the AI script. Your room narration stays saved on the map.</text>
                    }
                </MudText>
                @if (roomNarration.IsInUse && roomNarration.WordCount > IPropertyNarrationScriptService.ShortFormWordLimit)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        At @roomNarration.WordCount words your narration is too long for a 60-second video, so those use the
                        AI script. Choose the full narrated tour to hear all of it, or shorten it to
                        @IPropertyNarrationScriptService.ShortFormWordLimit words.
                    </MudAlert>
                }
            }
            <MudText Typo="Typo.subtitle2" Class="mt-2">Sound</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                The music plays in every video you selected.
            </MudText>
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignSoundtrack" Label="Music" Value="selectedSoundtrack" ValueChanged="SetSoundtrack" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        <MudSelectItem Value="CampaignSoundtrack.AutoByHomeEra">Choose for the home's era</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.UpbeatLifestyle">Upbeat lifestyle</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.ModernAmbient">Modern ambient</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.HeritageWarm">Heritage warm</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.AddInApp">None, I'll add a sound in TikTok or Instagram</MudSelectItem>
                        <MudSelectItem Value="CampaignSoundtrack.None">No music</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (PreviewSoundtrack is { } previewSoundtrack)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Preview</MudText>
                        <audio controls preload="none" src="@($"/campaigns/soundtracks/{previewSoundtrack}")"
                               style="width:100%;" aria-label="Preview the selected music"></audio>
                    }
                    else if (selectedSoundtrack == CampaignSoundtrack.AutoByHomeEra)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Older homes get Heritage warm, mid-century homes Upbeat lifestyle, newer homes Modern ambient.
                        </MudText>
                    }
                    else if (selectedSoundtrack == CampaignSoundtrack.AddInApp)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            The videos have no music, so a trending sound you add in the app won't clash.
                        </MudText>
                    }
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.subtitle2" Class="mt-2">TikTok, Reels and Shorts</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                Short videos open with the price and location, cut on the music beat, and end on your contact card.
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignPace" Label="Style" @bind-Value="selectedPace" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        <MudSelectItem Value="CampaignPace.Fast">Fast cuts on the beat</MudSelectItem>
                        <MudSelectItem Value="CampaignPace.Cinematic">Cinematic glide</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignVoiceoverMode" Label="Voiceover" @bind-Value="selectedVoiceover" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        <MudSelectItem Value="CampaignVoiceoverMode.ShortHook">Short voiceover (30 seconds)</MudSelectItem>
                        <MudSelectItem Value="CampaignVoiceoverMode.None">Music and text only (30 seconds)</MudSelectItem>
                        <MudSelectItem Value="CampaignVoiceoverMode.Full">Full tour voiceover (60 seconds)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool"
                                 Value="@IsCreativeElementSelected(CampaignVideoElement.AgentContact)"
                                 ValueChanged="@(value => SetCreativeElement(CampaignVideoElement.AgentContact, value))"
                                 Disabled="@(busy || IsReadOnly)"
                                 Label="Show my name and phone on short videos" />
                </MudItem>
            </MudGrid>
            <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                <MudExpansionPanel Text="Advanced: on-screen elements and captions">
            <MudGrid Spacing="2">
                @foreach (var option in CreativeElementOptions)
                {
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool"
                                     Value="@IsCreativeElementSelected(option.Element)"
                                     ValueChanged="@(value => SetCreativeElement(option.Element, value))"
                                     Disabled="@(busy || IsReadOnly)"
                                     Label="@option.Name" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@option.Details</MudText>
                    </MudItem>
                }
            </MudGrid>
            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignCaptionStyle" Label="Caption look" Value="selectedCaptionStyle" ValueChanged="SetCaptionStyle" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        <MudSelectItem Value="CampaignCaptionStyle.Pop">Poppy social captions</MudSelectItem>
                        <MudSelectItem Value="CampaignCaptionStyle.Classic">Classic captions</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">Narration and captions</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                Choose the presentation region, spoken language, caption language, and voice accent. Region guides wording and pronunciation; it does not infer anyone's nationality.
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignNarrationRegion" Label="Narration region" @bind-Value="selectedNarrationRegion" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var region in Enum.GetValues<CampaignNarrationRegion>())
                        {
                            <MudSelectItem Value="region">@Display(region)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignLanguage" Label="Spoken language" @bind-Value="selectedSpokenLanguage" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var language in Enum.GetValues<CampaignLanguage>())
                        {
                            <MudSelectItem Value="language">@Display(language)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignLanguage" Label="Caption language" @bind-Value="selectedCaptionLanguage" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var language in Enum.GetValues<CampaignLanguage>())
                        {
                            <MudSelectItem Value="language">@Display(language)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CampaignVoiceAccent" Label="Voice accent" @bind-Value="selectedVoiceAccent" Variant="Variant.Outlined" Disabled="@(busy || IsReadOnly)">
                        @foreach (var accent in Enum.GetValues<CampaignVoiceAccent>())
                        {
                            <MudSelectItem Value="accent">@Display(accent)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                Accent is an AI voice direction and may vary by voice. Listing Studio always discloses that narration is AI-generated.
            </MudAlert>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">Agent presenter</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                Your private profile headshot can appear on the closing card or as an on-screen presenter while the disclosed AI voice narrates.
            </MudText>
            @if (portrait is not null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                    <img src="@($"/agent-portraits/{portrait.Id}")" alt="Agent photo preview" style="width:72px;height:72px;object-fit:cover;border-radius:50%;" />
                    <div>
                        <MudText Typo="Typo.caption">@portrait.OriginalFilename · @portrait.Width × @portrait.Height</MudText>
                        <MudLink Href="/profile" Typo="Typo.caption">Crop, replace, or AI-fix this headshot</MudLink>
                    </div>
                </MudStack>
            }
            else
            {
                <MudButton Href="/profile" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddAPhoto" Class="mt-2">
                    Add profile headshot
                </MudButton>
            }
            @if (selectedCreativeElements.HasFlag(CampaignVideoElement.AgentAvatar))
            {
                <MudCheckBox T="bool"
                             @bind-Value="selectedAgentAvatarConsent"
                             Disabled="@(busy || IsReadOnly)"
                             Label="I confirm this is my photo and I consent to its use as an AI presenter in this campaign" />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    @if (AgentAvatarVideoService.IsEnabled)
                    {
                        <span>Listing Studio will create short lip-synced opening and closing clips from your approved portrait and the selected AI narration. If the presenter provider is unavailable, the campaign continues with your static portrait.</span>
                    }
                    else
                    {
                        <span>Lip-sync is not enabled in this environment. The campaign will safely use your approved static portrait during the opening and closing while the selected AI voice narrates.</span>
                    }
                </MudAlert>
            }
            <MudCheckBox T="bool"
                         @bind-Value="selectedLocalizeAgentCard"
                         Disabled="@(busy || IsReadOnly || !(selectedCreativeElements.HasFlag(CampaignVideoElement.AgentPortrait) || selectedCreativeElements.HasFlag(CampaignVideoElement.AgentAvatar)))"
                         Label="Use the selected language and accent during the agent closing card" />
        </MudPaper>
    }
    else if (job.RequestedOutputs != CampaignOutputSelection.LegacyStandard)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
            Creating: @SelectedOutputNames(job.RequestedOutputs)
        </MudText>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
    }

    @if (refreshError is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@refreshError</MudAlert>
    }

    @if (failedAnalysisCount > 0 && job?.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Analysis failed for @failedAnalysisCount @(failedAnalysisCount == 1 ? "photo" : "photos"). Listing Studio is retrying,
            and the campaign will stop if a photo runs out of attempts. See Listing photos for details.
        </MudAlert>
    }

    @if (NoTourPhotos && !IsReadOnly)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Campaigns use only photos placed on the Tour Map. Place at least one photo in a stop on the
            <a href="@($"/properties/{PropertyId}?tab=media")">Media tab</a> to generate a campaign.
        </MudAlert>
    }

    @if (mediaCount is > 0 and < 3)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Only @mediaCount @(mediaCount == 1 ? "photo is" : "photos are") available. Listing Studio can create a conservative
            fallback plan, but at least three analyzed interior and exterior photos are recommended for a varied video.
        </MudAlert>
    }

    @if (job is null)
    {
        <MudText Typo="Typo.body1">No campaign has been generated yet.</MudText>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudChip T="string" Color="@StatusColor(job.Status)" Variant="Variant.Filled">
                @Display(job.Status)
            </MudChip>
            <MudText Typo="Typo.body2">@Display(job.CurrentStage)</MudText>
        </MudStack>
        <MudProgressLinear Value="job.ProgressPercent" Color="Color.Primary" Class="mb-4" />

        @if (!string.IsNullOrWhiteSpace(job.LastError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@DisplayError(job)</MudAlert>
        }

        <MudList T="CampaignStageResult" Dense="true" Class="mb-4">
            @foreach (var stage in job.Stages)
            {
                <MudListItem T="CampaignStageResult"
                             Icon="@StageIcon(stage.Status)"
                             IconColor="@StageColor(stage.Status)">
                    @Display(stage.Stage)
                    @if (stage.AttemptCount > 1)
                    {
                        <span> · attempt @stage.AttemptCount</span>
                    }
                </MudListItem>
            }
        </MudList>

        @if (job.Deliverables.Count > 0)
        {
            <MudGrid Spacing="2" Class="mb-4">
                @foreach (var deliverable in job.Deliverables)
                {
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.h6">@OutputName(deliverable.Kind)</MudText>
                            <MudText Class="mud-text-secondary" Typo="Typo.body2">
                                @deliverable.DurationSeconds seconds · @deliverable.AspectRatio · @Dimensions(deliverable.AspectRatio)
                            </MudText>
                            @if (deliverable.Status == CampaignDeliverableStatus.Rendered)
                            {
                                <video @key="@($"{deliverable.Kind}-{deliverable.Version}")"
                                       controls
                                       preload="metadata"
                                       style="width: 100%; margin-top: 1rem; border-radius: 4px;"
                                       aria-label="@($"Preview {deliverable.Kind} video")">
                                    <source src="@PreviewUrl(job.Id, deliverable.Kind, deliverable.Version)" type="video/mp4" />
                                    Your browser does not support MP4 video playback.
                                </video>
                                <MudButton Href="@DownloadUrl(job.Id, deliverable.Kind, deliverable.Version)"
                                           Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Class="mt-3">
                                    Download MP4
                                </MudButton>
                                @if (!IsReadOnly)
                                {
                                    <CampaignVideoChatPanel JobId="job.Id"
                                                            Kind="deliverable.Kind"
                                                            VideoName="@OutputName(deliverable.Kind)"
                                                            VersionChanged="LoadAsync" />
                                }
                            }
                            else
                            {
                                <MudProgressLinear Indeterminate="true" Class="mt-3" />
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (job.StillPosts.Count > 0)
        {
            <MudText Typo="Typo.h6" Class="mb-2">Still-image posts</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Download either feed-ready crop, or use Share on a supported phone to choose Facebook or another installed app.
            </MudText>
            @if (shareMessage is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@shareMessage</MudAlert>
            }
            <MudGrid Spacing="2" Class="mb-4">
                @foreach (var post in job.StillPosts)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.h6">@StillPostName(post.Kind)</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @post.Width × @post.Height · JPEG
                            </MudText>
                            @if (post.Status == CampaignStillPostStatus.Rendered)
                            {
                                <img src="@StillPostUrl(job.Id, post.Kind)"
                                     alt="@($"Preview {StillPostName(post.Kind)}")"
                                     style="width: 100%; margin-top: 1rem; border-radius: 4px;" />
                                <MudStack Row="true" Spacing="2" Class="mt-3" Style="flex-wrap: wrap;">
                                    <MudButton Href="@StillPostDownloadUrl(job.Id, post.Kind)"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary">
                                        Download JPEG
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               OnClick="@(() => CopyCaptionAsync(post.Caption))">
                                        Copy caption
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="@(() => ShareStillPostAsync(post))">
                                        Share
                                    </MudButton>
                                </MudStack>
                            }
                            else
                            {
                                <MudProgressLinear Indeterminate="true" Class="mt-3" />
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (job.Status == CampaignGenerationStatus.Completed)
        {
            <MudText Class="mud-text-secondary" Typo="Typo.overline">Short social caption</MudText>
            <MudText Typo="Typo.body1" Class="mb-3">@job.SocialCaptionShort</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.overline">Long social caption</MudText>
            <MudText Typo="Typo.body1">@job.SocialCaptionLong</MudText>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            @if (job.Status == CampaignGenerationStatus.Failed)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="RetryAsync">
                    Retry failed stage
                </MudButton>
            }
            @if (job.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="busy" OnClick="CancelAsync">
                    Cancel campaign
                </MudButton>
            }
            <MudButton Variant="Variant.Text" Disabled="busy" OnClick="LoadAsync">Refresh</MudButton>
        </MudStack>
    }
</MudPaper>

<FeatureSuggestionBox PropertyId="PropertyId"
                      ActiveCampaignId="@(job?.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running ? job.Id : null)" />

@code {
    [Parameter]
    public Guid PropertyId { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    /// <summary>Raised when the latest campaign's status changes, so the page can update its next step.</summary>
    [Parameter]
    public EventCallback StatusChanged { get; set; }

    private readonly CancellationTokenSource pollingCancellation = new();
    private CampaignGenerationResult? job;
    private bool busy;
    private bool pollingStarted;
    private string? error;
    private string? refreshError;
    private string? shareMessage;
    private int mediaCount;
    private bool mediaLoaded;
    private int failedAnalysisCount;
    private bool longFormAvailable;
    private AgentPortraitItem? portrait;
    private CampaignVideoElement selectedCreativeElements = CampaignCreativeOptions.SocialDefault.Elements;
    private CampaignSoundtrack selectedSoundtrack = CampaignCreativeOptions.SocialDefault.Soundtrack;
    private CampaignCaptionStyle selectedCaptionStyle = CampaignCreativeOptions.SocialDefault.CaptionStyle;
    private CampaignMarketingTemplate selectedMarketingTemplate = CampaignCreativeOptions.SocialDefault.MarketingTemplate;
    private decimal? selectedPriceReductionAmount;
    private bool selectedPriceReductionVerified;
    private CampaignNarrationRegion selectedNarrationRegion = CampaignNarrationPreferences.Default.Region;
    private CampaignLanguage selectedSpokenLanguage = CampaignNarrationPreferences.Default.SpokenLanguage;
    private CampaignLanguage selectedCaptionLanguage = CampaignNarrationPreferences.Default.CaptionLanguage;
    private CampaignVoiceAccent selectedVoiceAccent = CampaignNarrationPreferences.Default.VoiceAccent;
    private bool selectedLocalizeAgentCard = CampaignNarrationPreferences.Default.LocalizeAgentCard;
    private bool selectedAgentAvatarConsent;
    private bool soundtrackChosen;
    private RoomNarrationOverview roomNarration = RoomNarrationOverview.Empty;
    private bool choosingNarration;
    private bool captionStyleChosen;
    private string? templateNote;
    private CampaignPace selectedPace = CampaignCreativeOptions.SocialDefault.Pace;
    private CampaignVoiceoverMode selectedVoiceover = CampaignCreativeOptions.SocialDefault.Voiceover;
    private string? selectedOpenHouseText;
    private bool selectedOpenHouseVerified;
    private bool selectionInitialized;
    private Guid? loadedPropertyId;
    private CampaignOutputSelection selectedOutputs = CampaignOutputSelectionPolicy.Recommended;
    private bool statusLoaded;
    private CampaignGenerationStatus? reportedStatus;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedPropertyId != PropertyId)
        {
            loadedPropertyId = PropertyId;
            selectionInitialized = false;
            selectedOutputs = CampaignOutputSelectionPolicy.Recommended;
            soundtrackChosen = false;
            captionStyleChosen = false;
            templateNote = null;
            job = null;
            statusLoaded = false;
            reportedStatus = null;
        }

        await LoadAsync();
        StartPolling();
    }

    private async Task LoadAsync()
    {
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            job = await Service.GetLatestAsync(userId, PropertyId, pollingCancellation.Token);
            var script = await NarrationScriptService.GetAsync(userId, PropertyId, pollingCancellation.Token);
            var profile = await AgentProfileService.GetAsync(userId, pollingCancellation.Token);
            portrait = await AgentPortraitService.GetLatestAsync(userId, pollingCancellation.Token);
            roomNarration = await LoadRoomNarrationAsync(userId, pollingCancellation.Token);
            longFormAvailable = roomNarration.IsInUse
                ? roomNarration.WordCount > IPropertyNarrationScriptService.ShortFormWordLimit
                : script is { MarketingUseAccepted: true } && NarrationScriptPolicy.RequiresLongForm(script.ExtractedText);
            if (!selectionInitialized)
            {
                if (job is not null && job.RequestedOutputs != CampaignOutputSelection.LegacyStandard)
                {
                    selectedOutputs = SharedVerticalSelection(job.RequestedOutputs);
                }
                if (job is not null)
                {
                    // Kitchen island turnaround is hidden until it has a shot of its own.
                    selectedCreativeElements = job.CreativeOptions.Elements & ~CampaignVideoElement.KitchenIslandOrbit;
                    selectedSoundtrack = job.CreativeOptions.Soundtrack;
                    selectedCaptionStyle = job.CreativeOptions.CaptionStyle;
                    selectedMarketingTemplate = job.CreativeOptions.MarketingTemplate;
                    selectedPriceReductionAmount = job.CreativeOptions.PriceReductionAmount;
                    selectedPriceReductionVerified = job.CreativeOptions.PriceReductionVerified;
                    selectedAgentAvatarConsent = job.CreativeOptions.AgentAvatarConsentConfirmed;
                    selectedPace = job.CreativeOptions.Pace;
                    selectedVoiceover = job.CreativeOptions.Voiceover;
                    selectedOpenHouseText = job.CreativeOptions.OpenHouseText;
                    selectedOpenHouseVerified = job.CreativeOptions.OpenHouseVerified;
                    selectedNarrationRegion = job.NarrationPreferences.Region;
                    selectedSpokenLanguage = job.NarrationPreferences.SpokenLanguage;
                    selectedCaptionLanguage = job.NarrationPreferences.CaptionLanguage;
                    selectedVoiceAccent = job.NarrationPreferences.VoiceAccent;
                    selectedLocalizeAgentCard = job.NarrationPreferences.LocalizeAgentCard;
                }

                if (job?.Status is null or CampaignGenerationStatus.Completed or CampaignGenerationStatus.Cancelled)
                {
                    if (profile.IncludeAvatarInCampaigns && portrait is not null)
                    {
                        selectedCreativeElements &= ~CampaignVideoElement.AgentPortrait;
                        selectedCreativeElements |= CampaignVideoElement.AgentAvatar;
                        selectedAgentAvatarConsent = true;
                    }
                    else
                    {
                        selectedCreativeElements &= ~CampaignVideoElement.AgentAvatar;
                        selectedAgentAvatarConsent = false;
                    }
                }

                selectionInitialized = true;
            }
            if (!longFormAvailable)
            {
                selectedOutputs &= ~CampaignOutputSelection.FullNarratedTour;
            }
            var media = (await MediaService.ListAsync(userId, PropertyId, pollingCancellation.Token))
                .Where(item => item.IsOnTour)
                .ToArray();
            mediaCount = media.Length;
            mediaLoaded = true;
            failedAnalysisCount = media.Count(item => item.AnalysisStatus == PropertyMediaAnalysisStatus.Failed);
            error = null;
            refreshError = null;
            await ReportStatusAsync();
        }
        catch (OperationCanceledException) when (pollingCancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Refreshing campaign status for property {PropertyId} failed", PropertyId);
            refreshError = "Campaign status could not be refreshed. Listing Studio will keep trying.";
        }
    }

    // Room narration uses its own scope, so a choice made while the status poll runs never shares its DbContext.
    private async Task<RoomNarrationOverview> LoadRoomNarrationAsync(string userId, CancellationToken cancellationToken)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        return await scope.ServiceProvider.GetRequiredService<IRoomNarrationService>()
            .GetAsync(userId, PropertyId, cancellationToken);
    }

    private async Task ChooseNarrationSourceAsync(bool useRoomNarration)
    {
        choosingNarration = true;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            await using (var scope = ScopeFactory.CreateAsyncScope())
            {
                await scope.ServiceProvider.GetRequiredService<IRoomNarrationService>()
                    .ChooseSourceAsync(userId, PropertyId, useRoomNarration);
            }

            await LoadAsync();
        }
        finally
        {
            choosingNarration = false;
        }
    }

    private async Task GenerateAsync() => await MutateAsync(async userId =>
    {
        var elements = selectedCreativeElements;
        if (selectedSoundtrack is CampaignSoundtrack.None or CampaignSoundtrack.AddInApp)
        {
            elements &= ~CampaignVideoElement.BackgroundMusic;
        }
        else
        {
            elements |= CampaignVideoElement.BackgroundMusic;
        }

        var portraitId = elements.HasFlag(CampaignVideoElement.AgentPortrait)
            || elements.HasFlag(CampaignVideoElement.AgentAvatar)
                ? portrait?.Id
                : null;
        job = await Service.EnqueueAsync(
            userId,
            PropertyId,
            selectedOutputs,
            new CampaignCreativeOptions(
                elements,
                selectedSoundtrack,
                selectedCaptionStyle,
                portraitId,
                selectedMarketingTemplate,
                selectedPriceReductionAmount,
                selectedPriceReductionVerified,
                elements.HasFlag(CampaignVideoElement.AgentAvatar) && selectedAgentAvatarConsent,
                selectedPace,
                selectedVoiceover,
                selectedMarketingTemplate == CampaignMarketingTemplate.OpenHouse ? selectedOpenHouseText?.Trim() : null,
                selectedMarketingTemplate == CampaignMarketingTemplate.OpenHouse && selectedOpenHouseVerified),
            new CampaignNarrationPreferences(
                selectedNarrationRegion,
                selectedSpokenLanguage,
                selectedCaptionLanguage,
                selectedVoiceAccent,
                selectedLocalizeAgentCard));
    });

    private async Task RetryAsync() => await MutateAsync(async userId =>
    {
        if (job is not null && await Service.RetryAsync(userId, job.Id))
        {
            job = await Service.GetAsync(userId, job.Id);
        }
    });

    private async Task CancelAsync() => await MutateAsync(async userId =>
    {
        if (job is not null && await Service.CancelAsync(userId, job.Id))
        {
            job = await Service.GetAsync(userId, job.Id);
        }
    });

    private async Task MutateAsync(Func<string, Task> action)
    {
        busy = true;
        error = null;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            await action(userId);
            if (job is null)
            {
                error = "Property not found or unavailable to your organization.";
            }

            await ReportStatusAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or InvalidDataException)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    // The first load only records the status; later changes tell the page.
    private async Task ReportStatusAsync()
    {
        var status = job?.Status;
        if (statusLoaded && status == reportedStatus)
        {
            return;
        }

        var notify = statusLoaded;
        statusLoaded = true;
        reportedStatus = status;
        if (notify)
        {
            await StatusChanged.InvokeAsync();
        }
    }

    private void StartPolling()
    {
        if (pollingStarted)
        {
            return;
        }

        pollingStarted = true;
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(pollingCancellation.Token))
            {
                if (job?.Status is CampaignGenerationStatus.Queued or CampaignGenerationStatus.Running)
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadAsync();
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException) when (pollingCancellation.IsCancellationRequested)
        {
        }
    }

    protected override async ValueTask DisposeAsyncCore()
    {
        pollingCancellation.Cancel();
        pollingCancellation.Dispose();
        await base.DisposeAsyncCore();
    }

    // The version keeps the browser from playing or saving a cached copy of an earlier version of the video.
    private static string DownloadUrl(Guid jobId, CampaignOutputKind kind, int version) =>
        $"/campaigns/{jobId}/deliverables/{kind}?download=true&v={version}";

    private static string PreviewUrl(Guid jobId, CampaignOutputKind kind, int version) =>
        $"/campaigns/{jobId}/deliverables/{kind}?v={version}";

    private static string StillPostUrl(Guid jobId, CampaignStillPostKind kind) =>
        $"/campaigns/{jobId}/still-posts/{kind}";

    private static string StillPostDownloadUrl(Guid jobId, CampaignStillPostKind kind) =>
        $"/campaigns/{jobId}/still-posts/{kind}?download=true";

    private async Task CopyCaptionAsync(string caption)
    {
        var copied = await JSRuntime.InvokeAsync<bool>("listingStudioCampaign.copyText", caption);
        shareMessage = copied
            ? "Caption copied."
            : "Copy is unavailable in this browser. Select the caption text below instead.";
    }

    private async Task ShareStillPostAsync(CampaignStillPostResult post)
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<string>(
                "listingStudioCampaign.shareStillPost",
                StillPostUrl(job!.Id, post.Kind),
                post.Caption,
                $"listing-studio-{post.Kind.ToString().ToLowerInvariant()}.jpg");
            shareMessage = result switch
            {
                "shared" => "The image was sent to your device's share menu.",
                "copied" => "This browser cannot share image files, so the caption was copied. Download the JPEG and attach it to your Facebook post.",
                _ => "Sharing is unavailable in this browser. Download the JPEG and copy the caption instead.",
            };
        }
        catch (JSException exception)
        {
            Logger.LogInformation(exception, "Still-post sharing was dismissed or unavailable.");
            shareMessage = "Sharing was cancelled or is unavailable. The JPEG and caption are still ready to download and copy.";
        }
    }

    private static string Display(Enum value) => string.Concat(value.ToString().Select((character, index) =>
        index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString()));

    private static readonly OutputOption[] OutputOptions =
    [
        new(CampaignOutputSelection.TikTok, "Vertical video for TikTok, Reels and Shorts", "Vertical 1080 × 1920 · 30 seconds (60 with the full voiceover) · price hook, beat-cut edit, contact card. One file to post on all three."),
        new(CampaignOutputSelection.YouTubeTour, "YouTube property tour", "Horizontal 1920 × 1080 · approximately 60 seconds · logical walkthrough order."),
        new(CampaignOutputSelection.FacebookFeed, "Facebook Feed", "Horizontal 1920 × 1080 · approximately 30 seconds · feed-ready highlights with the long social caption as post copy."),
        new(CampaignOutputSelection.FacebookStillPost, "Facebook still-image post", "Two feed-ready JPEGs · square 1080 × 1080 and portrait 1080 × 1350 · includes generated post copy."),
        new(CampaignOutputSelection.FullNarratedTour, "Full narrated tour", "Horizontal 1920 × 1080 · duration follows the complete accepted script."),
    ];

    private bool IsSelected(CampaignOutputSelection selection) => selectedOutputs.HasFlag(selection);

    private void SetSelected(CampaignOutputSelection selection, bool selected)
    {
        selectedOutputs = selected
            ? selectedOutputs | selection
            : selectedOutputs & ~selection;
    }

    private CampaignSoundtrack? PreviewSoundtrack => selectedSoundtrack
        is CampaignSoundtrack.HeritageWarm or CampaignSoundtrack.ModernAmbient or CampaignSoundtrack.UpbeatLifestyle
            ? selectedSoundtrack
            : null;

    private bool IsCreativeElementSelected(CampaignVideoElement element) => selectedCreativeElements.HasFlag(element);

    private bool NoTourPhotos => mediaLoaded && mediaCount == 0;

    private bool TemplateReady =>
        (selectedMarketingTemplate != CampaignMarketingTemplate.PriceDrop
            || selectedPriceReductionAmount is > 0 and <= 100_000_000m && selectedPriceReductionVerified)
        && (selectedMarketingTemplate != CampaignMarketingTemplate.OpenHouse
            || !string.IsNullOrWhiteSpace(selectedOpenHouseText)
                && selectedOpenHouseText.Trim().Length <= CampaignCreativeOptions.MaximumOpenHouseTextLength
                && selectedOpenHouseVerified)
        && (!selectedCreativeElements.HasFlag(CampaignVideoElement.AgentAvatar) || selectedAgentAvatarConsent);

    private void ApplyTemplate(CampaignMarketingTemplate template)
    {
        selectedMarketingTemplate = template;
        if (template != CampaignMarketingTemplate.PriceDrop)
        {
            selectedPriceReductionAmount = null;
            selectedPriceReductionVerified = false;
        }

        if (template != CampaignMarketingTemplate.OpenHouse)
        {
            selectedOpenHouseText = null;
            selectedOpenHouseVerified = false;
        }

        // Placeholder details let the preset validate; the agent enters and confirms the real ones above.
        var preset = CampaignCreativeOptions.ForTemplate(
            template,
            portrait?.Id,
            template == CampaignMarketingTemplate.PriceDrop ? 1m : null,
            template == CampaignMarketingTemplate.PriceDrop,
            template == CampaignMarketingTemplate.OpenHouse ? "-" : null,
            template == CampaignMarketingTemplate.OpenHouse);
        selectedCreativeElements = preset.Elements;
        var kept = new List<string>();
        if (soundtrackChosen)
        {
            kept.Add("your music");
        }
        else
        {
            selectedSoundtrack = preset.Soundtrack;
        }

        if (captionStyleChosen)
        {
            kept.Add("your caption look");
        }
        else
        {
            selectedCaptionStyle = preset.CaptionStyle;
        }

        templateNote = $"{TemplateName(template)} set the on-screen elements"
            + (soundtrackChosen ? string.Empty : $", music ({SoundtrackName(selectedSoundtrack)})")
            + (captionStyleChosen ? string.Empty : $", caption look ({CaptionStyleName(selectedCaptionStyle)})")
            + (kept.Count == 0 ? "." : $" and kept {string.Join(" and ", kept)}.");
    }

    private void SetSoundtrack(CampaignSoundtrack soundtrack)
    {
        selectedSoundtrack = soundtrack;
        soundtrackChosen = true;
    }

    private void SetCaptionStyle(CampaignCaptionStyle captionStyle)
    {
        selectedCaptionStyle = captionStyle;
        captionStyleChosen = true;
    }

    /// <summary>
    /// TikTok, Reels and Shorts are one edit, so a campaign that asked for any of them makes the single vertical video.
    /// </summary>
    private static CampaignOutputSelection SharedVerticalSelection(CampaignOutputSelection selection)
    {
        const CampaignOutputSelection vertical = CampaignOutputSelection.TikTok
            | CampaignOutputSelection.InstagramReel
            | CampaignOutputSelection.YouTubeShort;
        return (selection & vertical) == 0
            ? selection
            : (selection & ~vertical) | CampaignOutputSelection.TikTok;
    }

    private static string SoundtrackName(CampaignSoundtrack soundtrack) => soundtrack switch
    {
        CampaignSoundtrack.AutoByHomeEra => "chosen for the home's era",
        CampaignSoundtrack.UpbeatLifestyle => "Upbeat lifestyle",
        CampaignSoundtrack.ModernAmbient => "Modern ambient",
        CampaignSoundtrack.HeritageWarm => "Heritage warm",
        CampaignSoundtrack.AddInApp => "added in the app",
        CampaignSoundtrack.None => "no music",
        _ => Display(soundtrack),
    };

    private static string CaptionStyleName(CampaignCaptionStyle captionStyle) => captionStyle switch
    {
        CampaignCaptionStyle.Pop => "poppy",
        CampaignCaptionStyle.Classic => "classic",
        _ => Display(captionStyle),
    };

    private void SetCreativeElement(CampaignVideoElement element, bool selected)
    {
        selectedCreativeElements = selected
            ? selectedCreativeElements | element
            : selectedCreativeElements & ~element;
        if (element is CampaignVideoElement.AgentPortrait or CampaignVideoElement.AgentAvatar
            && selected
            && portrait is null)
        {
            selectedCreativeElements &= ~element;
            error = "Add a profile headshot before adding an agent presenter to the video.";
        }

        if (element == CampaignVideoElement.AgentAvatar && !selected)
        {
            selectedAgentAvatarConsent = false;
        }

    }

    private static string SelectedOutputNames(CampaignOutputSelection selection) => string.Join(", ",
        Enum.GetValues<CampaignOutputSelection>()
            .Where(item => item is not CampaignOutputSelection.None and not CampaignOutputSelection.LegacyStandard
                && selection.HasFlag(item))
            .Select(item => item == CampaignOutputSelection.FacebookStillPost
                ? "Facebook still-image post"
                : OutputName(Enum.Parse<CampaignOutputKind>(item.ToString()))));

    private static string StillPostName(CampaignStillPostKind kind) => kind switch
    {
        CampaignStillPostKind.FacebookSquare => "Facebook square post",
        CampaignStillPostKind.FacebookPortrait => "Facebook portrait post",
        _ => Display(kind),
    };

    private static string OutputName(CampaignOutputKind kind) => kind switch
    {
        CampaignOutputKind.TikTok => "Vertical video for TikTok, Reels and Shorts",
        CampaignOutputKind.InstagramReel => "Instagram Reel",
        CampaignOutputKind.YouTubeShort => "YouTube Short",
        CampaignOutputKind.YouTubeTour => "YouTube property tour",
        CampaignOutputKind.FacebookFeed => "Facebook Feed",
        CampaignOutputKind.FullNarratedTour => "Full narrated tour",
        CampaignOutputKind.Hero => "HERO",
        CampaignOutputKind.Feature => "FEATURE",
        CampaignOutputKind.Teaser => "TEASER",
        CampaignOutputKind.LongForm => "LONG FORM",
        _ => Display(kind),
    };

    private static string Dimensions(string aspectRatio) =>
        aspectRatio == "16:9" ? "1920 × 1080" : "1080 × 1920";

    private sealed record OutputOption(CampaignOutputSelection Selection, string Name, string Details);

    private static readonly CreativeElementOption[] CreativeElementOptions =
    [
        new(CampaignVideoElement.OpeningTitle, "Opening title", "Bold, location-led opening like the reference edit."),
        new(CampaignVideoElement.PropertyFacts, "Property facts", "Verified facts only, shown as compact feature callouts."),
        new(CampaignVideoElement.NarrationCaptions, "Narration captions", "Short, timed caption bursts designed for mobile viewing."),
        new(CampaignVideoElement.NeighborhoodHighlights, "Neighborhood highlights", "Approved neighborhood facts and licensed images."),
        new(CampaignVideoElement.WalkthroughMotion, "Use walkthrough video and AI walk-through clips", "Play your walkthrough videos and finished AI walk-through clips. Turn this off for photos only."),
        new(CampaignVideoElement.AgentPortrait, "Agent photo on closing card", "Place the uploaded agent photo beside the final call to action."),
        new(CampaignVideoElement.AgentAvatar, "AI agent presenter", "Create short lip-synced opening and closing clips from the approved profile headshot, with a static-photo fallback."),
        new(CampaignVideoElement.ClosingCallToAction, "Closing call to action", "End with the campaign's verified contact call to action."),
    ];

    private sealed record CreativeElementOption(CampaignVideoElement Element, string Name, string Details);

    private static string TemplateName(CampaignMarketingTemplate template) => template switch
    {
        CampaignMarketingTemplate.BalancedShowcase => "Balanced showcase",
        CampaignMarketingTemplate.PriceDrop => "Price-drop announcement",
        CampaignMarketingTemplate.QuickTour => "Fast social tour",
        CampaignMarketingTemplate.FeatureSpotlight => "Feature spotlight",
        CampaignMarketingTemplate.AgentShowcase => "Agent-branded showcase",
        CampaignMarketingTemplate.JustListed => "Just listed",
        CampaignMarketingTemplate.OpenHouse => "Open house",
        _ => Display(template),
    };

    private static string TemplateDescription(CampaignMarketingTemplate template) => template switch
    {
        CampaignMarketingTemplate.BalancedShowcase =>
            "A polished all-purpose edit with verified facts, narration, captions, music, and a clear call to action.",
        CampaignMarketingTemplate.PriceDrop =>
            "Leads with an agent-confirmed reduction amount, then moves through the strongest property highlights.",
        CampaignMarketingTemplate.QuickTour =>
            "A fast, cut-driven room tour for short-form feeds with minimal on-screen clutter.",
        CampaignMarketingTemplate.FeatureSpotlight =>
            "Prioritizes verified property and approved neighborhood features for buyers comparing details.",
        CampaignMarketingTemplate.AgentShowcase =>
            "Keeps the listing central while strengthening the agent identity and closing contact card.",
        CampaignMarketingTemplate.JustListed =>
            "Opens with a bold JUST LISTED banner over the price, city, and beds and baths.",
        CampaignMarketingTemplate.OpenHouse =>
            "Opens with an OPEN HOUSE banner and the day and time you confirm, then the price and city.",
        _ => string.Empty,
    };

    private static string DisplayError(CampaignGenerationResult campaign) =>
        campaign.CurrentStage == CampaignGenerationStage.GenerateMasterVideoPlan
        && campaign.LastError == "A campaign provider returned invalid data."
            ? "Listing Studio could not validate the generated master video plan. Retry the failed stage to use guided repair and the single-photo fallback, or add more analyzed interior and exterior photos for a more varied result."
            : campaign.CurrentStage == CampaignGenerationStage.GenerateNarration
              && campaign.LastError == "Voice:Provider must be ElevenLabs for narration generation."
                ? "Narration was not configured when this attempt ran. Retry the failed stage to generate narration with the configured OpenAI voice."
            : campaign.CurrentStage == CampaignGenerationStage.GenerateNarration
              && campaign.LastError == "A campaign provider returned invalid data."
                ? "Listing Studio could not process the narration audio returned by OpenAI. The audio-format handling has been updated; retry the failed stage."
            : campaign.LastError!;

    private static Color StatusColor(CampaignGenerationStatus status) => status switch
    {
        CampaignGenerationStatus.Completed => Color.Success,
        CampaignGenerationStatus.Failed => Color.Error,
        CampaignGenerationStatus.Cancelled => Color.Warning,
        _ => Color.Primary,
    };

    private static Color StageColor(CampaignStageStatus status) => status switch
    {
        CampaignStageStatus.Completed => Color.Success,
        CampaignStageStatus.Failed => Color.Error,
        CampaignStageStatus.Cancelled => Color.Warning,
        CampaignStageStatus.Running => Color.Primary,
        _ => Color.Default,
    };

    private static string StageIcon(CampaignStageStatus status) => status switch
    {
        CampaignStageStatus.Completed => Icons.Material.Filled.CheckCircle,
        CampaignStageStatus.Failed => Icons.Material.Filled.Error,
        CampaignStageStatus.Cancelled => Icons.Material.Filled.Cancel,
        CampaignStageStatus.Running => Icons.Material.Filled.PlayCircle,
        _ => Icons.Material.Filled.RadioButtonUnchecked,
    };
}
