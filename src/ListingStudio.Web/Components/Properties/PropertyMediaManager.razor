    // Shares this component's scope: its calls never overlap the media service's, which run one at a time too.
    private IRoomNarrationService RoomNarrations => ScopedServices.GetRequiredService<IRoomNarrationService>();

    private async Task SetStopNarrationAsync((string Stop, string? Text) change)
    {
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            if (!await RoomNarrations.SetAsync(userId, PropertyId, change.Stop, change.Text))
            {
                return;
            }

            roomNarration = await RoomNarrations.GetAsync(userId, PropertyId);
            if (change.Text is not null && roomNarration.UseRoomNarration is null)
            {
                // Asked once, on the first narration saved: it replaces the AI script in every campaign video.
                var useRoomNarration = await DialogService.ShowMessageBoxAsync(
                    "Use your narration in place of the AI script?",
                    "Campaign videos will read what you write for each room, in walkthrough order, instead of the "
                    + "AI-written script from the property story. Rooms without narration play without a voiceover. "
                    + "You can switch back at any time on the Campaign tab.",
                    yesText: "Use my narration",
                    noText: "Keep the AI script",
                    cancelText: "Decide later");
                if (useRoomNarration is { } choice)
                {
                    await RoomNarrations.ChooseSourceAsync(userId, PropertyId, choice);
                    roomNarration = await RoomNarrations.GetAsync(userId, PropertyId);
                }
            }

            ShowMessage(
                change.Text is null
                    ? $"Removed the narration for {change.Stop}."
                    : roomNarration.IsInUse
                        ? $"Saved the narration for {change.Stop}. Campaign videos will read it as the tour reaches that stop."
                        : $"Saved the narration for {change.Stop}. Campaign videos use the AI script until you choose room-by-room narration on the Campaign tab.",
                Severity.Success);
        }
        catch (ArgumentOutOfRangeException exception)
        {
            ShowMessage(exception.Message, Severity.Error);
        }
    }

    private async Task ReloadAfterChangeAsync()
    {
        await LoadAsync();
        await MediaChanged.InvokeAsync();
    }

    private async Task FilesSelectedAsync(InputFileChangeEventArgs eventArgs, string? stop, bool toGallery = false)
    {
        message = null;
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = eventArgs.GetMultipleFiles(IPropertyMediaService.MaximumMediaPerProperty);
        }
        catch (InvalidOperationException)
        {
            ShowMessage($"Select no more than {IPropertyMediaService.MaximumMediaPerProperty} images at once.", Severity.Error);
            return;
        }

        if (media.Count + files.Count > IPropertyMediaService.MaximumMediaPerProperty)
        {
            ShowMessage(
                $"These files would exceed the {IPropertyMediaService.MaximumMediaPerProperty}-image property limit.",
                Severity.Error);
            return;
        }

        var selected = files.Select(file => new UploadState(file, stop, toGallery)).ToArray();
        uploads.AddRange(selected);
        foreach (var upload in selected)
        {
            await UploadOneAsync(upload);
        }
    }

    private async Task UploadOneAsync(UploadState upload)
    {
        upload.Failed = false;
        upload.Error = null;
        upload.Progress = 0;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            var source = upload.File.OpenReadStream(IPropertyMediaService.MaximumFileSize);
            await using var progressStream = new ProgressReadStream(source, upload.File.Size, bytes =>
            {
                upload.Progress = upload.File.Size == 0 ? 0 : (double)bytes / upload.File.Size * 100;
                _ = InvokeAsync(StateHasChanged);
            });
            await Service.UploadAsync(
                userId,
                PropertyId,
                new PropertyMediaUpload(
                    upload.File.Name,
                    upload.File.ContentType,
                    upload.File.Size,
                    progressStream,
                    upload.Stop,
                    upload.ToGallery));
            upload.Progress = 100;
            uploads.Remove(upload);
            await ReloadAfterChangeAsync();
            ShowMessage(
                upload.ToGallery ? "Photo added to extra photos." :upload.Stop is null ? "Photo uploaded." : $"Photo added to {upload.Stop}.",
                Severity.Success);
        }
        catch (Exception exception) when (exception is InvalidDataException or InvalidOperationException or IOException)
        {
            upload.Failed = true;
            upload.Error = exception.Message;
            ShowMessage("One or more photos could not be uploaded. Correct the issue and retry.", Severity.Error);
        }
    }

    private async Task DeleteAsync(Guid mediaId)
    {
        var inWalkthrough = media.Any(item => item.Id == mediaId && !item.IsInGallery);
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete this photo?",
            inWalkthrough
                ? "The photo is removed from the listing, along with any walk-through clips made from it. This cannot be undone."
                : "The photo is removed from extra photos. This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        if (await Service.DeleteAsync(userId, PropertyId, mediaId))
        {
            await ReloadAfterChangeAsync();
            ShowMessage("Photo deleted.", Severity.Success);
        }
    }

