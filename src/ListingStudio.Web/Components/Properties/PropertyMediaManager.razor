@inherits OwningComponentBase<IPropertyMediaService>
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject IDialogService DialogService
@inject PhotoAssistantSelectionState PhotoAssistantState
@inject Microsoft.Extensions.Options.IOptions<MediaAnalysisOptions> MediaAnalysisOptions

<MudPaper Class="pa-6 mt-6 storyboard">
    <div class="storyboard-header">
        <div>
            <p class="storyboard-eyebrow">Tour map</p>
            <MudText Typo="Typo.h5" HtmlTag="h2">Plan the buyer's route</MudText>
            <MudText Typo="Typo.body2" Class="storyboard-intro">
                Build one intentional tour, starting at the front of the property. Each room owns its approved photos,
                walking direction, photo fixes and narration. Only photos placed on this map can be used in campaign videos.
            </MudText>
        </div>
        @if (loaded)
        {
            <div class="storyboard-count" aria-label="Photo count">
                <strong>@media.Count</strong>
                <span>of @IPropertyMediaService.MaximumMediaPerProperty photos</span>
            </div>
        }
    </div>
    <MudText Typo="Typo.caption" Class="storyboard-limits">
        JPG, PNG, or WEBP images up to @(IPropertyMediaService.MaximumFileSize / 1024 / 1024) MB each.
    </MudText>

    @if (loaded)
    {
        @* Plain DOM scrolling: the tab's URL carries ?tab=media, so fragment links would navigate away from it. *@
        <nav class="media-nav" aria-label="Media sections">
            <button type="button" onclick="document.getElementById('media-walkthrough')?.scrollIntoView({behavior: 'smooth'})">
                Tour map <span class="media-nav-count">@WalkthroughPhotoCount</span>
            </button>
            <button type="button" onclick="document.getElementById('media-extra')?.scrollIntoView({behavior: 'smooth'})">
                Not in tour <span class="media-nav-count @(unsorted.Count > 0 ? "attention" : null)">@(unsorted.Count + gallery.Count)</span>
            </button>
            <button type="button" onclick="document.getElementById('listing-videos')?.scrollIntoView({behavior: 'smooth'})">Videos</button>
        </nav>
    }

    @if (message is not null)
    {
        <MudAlert Severity="@messageSeverity" Class="my-4">@message</MudAlert>
    }

    @if (loaded && ShowWalkthroughPanel)
    {
        <section class="walkthrough-panel" aria-labelledby="walkthrough-heading">
            <MudIcon Icon="@Icons.Material.Filled.DirectionsWalk" Class="walkthrough-panel-icon" />
            <div class="walkthrough-panel-body">
                <h3 id="walkthrough-heading">AI walk-through clips</h3>
                <p>
                    A short clip walks the camera from each shot into the next one, using the two photos as its first and
                    last frames. Press play on a shot to watch the walk into the following shot. Finished clips also play
                    between those photos in the campaign video.
                </p>
                @if (transitionService?.IsEnabled == true && transitions.Values.Any(item => item.Status is not null))
                {
                    <p>
                        When you add or replace a photo, reorder shots, or change a direction on the map, only the clips
                        that change are made again, automatically.
                    </p>
                }
                <span class="walkthrough-panel-count">@ReadyTransitionCount of @transitions.Count walk-throughs ready@(InProgressTransitionCount > 0 ? $" · {InProgressTransitionCount} generating" : "")</span>
            </div>
            @if (!IsReadOnly && transitionService?.IsEnabled == true)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(queueing || MissingTransitionCount == 0)"
                           StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="QueueTransitionsAsync">
                    @(MissingTransitionCount == 0 ? "All walk-throughs requested" : $"Create {MissingTransitionCount} walk-through {(MissingTransitionCount == 1 ? "clip" : "clips")}")
                </MudButton>
            }
        </section>
    }

    @foreach (var upload in uploads)
    {
        <MudPaper Outlined="true" Class="pa-3 my-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText>@upload.File.Name <span class="storyboard-upload-stop">→ @(upload.ToGallery ? "Extra photos" : upload.Stop ?? "Storyboard")</span></MudText>
                @if (upload.Failed)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                               OnClick="@(() => UploadOneAsync(upload))">Retry upload</MudButton>
                }
            </MudStack>
            <MudProgressLinear Value="upload.Progress" Color="@(upload.Failed ? Color.Error : Color.Primary)" />
            @if (upload.Error is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@upload.Error</MudText>
            }
        </MudPaper>
    }

    @if (!loaded)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-4" />
    }
    else
    {
        @if (IsReadOnly && media.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">No listing photos have been uploaded.</MudAlert>
        }

        @if (!IsReadOnly && media.Count > 0)
        {
            <p class="storyboard-tip">
                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" />
                Shoot each space from the doorway you enter by, so the video flows from one room to the next.
            </p>
        }

        <section class="tour-map-workspace" id="media-walkthrough">
            @if (!HasExteriorFront)
            {
                <div class="tour-map-empty">
                    <div class="tour-map-empty-icon"><MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" /></div>
                    <div>
                        <span class="stop-step">Stop 1 · Required</span>
                        <h3>Exterior Front</h3>
                        <p>Start with the front of the property. This becomes the opening shot and anchors every room that follows.</p>
                    </div>
                    @if (!IsReadOnly)
                    {
                        <label class="media-upload-control tour-map-empty-upload">
                            <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" />
                            <span>Upload exterior front</span>
                            <InputFile OnChange="@(eventArgs => FilesSelectedAsync(eventArgs, WalkthroughStoryboard.ExteriorFront))" multiple
                                       aria-label="Upload exterior front photos"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        </label>
                    }
                </div>
            }
            @if (MapStops.Count > 0)
            {
                <PropertyWalkthroughMap Stops="MapStops" Directions="directions" Transitions="transitions" IsReadOnly="IsReadOnly"
                                        DirectionChanged="SetStopDirectionAsync" StopMoved="MoveMapStopAsync"
                                        FixedStopCount="FixedMapStopCount" FocusStop="@mapFocusStop" FocusRequest="mapFocusRequest"
                                        Narration="roomNarration"
                                        NarrationChanged="SetStopNarrationAsync" StopMedia="TourStopMedia" />
            }

            @if (!IsReadOnly)
            {
                @foreach (var pending in stops.Where(stop => stop.Items.Count == 0
                    && !SameStop(stop.Name, WalkthroughStoryboard.ExteriorFront)))
                {
                    <div class="tour-map-pending">
                        <div>
                            <span class="stop-step">New stop</span>
                            <h4>@pending.Name</h4>
                            <p>Add a photo to place this stop on the Tour Map. Empty stops aren't saved, so this one disappears if you leave or reload the page first.</p>
                        </div>
                        <label class="media-upload-control stop-upload">
                            <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" />
                            <span>Add @pending.Name.ToLowerInvariant() photos</span>
                            <InputFile OnChange="@(eventArgs => FilesSelectedAsync(eventArgs, pending.Name))" multiple
                                       aria-label="@($"Add photos to {pending.Name}")"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        </label>
                        @if (!pending.IsTemplate)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           aria-label="@($"Remove the empty {pending.Name} stop")"
                                           OnClick="@(() => RemovePendingStop(pending.Name))" />
                        }
                    </div>
                }

                <div class="tour-map-add-stop">
                    <div>
                        <span class="stop-step">Continue the route</span>
                        <h3>Where does the buyer go next?</h3>
                    </div>
                    <div class="next-stop-suggestions">
                        @foreach (var suggestion in WalkthroughStoryboard.SuggestedStops.Where(IsUnusedStop))
                        {
                            <button type="button" class="stop-suggestion" @onclick="@(() => AddStop(suggestion))">
                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />@suggestion
                            </button>
                        }
                    </div>
                    <div class="next-stop-custom">
                        <MudTextField T="string" @bind-Value="customStopName" Label="Other room or area"
                                      Placeholder="Sunroom, wine cellar, guest suite…" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" MaxLength="PropertyMedia.MaximumWalkthroughStopLength"
                                      OnKeyDown="CustomStopKeyDownAsync" Immediate="true" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   Disabled="@string.IsNullOrWhiteSpace(customStopName)"
                                   OnClick="@(() => AddStop(customStopName))">Add stop</MudButton>
                    </div>
                </div>
            }
        </section>

        @if (unsorted.Count > 0)
        {
            <section class="storyboard-unsorted" id="media-unplaced" aria-labelledby="unsorted-heading">
                <h3 id="unsorted-heading">Not in tour: Unsorted photos</h3>
                <p class="stop-hint">
                    These photos are held outside the Tour Map and are excluded from campaign videos. Use Add to stop to
                    choose exactly where each photo belongs.
                </p>
                <div class="stop-strip">
                    @for (var index = 0; index < unsorted.Count; index++)
                    {
                        @PhotoCard((unsorted, index, null))
                    }
                </div>
            </section>
        }

        <section class="photo-gallery" id="media-extra" aria-labelledby="gallery-heading">
            <div class="photo-gallery-head">
                <div>
                    <h3 id="gallery-heading">Not in tour: Extra photos <span class="photo-gallery-count">@gallery.Count</span></h3>
                    <p class="stop-hint">
                        Photos kept here are excluded from the Tour Map, clips and every campaign video. Use Add to stop
                        only when you intentionally want a photo in the tour.
                        @if (MediaAnalysisOptions.Value.Enabled)
                        {
                            @(" Use Find room photos on a listing video to add the best shots of each room here.")
                        }
                    </p>
                </div>
                @if (!IsReadOnly)
                {
                    <label class="media-upload-control gallery-upload">
                        <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" />
                        <span>Add extra photos</span>
                        <InputFile OnChange="@(eventArgs => FilesSelectedAsync(eventArgs, null, toGallery: true))" multiple
                                   aria-label="Add extra photos"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    </label>
                }
            </div>
            @if (gallery.Count == 0)
            {
                <p class="photo-gallery-empty">No extra photos yet.</p>
            }
            else
            {
                @if (!IsReadOnly)
                {
                    <div class="gallery-bulk-toolbar" role="toolbar" aria-label="Extra photo bulk actions">
                        <label class="gallery-select-all">
                            <input type="checkbox"
                                   checked="@AllGallerySelected"
                                   disabled="@bulkActionRunning"
                                   @onchange="ToggleAllGalleryItems" />
                            <span>Select all</span>
                        </label>
                        <span class="gallery-selection-count" aria-live="polite">
                            @SelectedGalleryCount selected
                        </span>
                        <MudSpacer />
                        <MudMenu Label="Move selected" StartIcon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" Dense="true"
                                 Variant="Variant.Outlined" Color="Color.Primary"
                                 Disabled="@(SelectedGalleryCount == 0 || bulkActionRunning)"
                                 AriaLabel="Move selected extra photos to a walkthrough stop">
                            @foreach (var target in stops)
                            {
                                <MudMenuItem OnClick="@(() => MoveSelectedToStopAsync(target.Name))">@target.Name</MudMenuItem>
                            }
                        </MudMenu>
                        <MudMenu Label="Fix selected" StartIcon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Small" Dense="true"
                                 Variant="Variant.Outlined" Color="Color.Primary"
                                 Disabled="@(SelectedGalleryCount == 0 || bulkActionRunning)"
                                 AriaLabel="Apply a photo fix to selected extra photos">
                            <MudMenuItem Icon="@Icons.Material.Filled.WbSunny" OnClick="@(() => FixSelectedAsync(PhotoFix.BrightnessAndColor))">
                                Fix brightness and color
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.CropRotate" OnClick="@(() => FixSelectedAsync(PhotoFix.LevelAndCrop))">
                                Straighten and auto-crop
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.CleaningServices"
                                         Disabled="@(!IsClutterRemovalAvailable)"
                                         OnClick="@(() => FixSelectedAsync(PhotoFix.RemoveClutter))">
                                Remove clutter with AI
                            </MudMenuItem>
                            @if (!IsClutterRemovalAvailable)
                            {
                                <MudText Typo="Typo.caption" Class="px-4 pb-2 d-block">
                                    Enable the approved AI photo-edit provider to use this fix.
                                </MudText>
                            }
                        </MudMenu>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Disabled="@(SelectedGalleryCount == 0 || bulkActionRunning)"
                                   OnClick="DeleteSelectedAsync">Delete selected</MudButton>
                    </div>
                }
                <ul class="photo-gallery-strip">
                    @foreach (var item in gallery)
                    {
                        @GalleryThumbnail(item)
                    }
                </ul>
            }
        </section>

    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public Guid PropertyId { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public EventCallback MediaChanged { get; set; }

    private readonly List<UploadState> uploads = [];
    private readonly List<string> pendingStops = [];
    private List<PropertyMediaItem> media = [];
    private IReadOnlyList<PropertyMediaItem> gallery = [];
    private IReadOnlyList<StopView> stops = [];
    private IReadOnlyList<PropertyMediaItem> unsorted = [];
    private Dictionary<Guid, int> sequence = [];
    private IReadOnlyList<WalkthroughStopDirectionItem> directions = [];
    private RoomNarrationOverview roomNarration = RoomNarrationOverview.Empty;
    private IReadOnlyList<WalkthroughMapStopShots> MapStops = [];
    private string? customStopName;
    private string? mapFocusStop;
    private int mapFocusRequest;
    private bool storyboardBuilt;
    private bool loaded;
    private string? message;
    private Severity messageSeverity = Severity.Info;

    private Guid? loadedPropertyId;

    private readonly SemaphoreSlim transitionGate = new(1, 1);
    private readonly CancellationTokenSource transitionPolling = new();
    private AsyncServiceScope? transitionScope;
    private IWalkthroughTransitionService? transitionService;
    private Dictionary<Guid, WalkthroughTransitionItem> transitions = [];
    private Guid? playingFromId;
    private bool queueing;
    private bool transitionPollingStarted;

    private readonly SemaphoreSlim photoFixGate = new(1, 1);
    private AsyncServiceScope? photoFixScope;
    private IPropertyPhotoFixService? photoFixService;
    private Dictionary<Guid, PropertyPhotoFixItem> photoFixes = [];
    private bool photoFixPollingStarted;
    private readonly HashSet<Guid> selectedGalleryIds = [];
    private bool bulkActionRunning;

    private int SelectedGalleryCount => selectedGalleryIds.Count;

    private bool AllGallerySelected => gallery.Count > 0
        && gallery.All(item => selectedGalleryIds.Contains(item.Id));

    private bool AnyPhotoFixRunning => photoFixes.Values.Any(fix => fix.IsInProgress);

    private bool IsClutterRemovalAvailable => photoFixService?.IsClutterRemovalEnabled == true;

    private bool ShowWalkthroughPanel => transitions.Count > 0
        && (transitionService?.IsEnabled == true || ReadyTransitionCount > 0);

    private int ReadyTransitionCount => transitions.Values.Count(item => item.IsReady);

    private int InProgressTransitionCount => transitions.Values.Count(item => item.IsInProgress);

    // Pairs with no clip, a failed clip, or a clip made before the stop's walking direction was set or changed.
    private int MissingTransitionCount => transitions.Values.Count(item =>
        item.Status is null or WalkthroughTransitionStatus.Failed || (!item.IsCurrent && !item.IsInProgress));

    private int WalkthroughPhotoCount => stops.Sum(stop => stop.Items.Count);

    // Template stops (exterior front, entry) always lead the tour, so the ones on the map keep their places.
    private int FixedMapStopCount => MapStops.TakeWhile(stop => WalkthroughStoryboard.IsTemplateStop(stop.Name)).Count();

    private bool HasExteriorFront => stops.Count > 0 && stops[0].Items.Count > 0;

    private RenderFragment<string> TourStopMedia => stopName => __builder =>
    {
        var stop = stops.FirstOrDefault(candidate => SameStop(candidate.Name, stopName));
        if (stop is null)
        {
            return;
        }

        <div class="tour-stop-media" aria-label="@($"Approved media for {stop.Name}")">
            <div class="tour-stop-media-head">
                <strong>Approved tour media</strong>
                <span>@stop.Items.Count @(stop.Items.Count == 1 ? "photo" : "photos")</span>
            </div>
            <div class="stop-strip">
                @for (var index = 0; index < stop.Items.Count; index++)
                {
                    @PhotoCard((stop.Items, index, stop.Name))
                }
                @if (!IsReadOnly)
                {
                    <label class="media-upload-control stop-upload">
                        <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" />
                        <span>Add another angle</span>
                        <InputFile OnChange="@(eventArgs => FilesSelectedAsync(eventArgs, stop.Name))" multiple
                                   aria-label="@($"Add photos to {stop.Name}")"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    </label>
                }
            </div>
        </div>
        @if (ReferenceEquals(stop, stops[0]) && SameStop(stop.Name, WalkthroughStoryboard.ExteriorFront) && stop.Items.Count > 0)
        {
            var front = stop.Items[0];
            <PropertyAerialIntro PropertyId="PropertyId" IsReadOnly="IsReadOnly"
                                 FrontPhotoKey="@($"{front.Id:N}:{front.EditedAtUtc?.UtcTicks}:{front.AppliedFixes}")" />
        }
    };

    private RenderFragment PhotoCard((IReadOnlyList<PropertyMediaItem> Group, int Index, string? Stop) context) => __builder =>
    {
        var item = context.Group[context.Index];
        var group = context.Group;
        var itemIndex = context.Index;
        var suggestion = item.Analysis is null ? null : WalkthroughStoryboard.SuggestStop(item.Analysis.Category);
        var transition = transitions.GetValueOrDefault(item.Id);
        var shotNumber = sequence.GetValueOrDefault(item.Id) + 1;
        var photoFix = photoFixes.GetValueOrDefault(item.Id);
        <article class="storyboard-photo">
            <div class="storyboard-photo-image" style="@($"background-image: url('{PhotoUrl(item)}')")"
                 role="img" aria-label="@item.OriginalFilename">
                <span class="scene-number" title="Position in the walkthrough video">@(sequence.GetValueOrDefault(item.Id) + 1)</span>
                @if (playingFromId != item.Id)
                {
                    @PhotoFixControls((item, photoFix))
                }
                @if (transition?.IsReady == true)
                {
                    @if (playingFromId == item.Id)
                    {
                        <video class="walkthrough-video" src="@($"/walkthrough-transitions/{transition.TransitionId}")"
                               autoplay muted playsinline controls @onended="StopWalkthrough"
                               aria-label="@($"Walk-through from shot {shotNumber} to shot {shotNumber + 1}")"></video>
                        <button type="button" class="walkthrough-close" aria-label="Close walk-through" @onclick="StopWalkthrough">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    }
                    else
                    {
                        <button type="button" class="walkthrough-play" @onclick="@(() => PlayWalkthrough(item.Id))"
                                aria-label="@($"Play the walk-through from shot {shotNumber} to shot {shotNumber + 1}")"
                                title="@($"Walk into shot {shotNumber + 1}")">
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                        </button>
                    }
                }
            </div>
            <div class="storyboard-photo-body">
                <div class="storyboard-photo-title">
                    <span class="storyboard-photo-name" title="@item.OriginalFilename">@(item.Analysis?.RoomType ?? item.OriginalFilename)</span>
                    @if (item.Analysis is not null)
                    {
                        var quality = PhotoQualityRating.Rate(item.Analysis.QualityScore);
                        <span class="@($"quality-badge {quality.ToString().ToLowerInvariant()}")"
                              title="@($"Photo quality {item.Analysis.QualityScore} out of 100")">@PhotoQualityRating.Describe(quality)</span>
                    }
                </div>
                @if (item.Analysis is not null)
                {
                    @if (item.Analysis.PotentialProblems.Count > 0)
                    {
                        <span class="storyboard-photo-meta warning">@string.Join(", ", item.Analysis.PotentialProblems)</span>
                    }
                }
                else if (item.AnalysisStatus == PropertyMediaAnalysisStatus.Failed)
                {
                    <span class="storyboard-photo-meta error">Analysis attempt @item.AnalysisAttemptCount failed: @item.AnalysisLastError</span>
                    @if (!IsReadOnly)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                   OnClick="@(() => RetryAnalysisAsync(item.Id))">Retry analysis</MudButton>
                    }
                }
                else
                {
                    <span class="storyboard-photo-meta">Recognizing room…</span>
                }

                @PhotoFixStatus(photoFix)

                @if (transition is not null && (transition.Status is not null || transitionService?.IsEnabled == true))
                {
                    <span class="@($"walkthrough-status {WalkthroughStatusClass(transition)}")"
                          title="@($"Walk-through into shot {shotNumber + 1}: {WalkthroughStatusDetail(transition)}")">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsWalk" Size="Size.Small" />@WalkthroughStatusText(transition)
                    </span>
                    @if (!IsReadOnly && transitionService?.IsEnabled == true && transition.Status == WalkthroughTransitionStatus.Failed)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" Class="storyboard-suggest"
                                   Disabled="queueing" OnClick="QueueTransitionsAsync">Try again</MudButton>
                    }
                }

                @if (!IsReadOnly && context.Stop is null && suggestion is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="storyboard-suggest"
                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                               OnClick="@(() => AssignStopAsync(item.Id, suggestion))">Place in @suggestion</MudButton>
                }
            </div>
            @if (!IsReadOnly)
            {
                <div class="storyboard-photo-actions">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                                   Disabled="@(itemIndex == 0)" aria-label="Move photo earlier"
                                   OnClick="@(() => MoveWithinGroupAsync(group, itemIndex, -1))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small"
                                   Disabled="@(itemIndex == group.Count - 1)" aria-label="Move photo later"
                                   OnClick="@(() => MoveWithinGroupAsync(group, itemIndex, 1))" />
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Small"
                                   aria-label="@($"Ask AI about {item.OriginalFilename}")"
                                   OnClick="@(() => SelectForAssistant(item))" />
                    <MudMenu Label="@(context.Stop is null ? "Add to stop" : "Move")" StartIcon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" Dense="true"
                             Variant="Variant.Text" Color="Color.Primary"
                             AriaLabel="@(context.Stop is null ? "Place photo in a stop" : "Move photo to another stop")">
                        <MudText Typo="Typo.caption" Class="px-4 pt-2 d-block">@(context.Stop is null ? "Place in stop" : "Move to stop")</MudText>
                        @foreach (var target in stops.Where(candidate => candidate.Name != context.Stop))
                        {
                            <MudMenuItem OnClick="@(() => AssignStopAsync(item.Id, target.Name))">@target.Name</MudMenuItem>
                        }
                        @if (context.Stop is null)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="@(() => AddPhotoToNewStopAsync(item.Id))">Create new stop…</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.PhotoLibrary" OnClick="@(() => MoveToGalleryAsync(item.Id))">Move to extra photos</MudMenuItem>
                    </MudMenu>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   aria-label="Delete photo" OnClick="@(() => DeleteAsync(item.Id))" />
                </div>
            }
        </article>
    };

    private RenderFragment GalleryThumbnail(PropertyMediaItem item) => __builder =>
    {
        var suggestion = item.Analysis is null ? null : WalkthroughStoryboard.SuggestStop(item.Analysis.Category);
        var label = item.Analysis?.RoomType ?? (item.AnalysisStatus == PropertyMediaAnalysisStatus.Failed ? "Not recognized" : "Recognizing room…");
        var photoFix = photoFixes.GetValueOrDefault(item.Id);
        <li class="gallery-thumb @(selectedGalleryIds.Contains(item.Id) ? "is-selected" : null)">
            <div class="gallery-thumb-image">
                <img src="@PhotoUrl(item)" alt="@item.OriginalFilename" loading="lazy" title="@item.OriginalFilename" />
                @if (!IsReadOnly)
                {
                    <label class="gallery-thumb-select" title="Select @item.OriginalFilename">
                        <input type="checkbox"
                               checked="@selectedGalleryIds.Contains(item.Id)"
                               disabled="@bulkActionRunning"
                               aria-label="Select @item.OriginalFilename"
                               @onchange="@(_ => ToggleGalleryItem(item.Id))" />
                    </label>
                }
                @PhotoFixControls((item, photoFix))
            </div>
            <div class="gallery-thumb-body">
                <span class="gallery-thumb-room">@label</span>
                @PhotoFixStatus(photoFix)
                @if (item.SourceVideoTimestampMs is { } at)
                {
