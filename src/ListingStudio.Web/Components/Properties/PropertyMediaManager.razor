    private async Task DeleteSelectedAsync()
    {
        var selected = SelectedGalleryItems();
        if (selected.Count == 0)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Delete {selected.Count} selected {(selected.Count == 1 ? "photo" : "photos")}?",
            "The selected photos are permanently removed from Extra Photos. This cannot be undone.",
            yesText: "Delete selected",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        bulkActionRunning = true;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            var deleted = 0;
            foreach (var item in selected)
            {
                if (await Service.DeleteAsync(userId, PropertyId, item.Id))
                {
                    deleted++;
                    selectedGalleryIds.Remove(item.Id);
                }
            }

            await ReloadAfterChangeAsync();
            ShowBulkResult(deleted, selected.Count, "deleted", "delete");
        }
        finally
        {
            bulkActionRunning = false;
        }
    }

