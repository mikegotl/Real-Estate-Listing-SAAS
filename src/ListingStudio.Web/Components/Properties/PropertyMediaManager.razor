    // A fixed photo keeps its address, so the version makes the browser fetch the new picture.
    private static string PhotoUrl(PropertyMediaItem item) => item.EditedAtUtc is { } edited
        ? $"/property-media/{item.Id}?v={edited.ToUnixTimeMilliseconds()}"
        : $"/property-media/{item.Id}";

    private static string FormatTimestamp(int milliseconds) => TimeSpan.FromMilliseconds(milliseconds).ToString(@"m\:ss");

    /// <summary>Reloads photos changed elsewhere, such as room photos a video added to the gallery.</summary>
    public async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    // Reload only when the property changes. The parent re-renders after MediaChanged, and reloading here
    // would overlap the next upload's call on this component's DbContext.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedPropertyId == PropertyId)
        {
            return;
        }

        loadedPropertyId = PropertyId;
        pendingStops.Clear();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loaded = false;
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        media = [.. await Service.ListAsync(userId, PropertyId)];
        directions = await Service.ListStopDirectionsAsync(userId, PropertyId);
        roomNarration = await RoomNarrations.GetAsync(userId, PropertyId);
        BuildStoryboard();
        await LoadTransitionsAsync(userId);
        await LoadPhotoFixesAsync(userId);
        loaded = true;
    }

    // Walk-through clips use their own scope so status polling never shares the media service's DbContext.
    private async Task LoadTransitionsAsync(string userId)
    {
        transitionScope ??= ScopeFactory.CreateAsyncScope();
        transitionService ??= transitionScope.Value.ServiceProvider.GetRequiredService<IWalkthroughTransitionService>();
        await transitionGate.WaitAsync();
        try
        {
            transitions = (await transitionService.ListAsync(userId, PropertyId))
                .ToDictionary(item => item.FromPropertyMediaId);
        }
        finally
        {
            transitionGate.Release();
        }

        if (playingFromId is { } playing && transitions.GetValueOrDefault(playing)?.IsReady != true)
        {
            playingFromId = null;
        }

        if (InProgressTransitionCount > 0)
        {
            StartTransitionPolling();
        }
    }

    private async Task QueueTransitionsAsync()
    {
        if (transitionService is null)
        {
            return;
        }

        queueing = true;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            int queued;
            await transitionGate.WaitAsync();
            try
            {
                queued = await transitionService.QueueAsync(userId, PropertyId);
            }
            finally
            {
                transitionGate.Release();
            }

            await LoadTransitionsAsync(userId);
            ShowMessage(
                queued == 0
                    ? "Every walk-through clip is already requested."
                    : $"Creating {queued} walk-through {(queued == 1 ? "clip" : "clips")}. Each shot gets a play button when its clip is ready.",
                Severity.Success);
        }
        catch (InvalidOperationException exception)
        {
            ShowMessage(exception.Message, Severity.Error);
        }
        finally
        {
            queueing = false;
        }
    }

    private void StartTransitionPolling()
    {
        if (transitionPollingStarted)
        {
            return;
        }

        transitionPollingStarted = true;
        _ = PollTransitionsAsync();
    }

    private async Task PollTransitionsAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(transitionPolling.Token))
            {
                if (InProgressTransitionCount == 0)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
                    await LoadTransitionsAsync(userId);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (transitionPolling.IsCancellationRequested)
        {
        }
    }

    private void PlayWalkthrough(Guid fromMediaId) => playingFromId = fromMediaId;

    private void StopWalkthrough() => playingFromId = null;

    // Photo fixes use their own scope too, so their polling never shares a DbContext with the other services.
    private async Task LoadPhotoFixesAsync(string userId)
    {
        photoFixScope ??= ScopeFactory.CreateAsyncScope();
        photoFixService ??= photoFixScope.Value.ServiceProvider.GetRequiredService<IPropertyPhotoFixService>();
        await photoFixGate.WaitAsync();
        try
        {
            photoFixes = (await photoFixService.ListAsync(userId, PropertyId))
                .ToDictionary(item => item.PropertyMediaId);
        }
        finally
        {
            photoFixGate.Release();
        }

        if (AnyPhotoFixRunning)
        {
            StartPhotoFixPolling();
        }
    }

    private void StartPhotoFixPolling()
    {
        if (photoFixPollingStarted)
        {
            return;
        }

        photoFixPollingStarted = true;
        _ = PollPhotoFixesAsync();
    }

    // When a running fix finishes, the photos reload so the fixed picture and its new analysis show up.
    private async Task PollPhotoFixesAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(transitionPolling.Token))
            {
                if (!AnyPhotoFixRunning)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
                    var running = photoFixes.Values.Where(fix => fix.IsInProgress).Select(fix => fix.PropertyMediaId).ToHashSet();
                    await LoadPhotoFixesAsync(userId);
                    if (running.Any(mediaId => photoFixes.GetValueOrDefault(mediaId)?.IsInProgress != true))
                    {
                        await ReloadAfterChangeAsync();
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (transitionPolling.IsCancellationRequested)
        {
        }
    }

    private async Task RequestFixAsync(PropertyMediaItem item, PhotoFix fix)
    {
        if (photoFixService is null)
        {
            return;
        }

        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            bool requested;
            await photoFixGate.WaitAsync();
            try
            {
                requested = await photoFixService.RequestAsync(userId, PropertyId, item.Id, fix);
            }
            finally
            {
                photoFixGate.Release();
            }

            if (requested)
            {
                await LoadPhotoFixesAsync(userId);
                var message = fix switch
                {
                    PhotoFix.RemoveClutter => "Removing clutter with AI. This can take a minute; the original stays saved so you can compare and revert.",
                    PhotoFix.LevelAndCrop => "Straightening and safely cropping the photo. This runs locally, and the original stays saved so you can compare and revert.",
                    _ => "Fixing brightness and color. The original stays saved so you can compare and revert.",
                };
                ShowMessage(message, Severity.Success);
            }
        }
        catch (InvalidOperationException exception)
        {
            ShowMessage(exception.Message, Severity.Error);
        }
    }

    private async Task RequestClutterRemovalAsync(PropertyMediaItem item)
    {
        if (photoFixService is null)
        {
            return;
        }

        var dialog = await DialogService.ShowAsync<PhotoClutterMaskDialog>(
            "Mark clutter",
            new DialogParameters<PhotoClutterMaskDialog>
            {
                { component => component.ImageUrl, PhotoUrl(item) },
                { component => component.Filename, item.OriginalFilename },
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: PhotoEditRegion[] regions } || regions.Length == 0)
        {
            return;
        }

        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            bool requested;
            await photoFixGate.WaitAsync();
            try
            {
                requested = await photoFixService.RequestClutterRemovalAsync(
                    userId, PropertyId, item.Id, regions);
            }
            finally
            {
                photoFixGate.Release();
            }

            if (requested)
            {
                await LoadPhotoFixesAsync(userId);
                ShowMessage(
                    "Creating a cleanup preview from only the areas you marked. The current photo stays in use until you approve it.",
                    Severity.Success);
            }
        }
        catch (InvalidOperationException exception)
        {
            ShowMessage(exception.Message, Severity.Error);
        }
    }

    private async Task ReviewCandidateAsync(PropertyMediaItem item, PropertyPhotoFixItem fix)
    {
        if (photoFixService is null)
        {
            return;
        }

        var dialog = await DialogService.ShowAsync<PhotoFixCandidateDialog>(
            "Review AI cleanup",
            new DialogParameters<PhotoFixCandidateDialog>
            {
                { component => component.MediaId, item.Id },
                { component => component.FixId, fix.FixId },
                { component => component.Filename, item.OriginalFilename },
            },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: bool approve })
        {
            return;
        }

        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            bool changed;
            await photoFixGate.WaitAsync();
            try
            {
                changed = approve
                    ? await photoFixService.ApproveCandidateAsync(userId, PropertyId, fix.FixId)
                    : await photoFixService.RejectCandidateAsync(userId, PropertyId, fix.FixId);
            }
            finally
            {
                photoFixGate.Release();
            }

            if (changed)
            {
                await LoadAsync();
                ShowMessage(
                    approve ? "AI cleanup approved and applied." : "AI cleanup discarded. The current photo was not changed.",
                    Severity.Success);
            }
        }
        catch (InvalidOperationException exception)
        {
            ShowMessage(exception.Message, Severity.Error);
        }
    }

    private PropertyMediaItem MediaById(Guid mediaId) =>
        media.Single(item => item.Id == mediaId);

    private async Task CompareAsync(PropertyMediaItem item)
    {
        var dialog = await DialogService.ShowAsync<PhotoFixCompareDialog>(
            "Compare with the original",
            new DialogParameters<PhotoFixCompareDialog>
            {
                { dialog => dialog.MediaId, item.Id },
                { dialog => dialog.FixedUrl, PhotoUrl(item) },
                { dialog => dialog.Filename, item.OriginalFilename },
                { dialog => dialog.Fixes, item.AppliedFixes },
                { dialog => dialog.CanRevert, !IsReadOnly },
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (!IsReadOnly && result is { Canceled: false, Data: true })
        {
            await RevertAsync(item, confirmed: true);
        }
    }

    private async Task RevertAsync(PropertyMediaItem item, bool confirmed = false)
    {
        if (photoFixService is null)
        {
            return;
        }

        if (!confirmed && await DialogService.ShowMessageBoxAsync(
                "Revert to the original photo?",
                "The fixed version is deleted and the photo you uploaded is used again everywhere.",
                yesText: "Revert",
                cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            bool reverted;
            await photoFixGate.WaitAsync();
            try
            {
                reverted = await photoFixService.RevertAsync(userId, PropertyId, item.Id);
            }
            finally
            {
                photoFixGate.Release();
            }

            if (reverted)
            {
                await ReloadAfterChangeAsync();
                ShowMessage("The original photo is back in place.", Severity.Success);
            }
        }
        catch (InvalidOperationException exception)
        {
            ShowMessage(exception.Message, Severity.Error);
        }
    }

