@inherits OwningComponentBase<IPropertyMediaService>
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject IDialogService DialogService
@inject Microsoft.Extensions.Options.IOptions<MediaAnalysisOptions> MediaAnalysisOptions

<MudPaper Class="pa-6 mt-6 storyboard">
    <div class="storyboard-header">
        <div>
            <p class="storyboard-eyebrow">Walkthrough storyboard</p>
            <MudText Typo="Typo.h5" HtmlTag="h2">Listing photos</MudText>
            <MudText Typo="Typo.body2" Class="storyboard-intro">
                Add photos in the order a buyer would walk through the property: start outside at the front, step
                through the entry, then continue room by room. The AI walkthrough video follows this sequence, so each
                scene flows into the next.
            </MudText>
        </div>
        @if (loaded)
        {
            <div class="storyboard-count" aria-label="Photo count">
                <strong>@media.Count</strong>
                <span>of @IPropertyMediaService.MaximumMediaPerProperty photos</span>
            </div>
        }
    </div>
    <MudText Typo="Typo.caption" Class="storyboard-limits">
        JPG, PNG, or WEBP images up to @(IPropertyMediaService.MaximumFileSize / 1024 / 1024) MB each.
    </MudText>

    @if (message is not null)
    {
        <MudAlert Severity="@messageSeverity" Class="my-4">@message</MudAlert>
    }

    @if (loaded && !IsReadOnly && !HasExteriorFront)
    {
        <MudAlert Severity="Severity.Warning" Class="my-4" Icon="@Icons.Material.Filled.House">
            Start with at least one photo of the front of the property. It opens the walkthrough video and becomes the
            listing cover.
        </MudAlert>
    }

    @if (loaded && ShowWalkthroughPanel)
    {
        <section class="walkthrough-panel" aria-labelledby="walkthrough-heading">
            <MudIcon Icon="@Icons.Material.Filled.DirectionsWalk" Class="walkthrough-panel-icon" />
            <div class="walkthrough-panel-body">
                <h3 id="walkthrough-heading">AI walk-through clips</h3>
                <p>
                    A short clip walks the camera from each shot into the next one, using the two photos as its first and
                    last frames. Press play on a shot to watch the walk into the following shot. Finished clips also play
                    between those photos in the campaign video.
                </p>
                @if (transitionService?.IsEnabled == true && transitions.Values.Any(item => item.Status is not null))
                {
                    <p>
                        When you add or replace a photo, reorder shots, or change a direction on the map, only the clips
                        that change are made again, automatically.
                    </p>
                }
                <span class="walkthrough-panel-count">@ReadyTransitionCount of @transitions.Count walk-throughs ready@(InProgressTransitionCount > 0 ? $" · {InProgressTransitionCount} generating" : "")</span>
            </div>
            @if (!IsReadOnly && transitionService?.IsEnabled == true)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(queueing || MissingTransitionCount == 0)"
                           StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="QueueTransitionsAsync">
                    @(MissingTransitionCount == 0 ? "All walk-throughs requested" : $"Create {MissingTransitionCount} walk-through {(MissingTransitionCount == 1 ? "clip" : "clips")}")
                </MudButton>
            }
        </section>
    }

    @foreach (var upload in uploads)
    {
        <MudPaper Outlined="true" Class="pa-3 my-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText>@upload.File.Name <span class="storyboard-upload-stop">→ @(upload.ToGallery ? "Photo gallery" : upload.Stop ?? "Storyboard")</span></MudText>
                @if (upload.Failed)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                               OnClick="@(() => UploadOneAsync(upload))">Retry upload</MudButton>
                }
            </MudStack>
            <MudProgressLinear Value="upload.Progress" Color="@(upload.Failed ? Color.Error : Color.Primary)" />
            @if (upload.Error is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@upload.Error</MudText>
            }
        </MudPaper>
    }

    @if (!loaded)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-4" />
    }
    else
    {
        @if (IsReadOnly && media.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">No listing photos have been uploaded.</MudAlert>
        }

        <ol class="storyboard-track">
            @for (var stopIndex = 0; stopIndex < stops.Count; stopIndex++)
            {
                var stop = stops[stopIndex];
                var previous = stopIndex == 0 ? null : stops[stopIndex - 1];
                var currentStopIndex = stopIndex;
                if (IsReadOnly && stop.Items.Count == 0)
                {
                    continue;
                }

                <li class="storyboard-stop @(stop.Items.Count == 0 ? "is-empty" : "is-filled") @(SameStop(stop.Name, highlightedStop) ? "is-highlighted" : "")"
                    tabindex="-1" @ref="stopElements[stop.Name]">
                    <div class="stop-marker" aria-hidden="true">
                        @if (stop.Items.Count > 0)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        }
                        else
                        {
                            @(stopIndex + 1)
                        }
                    </div>
                    <div class="stop-body">
                        <div class="stop-head">
                            <div>
                                <div class="stop-title">
                                    <span class="stop-step">Stop @(stopIndex + 1)</span>
                                    <h3>@stop.Name</h3>
                                    @if (stop.Name == WalkthroughStoryboard.ExteriorFront)
                                    {
                                        <span class="stop-badge @(stop.Items.Count == 0 ? "required" : "done")">
                                            @(stop.Items.Count == 0 ? "Required" : "Opening shot")
                                        </span>
                                    }
                                    else if (stop.Name == WalkthroughStoryboard.EntryFoyer)
                                    {
                                        <span class="stop-badge">Recommended</span>
                                    }
                                    @if (stop.Items.Count > 0 && MapStops.Count >= 2)
                                    {
                                        var mapStop = stop.Name;
                                        <button type="button" class="stop-map-link" @onclick="@(() => ShowOnMap(mapStop))"
                                                aria-label="@($"Show {stop.Name} on the walkthrough map")">
                                            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" />Show on map
                                        </button>
                                    }
                                </div>
                                <p class="stop-hint">@Hint(stop, previous)</p>
                            </div>
                            @if (!IsReadOnly && !stop.IsTemplate)
                            {
                                <div class="stop-actions">
                                    @if (stop.Items.Count > 0)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                       Disabled="@(!CanMoveStop(currentStopIndex, -1))"
                                                       aria-label="@($"Move {stop.Name} earlier in the walkthrough")"
                                                       OnClick="@(() => MoveStopAsync(currentStopIndex, -1))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                       Disabled="@(!CanMoveStop(currentStopIndex, 1))"
                                                       aria-label="@($"Move {stop.Name} later in the walkthrough")"
                                                       OnClick="@(() => MoveStopAsync(currentStopIndex, 1))" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       aria-label="@($"Remove the empty {stop.Name} stop")"
                                                       OnClick="@(() => RemovePendingStop(stop.Name))" />
                                    }
                                </div>
                            }
                        </div>
                        <div class="stop-strip">
                            @for (var index = 0; index < stop.Items.Count; index++)
                            {
                                @PhotoCard((stop.Items, index, stop.Name))
                            }
                            @if (!IsReadOnly)
                            {
                                <label class="media-upload-control stop-upload">
                                    <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" />
                                    <span>@(stop.Items.Count == 0 ? $"Add {stop.Name.ToLowerInvariant()} photos" : "Add another angle")</span>
                                    <InputFile OnChange="@(eventArgs => FilesSelectedAsync(eventArgs, stop.Name))" multiple
                                               aria-label="@($"Add photos to {stop.Name}")"
                                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                                </label>
                            }
                        </div>
                    </div>
                </li>
            }

            @if (!IsReadOnly)
            {
                <li class="storyboard-stop next-stop">
                    <div class="stop-marker" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /></div>
                    <div class="stop-body">
                        <div class="stop-title">
                            <span class="stop-step">Stop @(stops.Count + 1)</span>
                            <h3>Where does the walkthrough go next?</h3>
                        </div>
                        <p class="stop-hint">
                            Which room do you step into from the @stops[^1].Name.ToLowerInvariant()? Add it as the next stop, then keep
                            going room by room through the property.
                        </p>
                        <div class="next-stop-suggestions">
                            @foreach (var suggestion in WalkthroughStoryboard.SuggestedStops.Where(IsUnusedStop))
                            {
                                <button type="button" class="stop-suggestion" @onclick="@(() => AddStop(suggestion))">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />@suggestion
                                </button>
                            }
                        </div>
                        <div class="next-stop-custom">
                            <MudTextField T="string" @bind-Value="customStopName" Label="Other room or area"
                                          Placeholder="Sunroom, wine cellar, guest suite…" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" MaxLength="PropertyMedia.MaximumWalkthroughStopLength"
                                          OnKeyDown="CustomStopKeyDownAsync" Immediate="true" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       Disabled="@string.IsNullOrWhiteSpace(customStopName)"
                                       OnClick="@(() => AddStop(customStopName))">Add stop</MudButton>
                        </div>
                    </div>
                </li>
            }
        </ol>

        @if (unsorted.Count > 0)
        {
            <section class="storyboard-unsorted" aria-labelledby="unsorted-heading">
                <h3 id="unsorted-heading">Not in the walkthrough yet</h3>
                <p class="stop-hint">
                    These photos were added before the storyboard. They still play in the video after the walkthrough,
                    in this order. Place each one in a stop so it appears where a buyer would see it.
                </p>
                <div class="stop-strip">
                    @for (var index = 0; index < unsorted.Count; index++)
                    {
                        @PhotoCard((unsorted, index, null))
                    }
                </div>
            </section>
        }

        <section class="photo-gallery" aria-labelledby="gallery-heading">
            <div class="photo-gallery-head">
                <div>
                    <h3 id="gallery-heading">Photo gallery <span class="photo-gallery-count">@gallery.Count</span></h3>
                    <p class="stop-hint">
                        Photos kept here are not part of the walkthrough, the map, the clips or the video yet. Place one in
                        a stop when you want buyers to see it there.
                        @if (MediaAnalysisOptions.Value.Enabled)
                        {
                            @(" Use Find room photos on a listing video to fill the gallery with the best shots of each room.")
                        }
                    </p>
                </div>
                @if (!IsReadOnly)
                {
                    <label class="media-upload-control gallery-upload">
                        <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" />
                        <span>Add to gallery</span>
                        <InputFile OnChange="@(eventArgs => FilesSelectedAsync(eventArgs, null, toGallery: true))" multiple
                                   aria-label="Add photos to the photo gallery"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    </label>
                }
            </div>
            @if (gallery.Count == 0)
            {
                <p class="photo-gallery-empty">No photos in the gallery yet.</p>
            }
            else
            {
                <ul class="photo-gallery-strip">
                    @foreach (var item in gallery)
                    {
                        @GalleryThumbnail(item)
                    }
                </ul>
            }
        </section>

        @if (MapStops.Count >= 2)
        {
            <div class="walkthrough-map-anchor" tabindex="-1" @ref="mapElement">
                <PropertyWalkthroughMap Stops="MapStops" Directions="directions" Transitions="transitions" IsReadOnly="IsReadOnly"
                                        DirectionChanged="SetStopDirectionAsync" ShowShots="ShowStopShotsAsync"
                                        SelectedStopChanged="HighlightStop" FocusStop="@mapFocusStop"
                                        FocusRequest="mapFocusRequest" />
            </div>
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public Guid PropertyId { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public EventCallback MediaChanged { get; set; }

    private readonly List<UploadState> uploads = [];
    private readonly List<string> pendingStops = [];
    private List<PropertyMediaItem> media = [];
    private IReadOnlyList<PropertyMediaItem> gallery = [];
    private IReadOnlyList<StopView> stops = [];
    private IReadOnlyList<PropertyMediaItem> unsorted = [];
    private Dictionary<Guid, int> sequence = [];
    private IReadOnlyList<WalkthroughStopDirectionItem> directions = [];
    private IReadOnlyList<WalkthroughMapStopShots> MapStops = [];
    private readonly Dictionary<string, ElementReference> stopElements = new(StringComparer.OrdinalIgnoreCase);
    private string? highlightedStop;
    private string? focusStop;
    private ElementReference mapElement;
    private string? mapFocusStop;
    private int mapFocusRequest;
    private bool scrollToMap;
    private string? customStopName;
    private bool loaded;
    private string? message;
    private Severity messageSeverity = Severity.Info;

    private Guid? loadedPropertyId;

    private readonly SemaphoreSlim transitionGate = new(1, 1);
    private readonly CancellationTokenSource transitionPolling = new();
    private AsyncServiceScope? transitionScope;
    private IWalkthroughTransitionService? transitionService;
    private Dictionary<Guid, WalkthroughTransitionItem> transitions = [];
    private Guid? playingFromId;
    private bool queueing;
    private bool transitionPollingStarted;

    private bool ShowWalkthroughPanel => transitions.Count > 0
        && (transitionService?.IsEnabled == true || ReadyTransitionCount > 0);

    private int ReadyTransitionCount => transitions.Values.Count(item => item.IsReady);

    private int InProgressTransitionCount => transitions.Values.Count(item => item.IsInProgress);

    // Pairs with no clip, a failed clip, or a clip made before the stop's walking direction was set or changed.
    private int MissingTransitionCount => transitions.Values.Count(item =>
        item.Status is null or WalkthroughTransitionStatus.Failed || (!item.IsCurrent && !item.IsInProgress));

    private bool HasExteriorFront => stops.Count > 0 && stops[0].Items.Count > 0;

    private RenderFragment PhotoCard((IReadOnlyList<PropertyMediaItem> Group, int Index, string? Stop) context) => __builder =>
    {
        var item = context.Group[context.Index];
        var group = context.Group;
        var itemIndex = context.Index;
        var suggestion = item.Analysis is null ? null : WalkthroughStoryboard.SuggestStop(item.Analysis.Category);
        var transition = transitions.GetValueOrDefault(item.Id);
        var shotNumber = sequence.GetValueOrDefault(item.Id) + 1;
        <article class="storyboard-photo">
            <div class="storyboard-photo-image" style="@($"background-image: url('/property-media/{item.Id}')")"
                 role="img" aria-label="@item.OriginalFilename">
                <span class="scene-number" title="Position in the walkthrough video">@(sequence.GetValueOrDefault(item.Id) + 1)</span>
                @if (transition?.IsReady == true)
                {
                    @if (playingFromId == item.Id)
                    {
                        <video class="walkthrough-video" src="@($"/walkthrough-transitions/{transition.TransitionId}")"
                               autoplay muted playsinline controls @onended="StopWalkthrough"
                               aria-label="@($"Walk-through from shot {shotNumber} to shot {shotNumber + 1}")"></video>
                        <button type="button" class="walkthrough-close" aria-label="Close walk-through" @onclick="StopWalkthrough">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    }
                    else
                    {
                        <button type="button" class="walkthrough-play" @onclick="@(() => PlayWalkthrough(item.Id))"
                                aria-label="@($"Play the walk-through from shot {shotNumber} to shot {shotNumber + 1}")"
                                title="@($"Walk into shot {shotNumber + 1}")">
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                        </button>
                    }
                }
            </div>
            <div class="storyboard-photo-body">
                <span class="storyboard-photo-name" title="@item.OriginalFilename">@item.OriginalFilename</span>
                @if (item.Analysis is not null)
                {
                    <span class="storyboard-photo-meta">AI sees: @item.Analysis.RoomType · Quality @item.Analysis.QualityScore</span>
                    @if (item.Analysis.PotentialProblems.Count > 0)
                    {
                        <span class="storyboard-photo-meta warning" title="@string.Join(", ", item.Analysis.PotentialProblems)">
                            @item.Analysis.PotentialProblems.Count possible @(item.Analysis.PotentialProblems.Count == 1 ? "issue" : "issues"): @string.Join(", ", item.Analysis.PotentialProblems)
                        </span>
                    }
                }
                else if (item.AnalysisStatus == PropertyMediaAnalysisStatus.Failed)
                {
                    <span class="storyboard-photo-meta error">Analysis attempt @item.AnalysisAttemptCount failed: @item.AnalysisLastError</span>
                    @if (!IsReadOnly)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                   OnClick="@(() => RetryAnalysisAsync(item.Id))">Retry analysis</MudButton>
                    }
                }
                else
                {
                    <span class="storyboard-photo-meta">Analysis: @item.AnalysisStatus</span>
                }

                @if (transition is not null && (transition.Status is not null || transitionService?.IsEnabled == true))
                {
                    <span class="@($"storyboard-photo-meta walkthrough-status {WalkthroughStatusClass(transition)}")">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsWalk" Size="Size.Small" />
                        Walk-through to shot @(shotNumber + 1): @WalkthroughStatusText(transition)
                    </span>
                }

                @if (!IsReadOnly && context.Stop is null && suggestion is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="storyboard-suggest"
                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                               OnClick="@(() => AssignStopAsync(item.Id, suggestion))">Place in @suggestion</MudButton>
                }
            </div>
            @if (!IsReadOnly)
            {
                <div class="storyboard-photo-actions">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                                   Disabled="@(itemIndex == 0)" aria-label="Move photo earlier"
                                   OnClick="@(() => MoveWithinGroupAsync(group, itemIndex, -1))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small"
                                   Disabled="@(itemIndex == group.Count - 1)" aria-label="Move photo later"
                                   OnClick="@(() => MoveWithinGroupAsync(group, itemIndex, 1))" />
                    <MudSpacer />
                    <MudMenu Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" Dense="true"
                             AriaLabel="@(context.Stop is null ? "Place photo in a stop" : "Move photo to another stop")">
                        <MudText Typo="Typo.caption" Class="px-4 pt-2 d-block">@(context.Stop is null ? "Place in stop" : "Move to stop")</MudText>
                        @foreach (var target in stops.Where(candidate => candidate.Name != context.Stop))
                        {
                            <MudMenuItem OnClick="@(() => AssignStopAsync(item.Id, target.Name))">@target.Name</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.PhotoLibrary" OnClick="@(() => MoveToGalleryAsync(item.Id))">Move to photo gallery</MudMenuItem>
                    </MudMenu>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   aria-label="Delete photo" OnClick="@(() => DeleteAsync(item.Id))" />
                </div>
            }
        </article>
    };

    private RenderFragment GalleryThumbnail(PropertyMediaItem item) => __builder =>
    {
        var suggestion = item.Analysis is null ? null : WalkthroughStoryboard.SuggestStop(item.Analysis.Category);
        var label = item.Analysis?.RoomType ?? (item.AnalysisStatus == PropertyMediaAnalysisStatus.Failed ? "Not recognized" : "Recognizing room…");
        <li class="gallery-thumb">
            <img src="@($"/property-media/{item.Id}")" alt="@item.OriginalFilename" loading="lazy" title="@item.OriginalFilename" />
            <div class="gallery-thumb-body">
                <span class="gallery-thumb-room">@label</span>
                @if (item.SourceVideoTimestampMs is { } at)
                {
                    <span class="gallery-thumb-source">
                        <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Small" />From video at @FormatTimestamp(at)
                    </span>
                }
                @if (!IsReadOnly && suggestion is not null)
                {
                    <button type="button" class="gallery-place" @onclick="@(() => AssignStopAsync(item.Id, suggestion))"
                            title="@($"Place in {suggestion}")" aria-label="@($"Place {item.OriginalFilename} in {suggestion}")">
                        <MudIcon Icon="@Icons.Material.Filled.AddLocationAlt" Size="Size.Small" /><span>@suggestion</span>
                    </button>
                }
            </div>
            @if (!IsReadOnly)
            {
                <div class="gallery-thumb-actions">
                    <MudSpacer />
                    <MudMenu Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" Dense="true" AriaLabel="Place photo in a stop">
                        <MudText Typo="Typo.caption" Class="px-4 pt-2 d-block">Place in stop</MudText>
                        @foreach (var target in stops)
                        {
                            <MudMenuItem OnClick="@(() => AssignStopAsync(item.Id, target.Name))">@target.Name</MudMenuItem>
                        }
                    </MudMenu>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   aria-label="Delete photo" OnClick="@(() => DeleteAsync(item.Id))" />
                </div>
            }
        </li>
    };

    private static string FormatTimestamp(int milliseconds) => TimeSpan.FromMilliseconds(milliseconds).ToString(@"m\:ss");

    /// <summary>Reloads photos changed elsewhere, such as room photos a video added to the gallery.</summary>
    public async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    // Reload only when the property changes. The parent re-renders after MediaChanged, and reloading here
    // would overlap the next upload's call on this component's DbContext.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedPropertyId == PropertyId)
        {
            return;
        }

        loadedPropertyId = PropertyId;
        pendingStops.Clear();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loaded = false;
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        media = [.. await Service.ListAsync(userId, PropertyId)];
        directions = await Service.ListStopDirectionsAsync(userId, PropertyId);
        BuildStoryboard();
        await LoadTransitionsAsync(userId);
        loaded = true;
    }

    // Walk-through clips use their own scope so status polling never shares the media service's DbContext.
    private async Task LoadTransitionsAsync(string userId)
    {
        transitionScope ??= ScopeFactory.CreateAsyncScope();
        transitionService ??= transitionScope.Value.ServiceProvider.GetRequiredService<IWalkthroughTransitionService>();
        await transitionGate.WaitAsync();
        try
        {
            transitions = (await transitionService.ListAsync(userId, PropertyId))
                .ToDictionary(item => item.FromPropertyMediaId);
        }
        finally
        {
            transitionGate.Release();
        }

        if (playingFromId is { } playing && transitions.GetValueOrDefault(playing)?.IsReady != true)
        {
            playingFromId = null;
        }

        if (InProgressTransitionCount > 0)
        {
            StartTransitionPolling();
        }
    }

    private async Task QueueTransitionsAsync()
    {
        if (transitionService is null)
        {
            return;
        }

        queueing = true;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            int queued;
            await transitionGate.WaitAsync();
            try
            {
                queued = await transitionService.QueueAsync(userId, PropertyId);
            }
            finally
            {
                transitionGate.Release();
            }

            await LoadTransitionsAsync(userId);
            ShowMessage(
                queued == 0
                    ? "Every walk-through clip is already requested."
                    : $"Creating {queued} walk-through {(queued == 1 ? "clip" : "clips")}. Each shot gets a play button when its clip is ready.",
                Severity.Success);
        }
        catch (InvalidOperationException exception)
        {
            ShowMessage(exception.Message, Severity.Error);
        }
        finally
        {
            queueing = false;
        }
    }

    private void StartTransitionPolling()
    {
        if (transitionPollingStarted)
        {
            return;
        }

        transitionPollingStarted = true;
        _ = PollTransitionsAsync();
    }

    private async Task PollTransitionsAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(transitionPolling.Token))
            {
                if (InProgressTransitionCount == 0)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
                    await LoadTransitionsAsync(userId);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (transitionPolling.IsCancellationRequested)
        {
        }
    }

    private void PlayWalkthrough(Guid fromMediaId) => playingFromId = fromMediaId;

    private void StopWalkthrough() => playingFromId = null;

    private static string WalkthroughStatusText(WalkthroughTransitionItem item) => item.Status switch
    {
        WalkthroughTransitionStatus.Completed when !item.IsCurrent =>
            "ready, but made before its walking direction was set; create it again to follow the map",
        WalkthroughTransitionStatus.Completed => "ready, press play on the photo",
        WalkthroughTransitionStatus.Pending or WalkthroughTransitionStatus.Submitting => "queued",
        WalkthroughTransitionStatus.Generating => "generating…",
        WalkthroughTransitionStatus.Failed => item.Error ?? "failed",
        _ => "not created yet",
    };

    private static string WalkthroughStatusClass(WalkthroughTransitionItem item) => item.Status switch
    {
        WalkthroughTransitionStatus.Completed => "ready",
        WalkthroughTransitionStatus.Failed => "error",
        _ => string.Empty,
    };

    protected override async ValueTask DisposeAsyncCore()
    {
        transitionPolling.Cancel();
        transitionPolling.Dispose();
        if (transitionScope is { } scope)
        {
            await scope.DisposeAsync();
        }

        await base.DisposeAsyncCore();
    }

    private void BuildStoryboard()
    {
        gallery = [.. media.Where(item => item.IsInGallery).OrderBy(item => item.DisplayOrder)];
        var groups = WalkthroughStoryboard.Group(
            media.Where(item => !item.IsInGallery),
            item => item.WalkthroughStop,
            item => item.DisplayOrder);
        var built = WalkthroughStoryboard.TemplateStops
            .Select(template => new StopView(
                template,
                groups.FirstOrDefault(group => SameStop(group.Stop, template))?.Items ?? [],
                IsTemplate: true))
            .ToList();
        built.AddRange(groups
            .Where(group => group.Stop is not null && !WalkthroughStoryboard.IsTemplateStop(group.Stop))
            .Select(group => new StopView(group.Stop!, group.Items, IsTemplate: false)));
        pendingStops.RemoveAll(pending => built.Any(stop => SameStop(stop.Name, pending)));
        built.AddRange(pendingStops.Select(pending => new StopView(pending, [], IsTemplate: false)));
        stops = built;
        unsorted = groups.FirstOrDefault(group => group.Stop is null)?.Items ?? [];
        sequence = stops.SelectMany(stop => stop.Items).Concat(unsorted)
            .Select((item, index) => (item.Id, index))
            .ToDictionary(entry => entry.Id, entry => entry.index);
        MapStops = stops
            .Where(stop => stop.Items.Count > 0)
            .Select(stop => new WalkthroughMapStopShots(stop.Name, stop.Items))
            .ToArray();
    }

    private async Task SetStopDirectionAsync((string Stop, WalkthroughDirection Direction) change)
    {
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            if (await Service.SetStopDirectionAsync(userId, PropertyId, change.Stop, change.Direction))
            {
                directions = await Service.ListStopDirectionsAsync(userId, PropertyId);
                ShowMessage($"{change.Stop} is now {WalkthroughMap.Describe(change.Direction)} on the walkthrough map.", Severity.Success);
            }
        }
        catch (ArgumentOutOfRangeException exception)
        {
            ShowMessage(exception.Message, Severity.Error);
        }
    }

    private void HighlightStop(string? stop) => highlightedStop = stop;

    private void ShowStopShotsAsync(string stop)
    {
        highlightedStop = stop;
        focusStop = stop;
    }

    // The reverse of the map's "Show its shots": selects the stop on the map and scrolls down to it.
    private void ShowOnMap(string stop)
    {
        highlightedStop = stop;
        mapFocusStop = stop;
        mapFocusRequest++;
        scrollToMap = true;
    }

    // Focusing the highlighted stop scrolls the storyboard to its shots and moves keyboard users there too.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusStop is { } stop && stopElements.TryGetValue(stop, out var element))
        {
            focusStop = null;
            await element.FocusAsync(preventScroll: false);
        }

        if (scrollToMap)
        {
            scrollToMap = false;
            await mapElement.FocusAsync(preventScroll: false);
        }
    }

    private async Task ReloadAfterChangeAsync()
    {
        await LoadAsync();
        await MediaChanged.InvokeAsync();
    }

    private async Task FilesSelectedAsync(InputFileChangeEventArgs eventArgs, string? stop, bool toGallery = false)
    {
        message = null;
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = eventArgs.GetMultipleFiles(IPropertyMediaService.MaximumMediaPerProperty);
        }
        catch (InvalidOperationException)
        {
            ShowMessage($"Select no more than {IPropertyMediaService.MaximumMediaPerProperty} images at once.", Severity.Error);
            return;
        }

        if (media.Count + files.Count > IPropertyMediaService.MaximumMediaPerProperty)
        {
            ShowMessage(
                $"These files would exceed the {IPropertyMediaService.MaximumMediaPerProperty}-image property limit.",
                Severity.Error);
            return;
        }

        var selected = files.Select(file => new UploadState(file, stop, toGallery)).ToArray();
        uploads.AddRange(selected);
        foreach (var upload in selected)
        {
            await UploadOneAsync(upload);
        }
    }

    private async Task UploadOneAsync(UploadState upload)
    {
        upload.Failed = false;
        upload.Error = null;
        upload.Progress = 0;
        try
        {
            var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
            var source = upload.File.OpenReadStream(IPropertyMediaService.MaximumFileSize);
            await using var progressStream = new ProgressReadStream(source, upload.File.Size, bytes =>
            {
                upload.Progress = upload.File.Size == 0 ? 0 : (double)bytes / upload.File.Size * 100;
                _ = InvokeAsync(StateHasChanged);
            });
            await Service.UploadAsync(
                userId,
                PropertyId,
                new PropertyMediaUpload(
                    upload.File.Name,
                    upload.File.ContentType,
                    upload.File.Size,
                    progressStream,
                    upload.Stop,
                    upload.ToGallery));
            upload.Progress = 100;
            uploads.Remove(upload);
            await ReloadAfterChangeAsync();
            ShowMessage(
                upload.ToGallery ? "Photo added to the gallery." : upload.Stop is null ? "Photo uploaded." : $"Photo added to {upload.Stop}.",
                Severity.Success);
        }
        catch (Exception exception) when (exception is InvalidDataException or InvalidOperationException or IOException)
        {
            upload.Failed = true;
            upload.Error = exception.Message;
            ShowMessage("One or more photos could not be uploaded. Correct the issue and retry.", Severity.Error);
        }
    }

    private async Task DeleteAsync(Guid mediaId)
    {
        var inWalkthrough = media.Any(item => item.Id == mediaId && !item.IsInGallery);
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete this photo?",
            inWalkthrough
                ? "The photo is removed from the listing, along with any walk-through clips made from it. This cannot be undone."
                : "The photo is removed from the gallery. This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        if (await Service.DeleteAsync(userId, PropertyId, mediaId))
        {
            await ReloadAfterChangeAsync();
            ShowMessage("Photo deleted.", Severity.Success);
        }
    }

    private async Task AssignStopAsync(Guid mediaId, string stop)
    {
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        if (await Service.SetWalkthroughStopAsync(userId, PropertyId, mediaId, stop))
        {
            await ReloadAfterChangeAsync();
            ShowMessage($"Photo moved to {stop}.", Severity.Success);
        }
    }

    private async Task MoveToGalleryAsync(Guid mediaId)
    {
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        if (await Service.MoveToGalleryAsync(userId, PropertyId, mediaId))
        {
            await ReloadAfterChangeAsync();
            ShowMessage("Photo moved to the photo gallery. It is no longer part of the walkthrough.", Severity.Success);
        }
    }

    private async Task MoveWithinGroupAsync(IReadOnlyList<PropertyMediaItem> group, int from, int offset)
    {
        var to = from + offset;
        if (to < 0 || to >= group.Count)
        {
            return;
        }

        var order = CurrentGroups();
        var target = order.Single(candidate => candidate.Count > 0 && candidate[0].Id == group[0].Id);
        (target[from], target[to]) = (target[to], target[from]);
        await SaveOrderAsync(order, "Photo order saved.");
    }

    private bool CanMoveStop(int stopIndex, int offset)
    {
        var to = stopIndex + offset;
        return to >= 0
            && to < stops.Count
            && !stops[to].IsTemplate
            && stops[to].Items.Count > 0;
    }

    private async Task MoveStopAsync(int stopIndex, int offset)
    {
        if (!CanMoveStop(stopIndex, offset))
        {
            return;
        }

        var filled = stops.Where(stop => stop.Items.Count > 0).ToList();
        var from = filled.IndexOf(stops[stopIndex]);
        var to = filled.IndexOf(stops[stopIndex + offset]);
        (filled[from], filled[to]) = (filled[to], filled[from]);
        var order = filled.Select(stop => stop.Items.ToList()).ToList();
        order.Add([.. unsorted]);
        await SaveOrderAsync(order, $"{stops[stopIndex].Name} moved {(offset < 0 ? "earlier" : "later")} in the walkthrough.");
    }

    private List<List<PropertyMediaItem>> CurrentGroups()
    {
        var order = stops.Where(stop => stop.Items.Count > 0).Select(stop => stop.Items.ToList()).ToList();
        if (unsorted.Count > 0)
        {
            order.Add([.. unsorted]);
        }

        return order;
    }

    private async Task SaveOrderAsync(IEnumerable<List<PropertyMediaItem>> groups, string confirmation)
    {
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        await Service.ReorderAsync(userId, PropertyId, groups.SelectMany(group => group).Select(item => item.Id).ToArray());
        await ReloadAfterChangeAsync();
        ShowMessage(confirmation, Severity.Success);
    }

    private async Task RetryAnalysisAsync(Guid mediaId)
    {
        var userId = await UserIdentity.GetRequiredUserIdAsync(AuthenticationStateProvider);
        if (await Service.RetryAnalysisAsync(userId, PropertyId, mediaId))
        {
            await ReloadAfterChangeAsync();
            ShowMessage("Photo analysis queued for retry.", Severity.Success);
        }
    }

    private void AddStop(string? name)
    {
        string? stop;
        try
        {
            stop = WalkthroughStoryboard.Normalize(name);
        }
        catch (ArgumentOutOfRangeException exception)
        {
            ShowMessage(exception.Message, Severity.Error);
            return;
        }

        if (stop is null)
        {
            return;
        }

        customStopName = null;
        if (stops.Any(existing => SameStop(existing.Name, stop)))
        {
            ShowMessage($"{stop} is already in the walkthrough.", Severity.Info);
            return;
        }

        pendingStops.Add(stop);
        BuildStoryboard();
        ShowMessage($"{stop} added as stop {stops.Count}. Add its photos to keep the walkthrough moving.", Severity.Success);
    }

    private async Task CustomStopKeyDownAsync(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter")
        {
            // Let the text field push its latest value before reading it.
            await Task.Yield();
            AddStop(customStopName);
        }
    }

    private void RemovePendingStop(string stop)
    {
        pendingStops.RemoveAll(pending => SameStop(pending, stop));
        BuildStoryboard();
    }

    private bool IsUnusedStop(string stop) => !stops.Any(existing => SameStop(existing.Name, stop));

    private static bool SameStop(string? left, string? right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    private static string Hint(StopView stop, StopView? previous) => stop.Name switch
    {
        WalkthroughStoryboard.ExteriorFront =>
            "Start outside with a straight-on shot of the front of the property, as a buyer sees it on arrival. "
            + "Add a wider angle or the approach if you have one.",
        WalkthroughStoryboard.EntryFoyer =>
            "Step through the front door. Show the entryway or foyer from the doorway, looking into the home.",
        _ => previous is null
            ? "Photograph this space from the doorway you enter by."
            : $"The space you step into from the {previous.Name.ToLowerInvariant()}. Shoot from the doorway you enter by so the video flows from one room to the next.",
    };

    private void ShowMessage(string text, Severity severity)
    {
        message = text;
        messageSeverity = severity;
    }

    private sealed record StopView(string Name, IReadOnlyList<PropertyMediaItem> Items, bool IsTemplate);

    private sealed class UploadState(IBrowserFile file, string? stop, bool toGallery)
    {
        public IBrowserFile File { get; } = file;
        public string? Stop { get; } = stop;
        public bool ToGallery { get; } = toGallery;
        public double Progress { get; set; }
        public bool Failed { get; set; }
        public string? Error { get; set; }
    }
}
