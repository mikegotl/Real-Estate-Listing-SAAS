@using System.Text.Json

@* Every parameter of one Kling 4 request, with the photo that goes in each image slot. Platform administrators only. *@
<div class="kling-request mt-2" data-testid="@TestId">
    @if (!string.IsNullOrWhiteSpace(Url))
    {
        <MudText Typo="Typo.body2"><code>@(Method ?? "POST") @Url</code></MudText>
    }
    @if (parsed is { } body)
    {
        <MudText Typo="Typo.subtitle2" Class="mt-2">Images</MudText>
        <MudSimpleTable Dense="true" Bordered="true" Class="mb-2">
            <thead>
                <tr><th>Parameter</th><th>Photo</th><th>Value sent</th></tr>
            </thead>
            <tbody>
                @if (body.Image is { } image)
                {
                    var (imageUrl, imageLabel) = body.FirstTourPhotoOpens ? TourPhoto(1) : (PortraitUrl, "Profile headshot");
                    <tr>
                        <td><code>image_url</code></td>
                        <td>@Thumbnail(image, imageUrl, imageLabel)</td>
                        <td class="kling-request-value">@Value(image)</td>
                    </tr>
                }
                @for (var index = 0; index < body.Images.Count; index++)
                {
                    var position = index;
                    // Newer requests: image_urls[0] is the headshot and image_urls[n] is tour photo n + 1.
                    // Older requests: image_urls[n] is tour photo n + 1 and the headshot was image_url.
                    var (slotUrl, slotLabel) = body.FirstTourPhotoOpens
                        ? position == 0 ? (PortraitUrl, "Profile headshot") : TourPhoto(position + 1)
                        : TourPhoto(position + 1);
                    <tr>
                        <td><code>image_urls[@position]</code></td>
                        <td>@Thumbnail(body.Images[position], slotUrl, slotLabel)</td>
                        <td class="kling-request-value">@Value(body.Images[position])</td>
                    </tr>
                }
                @if (body.EndImage is { } endImage)
                {
                    <tr>
                        <td><code>end_image_url</code></td>
                        <td>@Thumbnail(endImage, PortraitUrl, "Profile headshot")</td>
                        <td class="kling-request-value">@Value(endImage)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        @if (body.Settings.Count > 0)
        {
            <MudText Typo="Typo.subtitle2">Other parameters</MudText>
            <MudSimpleTable Dense="true" Bordered="true" Class="mb-2">
                <tbody>
                    @foreach (var setting in body.Settings)
                    {
                        <tr><td><code>@setting.Key</code></td><td>@setting.Value</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        @if (body.Prompt is not null)
        {
            <MudText Typo="Typo.subtitle2">prompt</MudText>
            <pre class="kling-request-pre" data-testid="@($"{TestId}-prompt")">@body.Prompt</pre>
        }
    }
    <details class="mt-1">
        <summary class="mud-typography-caption">JSON request (formatted)</summary>
        <pre class="kling-request-pre" data-testid="@($"{TestId}-json")">@formattedJson</pre>
    </details>
    @if (IsPreview)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
            Photos get their Higgsfield URLs when Generate uploads them, so each image URL above links this site's copy
            of the same photo (open it while signed in). At send time those links are replaced by Higgsfield's upload
            URLs; everything else is exactly what would be sent. The API key is sent as a header and is never shown.
        </MudText>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string BodyJson { get; set; } = string.Empty;

    [Parameter]
    public string? Method { get; set; }

    [Parameter]
    public string? Url { get; set; }

    [Parameter]
    public Guid? AgentPortraitId { get; set; }

    /// <summary>The Tour Map photos in request order, so the preview can show each one next to its slot.</summary>
    [Parameter]
    public IReadOnlyList<KlingNativePresenterPreviewFrame>? Frames { get; set; }

    [Parameter]
    public bool IsPreview { get; set; }

    [Parameter]
    public string TestId { get; set; } = "kling-request";

    private ParsedBody? parsed;
    private string formattedJson = string.Empty;

    private static readonly JsonSerializerOptions Indented = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    };

    private string? PortraitUrl => AgentPortraitId is { } id ? $"/agent-portraits/{id}" : null;

    /// <summary>This site's copy of tour photo <paramref name="position"/> (1-based) and its name.</summary>
    private (string? Url, string Label) TourPhoto(int position)
    {
        var frame = Frames?.FirstOrDefault(candidate => candidate.Position == position);
        return (frame is null ? null : $"/property-media/{frame.PropertyMediaId}", frame?.StopName ?? $"Photo {position}");
    }

    protected override void OnParametersSet()
    {
        parsed = Parse(BodyJson);
        formattedJson = Format(BodyJson);
    }

    /// <summary>One parameter per line, however the body was stored; the original text if it is not JSON.</summary>
    private static string Format(string json)
    {
        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, Indented);
        }
        catch (JsonException)
        {
            return json;
        }
    }

    /// <summary>An https URL opens in a new tab; anything else is shown as text.</summary>
    private static RenderFragment Value(string value) => builder =>
    {
        if (Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", value);
            builder.AddAttribute(2, "target", "_blank");
            builder.AddAttribute(3, "rel", "noopener noreferrer");
            builder.AddContent(4, value);
            builder.CloseElement();
            return;
        }

        builder.AddContent(5, value);
    };

    private static RenderFragment Thumbnail(string value, string? localUrl, string label) => builder =>
    {
        // A real upload URL is shown as itself; a preview placeholder is shown with the photo from this site.
        var source = Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps
            ? value
            : localUrl;
        if (source is null)
        {
            builder.AddContent(0, label);
            return;
        }

        builder.OpenElement(1, "img");
        builder.AddAttribute(2, "src", source);
        builder.AddAttribute(3, "alt", label);
        builder.AddAttribute(4, "title", label);
        builder.AddAttribute(5, "loading", "lazy");
        builder.AddAttribute(6, "style", "width:56px;height:56px;object-fit:cover;border-radius:4px;display:block;");
        builder.CloseElement();
    };

    private static ParsedBody? Parse(string json)
    {
        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
            {
                return null;
            }

            string? image = null, endImage = null, prompt = null;
            var images = new List<string>();
            var settings = new List<KeyValuePair<string, string>>();
            foreach (var property in document.RootElement.EnumerateObject())
            {
                switch (property.Name)
                {
                    case "image_url":
                        image = property.Value.ToString();
                        break;
                    case "end_image_url":
                        endImage = property.Value.ToString();
                        break;
                    case "image_urls" when property.Value.ValueKind == JsonValueKind.Array:
                        images.AddRange(property.Value.EnumerateArray().Select(item => item.ToString()));
                        break;
                    case "prompt":
                        prompt = property.Value.ToString();
                        break;
                    default:
                        settings.Add(new(property.Name, property.Value.ToString()));
                        break;
                }
            }

            return new ParsedBody(image, images, endImage, prompt, settings);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private sealed record ParsedBody(
        string? Image,
        IReadOnlyList<string> Images,
        string? EndImage,
        string? Prompt,
        IReadOnlyList<KeyValuePair<string, string>> Settings)
    {
        /// <summary>True when the first tour photo is image_url and the headshot is image_urls[0].</summary>
        public bool FirstTourPhotoOpens =>
            Prompt?.Contains(NativePresenterVideoPolicy.FirstTourPhotoOpensMarker, StringComparison.Ordinal) == true;
    }
}
